@inject S2GPulseWeb.Web.Logic.PlatformSettingsService PlatformSettings

@{
    PlatformSettings.EnsureLoaded();
    var branding = PlatformSettings.Branding;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["S2GPulseWeb.Web.styles.css"]" />
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/material-dark.css" />
    <ImportMap />
    @if (!string.IsNullOrEmpty(branding.FaviconDataUri))
    {
        <link rel="icon" type="image/svg+xml" href="@branding.FaviconDataUri" />
    }
    else
    {
        <link rel="icon" type="image/png" href="favicon.png" />
    }
    <title>@branding.SiteName</title>
    <HeadOutlet />
</head>

<body>
    <CascadingAuthenticationState>
        <Routes />
    </CascadingAuthenticationState>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
    <script src="js/legal-modal.js"></script>
    <script src="js/knowledge-graph-viewer.js"></script>
    <script src="js/kb-graph-drag.js"></script>
    <script src="js/tutorial-interop.js"></script>
</body>

</html>

