@page "/organizations"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Identity
@using S2GPulseWeb.Web.Data
@using S2GPulseWeb.Web.Logic
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject OrganizationService OrganizationService
@inject OrganizationUsageTrackingService OrgUsageService
@inject MembershipPlanService MembershipPlanService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Organizations - @PlatformSettings.SiteName</PageTitle>

<div class="organizations-page">
    <div class="page-header">
        <div class="header-content">
            <h1>🏢 Organizations</h1>
            <p>Create and manage organizations to collaborate with your team on workflows.</p>
        </div>
        @if (canCreateOrganization)
        {
            <button class="btn btn-primary" @onclick="OpenCreateModal">
                ➕ Create Organization
            </button>
        }
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="loading-spinner"></div>
            <p>Loading organizations...</p>
        </div>
    }
    else if (organizations == null || !organizations.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">🏢</div>
            <h2>No Organizations Yet</h2>
            <p>Organizations let you collaborate with team members on shared workflows, secrets, and storage.</p>
            @if (canCreateOrganization)
            {
                <button class="btn btn-primary btn-lg" @onclick="OpenCreateModal">
                    Create Your First Organization
                </button>
            }
            else
            {
                <p class="upgrade-notice">
                    <strong>Upgrade your plan</strong> to unlock organizations feature.
                </p>
            }
        </div>
    }
    else
    {
        <div class="organizations-grid">
            @* Personal context card - always shown first *@
            <div class="org-card personal-card @(activeOrganizationId == null ? "active" : "")">
                <div class="org-header">
                    <div class="org-name">
                        <span class="org-icon">👤</span>
                        Personal
                    </div>
                    <div class="org-role">
                        <span class="role-badge personal">My Space</span>
                    </div>
                </div>
                
                <p class="org-description">Your personal workflows, secrets, and storage.</p>
                
                <div class="org-actions">
                    @if (activeOrganizationId == null)
                    {
                        <button class="btn btn-secondary btn-sm" disabled>
                            ✓ Active
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary btn-sm" @onclick="SwitchToPersonal">
                            Switch To Personal
                        </button>
                    }
                </div>
            </div>

            @foreach (var org in organizations)
            {
                <div class="org-card @(org.Id == activeOrganizationId ? "active" : "") @(org.IsDisabled ? "disabled" : "")">
                    <div class="org-header">
                        <div class="org-name">
                            <span class="org-icon">🏢</span>
                            @org.Name
                        </div>
                        <div class="org-role">
                            <span class="role-badge @GetRoleBadgeClass(org.Role)">@org.Role</span>
                            @if (org.IsDisabled)
                            {
                                <span class="role-badge disabled-badge">Disabled</span>
                            }
                        </div>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(org.Description))
                    {
                        <p class="org-description">@org.Description</p>
                    }
                    
                    <div class="org-usage">
                        @{
                            var usage = orgUsageSummaries.GetValueOrDefault(org.Id);
                        }
                        <div class="usage-row">
                            <span class="usage-label">Members</span>
                            <span class="usage-value">@org.MemberCount@(usage != null && usage.MaxMembers > 0 ? $" / {usage.MaxMembers}" : "")</span>
                        </div>
                        @if (usage != null && usage.MaxMembers > 0)
                        {
                            <div class="usage-bar">
                                <div class="usage-fill member-fill" style="width: @(Math.Min(100, usage.MemberUsagePercent))%"></div>
                            </div>
                        }
                        <div class="usage-row">
                            <span class="usage-label">Workflows</span>
                            <span class="usage-value">@org.WorkflowCount@(usage != null && usage.MaxWorkflows > 0 ? $" / {usage.MaxWorkflows}" : "")</span>
                        </div>
                        @if (usage != null && usage.MaxWorkflows > 0)
                        {
                            <div class="usage-bar">
                                <div class="usage-fill workflow-fill" style="width: @(Math.Min(100, usage.WorkflowUsagePercent))%"></div>
                            </div>
                        }
                        @if (usage != null)
                        {
                            <div class="usage-row">
                                <span class="usage-label">Executions</span>
                                <span class="usage-value">@usage.ExecutionsThisMonth@(usage.MaxExecutionsPerMonth > 0 ? $" / {FormatNumber(usage.MaxExecutionsPerMonth)}" : "")</span>
                            </div>
                            @if (usage.MaxExecutionsPerMonth > 0)
                            {
                                <div class="usage-bar">
                                    <div class="usage-fill execution-fill" style="width: @(Math.Min(100, usage.ExecutionUsagePercent))%"></div>
                                </div>
                            }
                            <div class="usage-row">
                                <span class="usage-label">Storage</span>
                                <span class="usage-value">@FormatBytes(usage.TotalStorageBytes)@(usage.MaxStorageBytes > 0 ? $" / {FormatBytes(usage.MaxStorageBytes)}" : "")</span>
                            </div>
                            @if (usage.MaxStorageBytes > 0)
                            {
                                <div class="usage-bar">
                                    <div class="usage-fill storage-fill" style="width: @(Math.Min(100, usage.StorageUsagePercent))%"></div>
                                </div>
                            }
                        }
                    </div>
                    
                    <div class="org-actions">
                        @if (org.IsDisabled)
                        {
                            <div class="disabled-hint">
                                <span>⚠️ Upgrade plan to enable</span>
                                @if (org.DisabledAt.HasValue)
                                {
                                    var daysLeft = Math.Max(0, 30 - (int)(DateTime.UtcNow - org.DisabledAt.Value).TotalDays);
                                    @if (daysLeft > 0)
                                    {
                                        <span class="grace-countdown @(daysLeft <= 7 ? "critical" : "")">Will be removed in @daysLeft day(s)</span>
                                    }
                                    else
                                    {
                                        <span class="grace-countdown critical">Grace period expired</span>
                                    }
                                }
                            </div>
                        }
                        else if (org.Id == activeOrganizationId)
                        {
                            <button class="btn btn-secondary btn-sm" disabled>
                                ✓ Active
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-sm" @onclick="() => SwitchToOrganization(org.Id)">
                                Switch To
                            </button>
                        }
                        <button class="btn btn-outline btn-sm" @onclick="() => ViewOrganization(org.Id)">
                            Manage
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="status-message @statusClass">
            @statusMessage
        </div>
    }
</div>

@if (showCreateModal)
{
    <div class="modal-overlay" @onclick="CloseCreateModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h2>Create Organization</h2>
            
            <div class="form-group">
                <label>Organization Name *</label>
                <input type="text" class="form-control" @bind="newOrgName" placeholder="My Team" maxlength="100" />
            </div>
            
            <div class="form-group">
                <label>Description (optional)</label>
                <textarea class="form-control" @bind="newOrgDescription" placeholder="What is this organization for?" rows="3" maxlength="500"></textarea>
            </div>
            
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseCreateModal">Cancel</button>
                <button class="btn btn-primary" @onclick="CreateOrganization" disabled="@isCreating">
                    @(isCreating ? "Creating..." : "Create Organization")
                </button>
            </div>
        </div>
    </div>
}

<style>
