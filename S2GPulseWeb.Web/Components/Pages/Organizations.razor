        gap: 0.75rem;
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid #333;
    }
</style>

@code {
    private string? userId;
    private List<OrganizationListItem>? organizations;
    private Dictionary<Guid, OrganizationUsageSummary> orgUsageSummaries = new();
    private Guid? activeOrganizationId;
    private bool isLoading = true;
    private bool canCreateOrganization = false;
    
    // Create modal
    private bool showCreateModal = false;
    private bool isCreating = false;
    private string newOrgName = "";
    private string newOrgDescription = "";
    
    // Status
    private string statusMessage = "";
    private string statusClass = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            userId = UserManager.GetUserId(user);
            if (userId != null)
            {
                await LoadOrganizationsAsync();
            }
        }
    }

    private async Task LoadOrganizationsAsync()
    {
        isLoading = true;
        try
        {
            organizations = await OrganizationService.GetUserOrganizationsAsync(userId!);
            activeOrganizationId = await OrganizationService.GetActiveOrganizationIdAsync(userId!);
            var (allowed, _) = await OrganizationService.CanCreateOrganizationAsync(userId!);
            canCreateOrganization = allowed;
            
            // Load usage summaries for each org
            orgUsageSummaries.Clear();
            if (organizations != null)
            {
                foreach (var org in organizations)
                {
                    try
                    {
                        var summary = await OrgUsageService.GetUsageSummaryAsync(org.Id);
                        orgUsageSummaries[org.Id] = summary;
                    }
                    catch { /* Ignore individual failures */ }
                }
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        newOrgName = "";
        newOrgDescription = "";
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
    }

    private async Task CreateOrganization()
    {
        if (string.IsNullOrWhiteSpace(newOrgName)) return;
        
        isCreating = true;
        try
        {
            var result = await OrganizationService.CreateOrganizationAsync(
                userId!, newOrgName.Trim(), newOrgDescription?.Trim(), null);
            
            if (result.Success)
            {
                ShowStatus("Organization created successfully!", true);
                CloseCreateModal();
                await LoadOrganizationsAsync();
            }
            else
            {
                ShowStatus(result.Error ?? "Failed to create organization", false);
            }
        }
        finally
        {
            isCreating = false;
        }
    }

    private async Task SwitchToOrganization(Guid orgId)
    {
        var success = await OrganizationService.SetActiveOrganizationAsync(userId!, orgId);
        if (success)
        {
            activeOrganizationId = orgId;
            ShowStatus("Switched organization context", true);
            StateHasChanged();
        }
    }

    private async Task SwitchToPersonal()
    {
        var success = await OrganizationService.SetActiveOrganizationAsync(userId!, null);
        if (success)
        {
            activeOrganizationId = null;
            ShowStatus("Switched to personal context", true);
            StateHasChanged();
        }
    }

    private void ViewOrganization(Guid orgId)
    {
        Navigation.NavigateTo($"/organizations/{orgId}");
    }

    private string GetRoleBadgeClass(OrganizationRole role)
    {
        return role switch
        {
            OrganizationRole.Founder => "founder",
            OrganizationRole.Owner => "owner",
            OrganizationRole.Contributor => "contributor",
            _ => ""
        };
    }

    private void ShowStatus(string message, bool success)
    {
        statusMessage = message;
        statusClass = success ? "status-success" : "status-error";
        StateHasChanged();
        
        Task.Delay(3000).ContinueWith(_ => 
        {
            statusMessage = "";
            InvokeAsync(StateHasChanged);
        });
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1_073_741_824) return $"{bytes / 1_073_741_824.0:F1}GB";
        if (bytes >= 1_048_576) return $"{bytes / 1_048_576.0:F1}MB";
        if (bytes >= 1024) return $"{bytes / 1024.0:F1}KB";
        return $"{bytes}B";
    }

    private static string FormatNumber(int number)
    {
        if (number >= 1_000_000) return $"{number / 1_000_000.0:F0}M";
        if (number >= 1_000) return $"{number / 1_000.0:F0}K";
        return number.ToString();
    }
}
