@code {
    private bool isAdmin = false;
    private string? currentUserId;
    private List<UserSubscription>? subscriptions;
    private Dictionary<string, UserUsage> userUsages = new();
    private string searchQuery = "";
    private string activeTab = "users";
    
    // Tab switching methods
    private void SetUsersTab() => activeTab = "users";
    private void SetConnectorsTab() => activeTab = "connectors";
    private void SetLegalTab() => activeTab = "legal";
    private void SetNotesTab() => activeTab = "notes";
    private void SetNodesTab() => activeTab = "nodes";
    private void SetPlansTab() => activeTab = "plans";
    private void SetBrandingTab() => activeTab = "branding";
    private void SetOrganizationsTab() => activeTab = "organizations";
    
    // Limit editor modal state
    private bool showLimitEditor = false;
    private string editingUserId = "";
    private string editingUserEmail = "";
    private int? editingExecutionLimit;
    private int? editingStorageLimitMB; // In MB for easier input
    private bool isSaving = false;
    
    // Clear storage confirmation modal state
    private bool showClearStorageConfirm = false;
    private string clearingUserId = "";
    private string clearingUserEmail = "";
    private bool isClearing = false;
    private bool clearLogs = true;
    private bool clearVectors = true;
    private bool clearTables = true;
    private bool deleteAccount = false;

    private int totalUsers => subscriptions?.Count ?? 0;
    private int freeUsers => subscriptions?.Count(s => s.MembershipPlan?.IsFree == true || s.MembershipPlanId == null) ?? 0;
    private int paidUsers => subscriptions?.Count(s => s.MembershipPlan?.IsFree == false && s.MembershipPlanId != null) ?? 0;
    private List<MembershipPlan> availablePlans = new();

    private IEnumerable<UserSubscription> FilteredSubscriptions =>
        subscriptions?.Where(s => 
            string.IsNullOrEmpty(searchQuery) ||
            (s.User?.Email?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (s.User?.FirstName?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (s.User?.LastName?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false)
        ) ?? Enumerable.Empty<UserSubscription>();
    
    // Pagination
    private int currentPage = 1;
    private int pageSize = 10;
    private int TotalPages => (int)Math.Ceiling((double)FilteredSubscriptions.Count() / pageSize);
    private IEnumerable<UserSubscription> PagedSubscriptions =>
        FilteredSubscriptions.Skip((currentPage - 1) * pageSize).Take(pageSize);
    
    private void NextPage()
    {
        if (currentPage < TotalPages) currentPage++;
    }
    
    private void PreviousPage()
    {
        if (currentPage > 1) currentPage--;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var appUser = await UserManager.GetUserAsync(user);
            if (appUser != null)
            {
                currentUserId = appUser.Id;
                isAdmin = await SubscriptionService.IsAdminAsync(appUser.Id);

                if (isAdmin)
                {
                    await LoadDataAsync();
                }
            }
        }
    }

    private async Task LoadDataAsync()
    {
        subscriptions = await SubscriptionService.GetAllSubscriptionsAsync();
        availablePlans = await MembershipPlanService.GetAllPlansAsync(includeInactive: false);
        
        // Load usage for each user
        foreach (var sub in subscriptions)
        {
            var usage = await UsageTrackingService.GetUsageAsync(sub.UserId);
            userUsages[sub.UserId] = usage;
        }
    }
    
    private int? GetUserPlanId(UserSubscription sub)
    {
        if (sub.MembershipPlanId.HasValue)
            return sub.MembershipPlanId.Value;
        // Default to Free plan if not set
        return availablePlans.FirstOrDefault(p => p.IsFree)?.Id;
    }
    
    private string GetPlanBadgeStyle(MembershipPlan plan)
    {
        string bg;
        if (!string.IsNullOrEmpty(plan.BadgeColorGradientStart) && !string.IsNullOrEmpty(plan.BadgeColorGradientEnd))
            bg = $"background: linear-gradient(135deg, {plan.BadgeColorGradientStart} 0%, {plan.BadgeColorGradientEnd} 100%);";
        else if (!string.IsNullOrEmpty(plan.BadgeColorGradientStart))
            bg = $"background: {plan.BadgeColorGradientStart};";
        else
            bg = "background: rgba(100, 100, 100, 0.3);";
        
        var color = !string.IsNullOrEmpty(plan.BadgeTextColor) ? $"color: {plan.BadgeTextColor};" : "color: #fff;";
        return $"{bg} {color}";
    }

    private async Task SetPlan(string userId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var planId))
        {
            await SubscriptionService.SetPlanAsync(userId, planId);
            await LoadDataAsync();
            StateHasChanged();
        }
    }
    
    [Obsolete("Use SetPlan instead")]
    private async Task SetTier(string userId, SubscriptionTier tier)
    {
        #pragma warning disable CS0618
        await SubscriptionService.SetTierAsync(userId, tier);
        #pragma warning restore CS0618
        await LoadDataAsync();
        StateHasChanged();
    }
    
    private void OpenLimitEditor(string userId, string email)
    {
        editingUserId = userId;
        editingUserEmail = email;
        var usage = userUsages.GetValueOrDefault(userId);
        editingExecutionLimit = usage?.ExecutionLimitOverride;
        // Convert bytes to MB for display
        editingStorageLimitMB = usage?.StorageLimitOverride.HasValue == true 
            ? (int)(usage.StorageLimitOverride.Value / (1024 * 1024))
            : null;
        showLimitEditor = true;
    }
    
    private void CloseLimitEditor()
    {
        showLimitEditor = false;
        editingUserId = "";
        editingUserEmail = "";
        editingExecutionLimit = null;
        editingStorageLimitMB = null;
    }
    
    private async Task SaveLimits()
    {
        if (string.IsNullOrEmpty(editingUserId)) return;
        
        isSaving = true;
        try
        {
            await UsageTrackingService.SetExecutionLimitOverrideAsync(editingUserId, editingExecutionLimit);
            
            // Convert MB to bytes for storage
            long? storageLimitBytes = editingStorageLimitMB.HasValue 
                ? (long)editingStorageLimitMB.Value * 1024 * 1024 
                : null;
            await UsageTrackingService.SetStorageLimitOverrideAsync(editingUserId, storageLimitBytes);
            
            await LoadDataAsync();
            CloseLimitEditor();
        }
        finally
        {
            isSaving = false;
        }
    }
    
    private async Task ClearLimits()
    {
        if (string.IsNullOrEmpty(editingUserId)) return;
        
        isSaving = true;
        try
        {
            await UsageTrackingService.SetExecutionLimitOverrideAsync(editingUserId, null);
            await UsageTrackingService.SetStorageLimitOverrideAsync(editingUserId, null);
            await LoadDataAsync();
            CloseLimitEditor();
        }
        finally
        {
            isSaving = false;
        }
    }
    
    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
    }
    
    private void ConfirmClearStorage(string userId, string email)
    {
        clearingUserId = userId;
        clearingUserEmail = email;
        showClearStorageConfirm = true;
    }
    
    private void CloseClearStorageConfirm()
    {
        showClearStorageConfirm = false;
        clearingUserId = "";
        clearingUserEmail = "";
        // Reset to all checked for next time
        clearLogs = true;
        clearVectors = true;
        clearTables = true;
        deleteAccount = false;
    }
    
    private async Task ExecuteClearStorage()
    {
        if (string.IsNullOrEmpty(clearingUserId)) return;
        
        isClearing = true;
        try
        {
            // Clear only selected storage types
            if (clearLogs)
                await NodeLogService.ClearLogsAsync(clearingUserId);
            if (clearVectors)
                await VectorDbService.ClearAllForUserAsync(clearingUserId);
            if (clearTables)
                await StorageTableService.ClearAllForUserAsync(clearingUserId);
            
            // Delete user account if requested
            if (deleteAccount)
            {
                await DeleteUserAccountAsync(clearingUserId);
            }
            
            await LoadDataAsync();
            CloseClearStorageConfirm();
        }
        finally
        {
            isClearing = false;
        }
    }
    
    private async Task DeleteUserAccountAsync(string userId)
    {
        var user = await UserManager.FindByIdAsync(userId);
        if (user == null) return;
        
        await using var db = await DbContextFactory.CreateDbContextAsync();
        
        // Get workflow IDs for this user
        var workflowIds = await db.Workflows
            .Where(w => w.OwnerId == userId)
            .Select(w => w.Id)
            .ToListAsync();
        // Get node IDs for this user's workflows
        var nodeIds = await db.WorkflowNodes
            .Where(n => workflowIds.Contains(n.WorkflowId))
            .Select(n => n.Id)
            .ToListAsync();
        
        // Delete connections where source or target node belongs to this user
        var connections = await db.WorkflowConnections
            .Where(c => nodeIds.Contains(c.SourceNodeId) || nodeIds.Contains(c.TargetNodeId))
            .ToListAsync();
        db.WorkflowConnections.RemoveRange(connections);
        
        // Delete nodes for these workflows
        var nodes = await db.WorkflowNodes
            .Where(n => workflowIds.Contains(n.WorkflowId))
            .ToListAsync();
        db.WorkflowNodes.RemoveRange(nodes);
        
        // Delete workflows
        var workflows = await db.Workflows
            .Where(w => w.OwnerId == userId)
            .ToListAsync();
        db.Workflows.RemoveRange(workflows);
        
        // Delete subscription
        var subscription = await db.UserSubscriptions.FirstOrDefaultAsync(s => s.UserId == userId);
        if (subscription != null)
        {
            db.UserSubscriptions.Remove(subscription);
        }
        
        // Delete usage tracking
        var usage = await db.UserUsages.FirstOrDefaultAsync(u => u.UserId == userId);
        if (usage != null)
        {
            db.UserUsages.Remove(usage);
        }
        
        // Delete dismissed notes
        var dismissedNotes = await db.UserDismissedNotes.Where(d => d.UserId == userId).ToListAsync();
        db.UserDismissedNotes.RemoveRange(dismissedNotes);
        
        // Delete user secrets
        var secrets = await db.UserSecrets.Where(s => s.UserId == userId).ToListAsync();
        db.UserSecrets.RemoveRange(secrets);
        
        // Delete OAuth connections
        var oauthConnections = await db.OAuthConnections.Where(o => o.UserId == userId).ToListAsync();
        db.OAuthConnections.RemoveRange(oauthConnections);
        
        await db.SaveChangesAsync();
        
        // Finally delete the user (using UserManager to handle Identity cleanup)
        await UserManager.DeleteAsync(user);
    }
}

