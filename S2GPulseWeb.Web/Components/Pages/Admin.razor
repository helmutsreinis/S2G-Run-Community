@page "/admin"
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using S2GPulseWeb.Web.Data
@using S2GPulseWeb.Web.Logic
@inject SubscriptionService SubscriptionService
@inject MembershipPlanService MembershipPlanService
@inject UsageTrackingService UsageTrackingService
@inject OrganizationService OrganizationService
@inject PlatformSettingsService PlatformSettings
@inject NodeLogService NodeLogService
@inject VectorDbService VectorDbService
@inject StorageTableService StorageTableService
@inject UserManager<ApplicationUser> UserManager
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer

<PageTitle>Admin Portal - @PlatformSettings.SiteName</PageTitle>

@if (!isAdmin)
{
    <div class="admin-container">
        <div class="access-denied">
            <h1>🔒 Access Denied</h1>
            <p>You don't have permission to access this page.</p>
            <a href="/" class="btn btn-primary">Go Home</a>
        </div>
    </div>
}
else
{
    <div class="admin-container">
        <div class="admin-header">
            <h1>🔑 Admin Portal</h1>
            <p class="subtitle">Manage users, legal documents, and platform content</p>
        </div>

        <div class="admin-tabs">
            <button class="admin-tab @(activeTab == "users" ? "active" : "")" 
                    @onclick="SetUsersTab">
                👥 Users & Subscriptions
            </button>
            <button class="admin-tab @(activeTab == "connectors" ? "active" : "")" 
                    @onclick="SetConnectorsTab">
                🔌 Connectors
            </button>
            <button class="admin-tab @(activeTab == "legal" ? "active" : "")" 
                    @onclick="SetLegalTab">
                📜 Legal Documents
            </button>
            <button class="admin-tab @(activeTab == "notes" ? "active" : "")" 
                    @onclick="SetNotesTab">
                📝 Developer Notes
            </button>
            <button class="admin-tab @(activeTab == "nodes" ? "active" : "")" 
                    @onclick="SetNodesTab">
                🧩 Node Designer
            </button>
            <button class="admin-tab @(activeTab == "plans" ? "active" : "")" 
                    @onclick="SetPlansTab">
                💳 Membership Plans
            </button>
            <button class="admin-tab @(activeTab == "branding" ? "active" : "")" 
                    @onclick="SetBrandingTab">
                🎨 Branding
            </button>
            <button class="admin-tab @(activeTab == "organizations" ? "active" : "")" 
                    @onclick="SetOrganizationsTab">
                🏢 Organizations
            </button>
        </div>

        @if (activeTab == "users")
        {
        <div class="admin-stats">
            <div class="stat-card">
                <span class="stat-value">@totalUsers</span>
                <span class="stat-label">Total Users</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@freeUsers</span>
                <span class="stat-label">Free Users</span>
            </div>
            <div class="stat-card">
                <span class="stat-value">@paidUsers</span>
                <span class="stat-label">Paid Users</span>
            </div>
        </div>

        <div class="admin-section">
            <h2>📊 User Subscriptions</h2>
            
            <div class="search-bar">
                <input type="text" @bind="searchQuery" @bind:event="oninput" 
                       placeholder="Search by email..." class="search-input" />
            </div>

            @if (subscriptions == null)
            {
                <p class="loading">Loading...</p>
            }
            else
            {
                <div class="users-table-container">
                    <table class="users-table">
                        <thead>
                            <tr>
                                <th style="min-width: 200px;">Email</th>
                                <th style="min-width: 120px;">Name</th>
                                <th>Tier</th>
                                <th>Status</th>
                                <th>Executions</th>
                                <th>Storage</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sub in PagedSubscriptions)
                            {
                                var usage = userUsages.GetValueOrDefault(sub.UserId);
                                var execLimitDisplay = usage?.ExecutionLimitOverride?.ToString("N0") ?? "Default";
                                var storageLimitDisplay = usage?.StorageLimitOverride.HasValue == true 
                                    ? FormatBytes(usage.StorageLimitOverride.Value) 
                                    : "Default";
                                <tr>
                                    <td>@sub.User?.Email</td>
                                    <td>@($"{sub.User?.FirstName} {sub.User?.LastName}".Trim())</td>
                                    <td>
                                        @if (sub.MembershipPlan != null)
                                        {
                                            <span class="plan-badge" style="@GetPlanBadgeStyle(sub.MembershipPlan)">
                                                @sub.MembershipPlan.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="plan-badge plan-free">Free</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="status-badge status-@sub.Status">
                                            @sub.Status
                                        </span>
                                    </td>
                                    <td>
                                        <span class="usage-display">@((usage?.ExecutionsThisMonth ?? 0).ToString("N0"))</span>
                                        <span class="limit-display @(usage?.ExecutionLimitOverride.HasValue == true ? "custom" : "")">
                                            /@execLimitDisplay
                                        </span>
                                    </td>
                                    <td>
                                        <span class="usage-display">@FormatBytes(usage?.TotalStorageBytes ?? 0)</span>
                                        <span class="limit-display @(usage?.StorageLimitOverride.HasValue == true ? "custom" : "")">
                                            /@storageLimitDisplay
                                        </span>
                                    </td>
                                    <td>@sub.CreatedAt.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="action-buttons">
                                            <select class="plan-select" @onchange="(e) => SetPlan(sub.UserId, e)">
                                                @foreach (var plan in availablePlans)
                                                {
                                                    var isSelected = GetUserPlanId(sub) == plan.Id;
                                                    <option value="@plan.Id" selected="@isSelected">@plan.Name</option>
                                                }
                                            </select>
                                            <button class="btn btn-sm btn-edit" 
                                                    @onclick="() => OpenLimitEditor(sub.UserId, sub.User?.Email ?? string.Empty)">
                                                ✏️
                                            </button>
                                            <button class="btn btn-sm btn-danger" 
                                                    @onclick="() => ConfirmClearStorage(sub.UserId, sub.User?.Email ?? string.Empty)"
                                                    title="Clear all storage data">
                                                🗑️
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                @* Pagination Controls *@
                <div class="pagination-controls">
                    <span class="pagination-info">
                        Showing @((currentPage - 1) * pageSize + 1)-@Math.Min(currentPage * pageSize, FilteredSubscriptions.Count()) of @FilteredSubscriptions.Count() users
                    </span>
                    <div class="pagination-buttons">
                        <button class="btn btn-sm btn-secondary" @onclick="PreviousPage" disabled="@(currentPage <= 1)">
                            ← Previous
                        </button>
                        <span class="page-indicator">Page @currentPage of @TotalPages</span>
                        <button class="btn btn-sm btn-secondary" @onclick="NextPage" disabled="@(currentPage >= TotalPages)">
                            Next →
                        </button>
                    </div>
                </div>
            }
        </div>
        } @* End users tab *@

        @if (activeTab == "legal")
        {
        <div class="admin-section">
        <S2GPulseWeb.Web.Components.Pages.AdminComponents.AdminLegalDocuments />
        </div>
        }

        @if (activeTab == "connectors")
        {
        <div class="admin-section">
        <S2GPulseWeb.Web.Components.Pages.AdminComponents.AdminConnectors />
        </div>
        }

        @if (activeTab == "notes")
        {
        <div class="admin-section">
        <S2GPulseWeb.Web.Components.Pages.AdminComponents.AdminDeveloperNotes />
        </div>
        }

        @if (activeTab == "nodes")
        {
        <div class="admin-section">
        <S2GPulseWeb.Web.Components.Pages.AdminComponents.AdminNodeDesigner />
        </div>
        }

        @if (activeTab == "plans")
        {
        <div class="admin-section">
        <S2GPulseWeb.Web.Components.Pages.AdminComponents.AdminMembershipPlans />
        </div>
        }

        @if (activeTab == "branding")
        {
        <div class="admin-section">
        <S2GPulseWeb.Web.Components.Pages.AdminComponents.AdminBranding />
        </div>
        }

        @if (activeTab == "organizations")
        {
        <div class="admin-section">
        <S2GPulseWeb.Web.Components.Pages.AdminComponents.AdminOrganizations />
        </div>
        }
    </div>
}

@* Limit Editor Modal *@
@if (showLimitEditor)
{
    <div class="modal-overlay" @onclick="CloseLimitEditor">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h3>Edit User Limits</h3>
            <p class="modal-subtitle">@editingUserEmail</p>
            
            <div class="form-group">
                <label>Execution Limit (leave empty for tier default)</label>
                <input type="number" class="form-control" @bind="editingExecutionLimit" 
                       placeholder="e.g. 5000000" min="0" />
            </div>
            
            <div class="form-group">
                <label>Storage Limit in MB (leave empty for tier default)</label>
                <input type="number" class="form-control" @bind="editingStorageLimitMB" 
                       placeholder="e.g. 500" min="0" step="1" />
            </div>
            
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CloseLimitEditor">Cancel</button>
                <button class="btn btn-danger" @onclick="ClearLimits" disabled="@isSaving">Reset All to Default</button>
                <button class="btn btn-primary" @onclick="SaveLimits" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}

@* Clear Storage Confirmation Modal *@
@if (showClearStorageConfirm)
{
    <div class="modal-overlay" @onclick="CloseClearStorageConfirm">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h3>⚠️ Clear Storage</h3>
            <p class="modal-subtitle">@clearingUserEmail</p>
            
            <p class="warning-text">Select what to delete:</p>
            
            <div class="storage-options">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="clearLogs" />
                    <span>📋 Logs</span>
                </label>
                <label class="checkbox-label">
                    <input type="checkbox" @bind="clearVectors" />
                    <span>🧠 Vector DB</span>
                </label>
                <label class="checkbox-label">
                    <input type="checkbox" @bind="clearTables" />
                    <span>📊 Storage Tables</span>
                </label>
                <label class="checkbox-label danger-option">
                    <input type="checkbox" @bind="deleteAccount" />
                    <span>🗑️ Delete User Account</span>
                </label>
            </div>
            
            @if (deleteAccount)
            {
                <p class="warning-text danger">⚠️ <strong>WARNING:</strong> This will permanently delete the user account, subscription, workflows, and all associated data!</p>
            }
            else
            {
                <p class="warning-text"><strong>This action cannot be undone!</strong></p>
            }
            
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CloseClearStorageConfirm">Cancel</button>
                <button class="btn btn-danger" @onclick="ExecuteClearStorage" 
                        disabled="@(isClearing || (!clearLogs && !clearVectors && !clearTables && !deleteAccount))">
                    @(isClearing ? (deleteAccount ? "Deleting..." : "Clearing...") : (deleteAccount ? "Delete Account" : "Delete Selected"))
                </button>
            </div>
        </div>
    </div>
}

