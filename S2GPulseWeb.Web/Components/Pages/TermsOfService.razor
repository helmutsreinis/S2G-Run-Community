@page "/termsofservice"
@using S2GPulseWeb.Web.Data
@using S2GPulseWeb.Web.Logic
@inject LegalDocumentService LegalDocumentService

@rendermode InteractiveServer

<PageTitle>Terms of Service - @PlatformSettings.SiteName</PageTitle>

<div class="legal-page">
    <div class="legal-content-container">
        <a href="/" class="back-link">← Back to Home</a>
        @((MarkupString)termsContent)
    </div>
</div>

@code {
    private string termsContent = "";

    protected override async Task OnInitializedAsync()
    {
        var doc = await LegalDocumentService.GetActiveDocumentAsync(LegalDocumentType.TermsOfService);
        termsContent = doc?.Content ?? LegalContent.TermsOfService;
    }
}

<style>
    .legal-page {
        min-height: 100vh;
        padding: 2rem;
    }

    .legal-content-container {
        max-width: 800px;
        margin: 0 auto;
        background: linear-gradient(135deg, 
            rgba(255, 255, 255, 0.03) 0%,
            rgba(15, 36, 36, 0.9) 50%,
            rgba(0, 0, 0, 0.1) 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(0, 168, 168, 0.3);
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
    }

    .back-link {
        display: inline-block;
        color: var(--accent-color, #00a8a8);
        text-decoration: none;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .back-link:hover {
        color: #00d4d4;
        transform: translateX(-4px);
    }

    .legal-content-container h2 {
        color: var(--accent-color, #14b8a6);
        font-size: 1.5rem;
        margin-top: 0;
    }

    .legal-content-container h3 {
        color: var(--accent-color, #14b8a6);
        font-size: 1rem;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .legal-content-container p {
        color: var(--text-secondary, #8aa);
        line-height: 1.6;
        margin: 0.5rem 0;
    }

    .legal-content-container ul {
        color: var(--text-secondary, #8aa);
        margin: 0.5rem 0;
        padding-left: 1.5rem;
    }

    .legal-content-container li {
        margin: 0.25rem 0;
    }
</style>

