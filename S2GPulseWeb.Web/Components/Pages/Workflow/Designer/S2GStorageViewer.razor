        return ext switch
        {
            ".json" => "📋",
            ".xml" => "📋",
            ".txt" => "📝",
            ".md" => "📝",
            ".log" => "📝",
            ".csv" => "📊",
            ".xlsx" or ".xls" => "📊",
            ".pdf" => "📕",
            ".doc" or ".docx" => "📘",
            ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".svg" => "🖼",
            ".mp4" or ".avi" or ".mov" or ".webm" => "🎬",
            ".mp3" or ".wav" or ".ogg" => "🎵",
            ".zip" or ".rar" or ".7z" or ".tar" or ".gz" => "📦",
