@page "/workflow"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Microsoft.AspNetCore.Identity
@using S2GPulseWeb.Web.Data
@using S2GPulseWeb.Web.Logic
@using S2GPulseWeb.Web.Logic.Nodes
@using S2GPulseWeb.Web.Components.Pages.Workflow.Designer
@using System.Text.Json
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject NodeExecutionManager ExecutionManager
@inject WorkflowService WorkflowService
@inject NodeLogService LogService
@inject UserPreferenceService PreferenceService
@inject WorkflowExecutionService WorkflowExecutionService
@inject CacheStorageService CacheStorageService
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Workflow Designer - @PlatformSettings.SiteName</PageTitle>

@* Newsletter popup for targeted announcements *@
<S2GPulseWeb.Web.Components.Layout.NewsletterPopup UserId="@currentUserId" CurrentPage="Workflow" />

@* Loading overlay for workflow node pre-loading *@
@if (isLoadingWorkflowNodes)
{
    <div class="workflow-loading-overlay">
        <div class="workflow-loading-content">
            <div class="loading-spinner"></div>
            <div class="loading-text">@workflowLoadingStatus</div>
        </div>
    </div>
}

@* Saving overlay for workflow save operations *@
@if (isSavingWorkflow)
{
    <div class="workflow-loading-overlay">
        <div class="workflow-loading-content">
            <div class="loading-spinner"></div>
            <div class="loading-text">@workflowSavingStatus</div>
        </div>
    </div>
}
<div class="workflow-page">
    <div class="workflow-header d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-3">
            <h1 class="m-0">Workflow Designer</h1>
            <select class="workflow-selector" @onchange="OnWorkflowSelected">
                <option value="">-- Select Workflow --</option>
                @foreach (var wf in userWorkflows)
                {
                    var running = WorkflowExecutionService.IsRunning(wf.Id);
                    <option value="@wf.Id" selected="@(currentWorkflowId == wf.Id)">
                        @(running ? "⚡ " : "")@wf.Name
                    </option>
                }
            </select>
            <input type="text" @bind="currentWorkflowName" @bind:after="MarkAsChanged" class="workflow-name-input" placeholder="Workflow Name..." />
        </div>
        
        <!-- Zoom Controls in Header -->
        <div class="zoom-slider-group">
            <button class="zoom-slider-btn" @onclick="ZoomOut" title="Zoom Out (10%)">−</button>
            <input type="range" 
                   class="zoom-slider" 
                   min="25" 
                   max="200" 
                   step="10" 
                   value="@((int)(zoomLevel * 100))" 
                   @onchange="OnZoomSliderChange" />
            <span class="zoom-slider-value">@((int)(zoomLevel * 100))%</span>
            <button class="zoom-slider-btn" @onclick="ZoomIn" title="Zoom In (10%)">+</button>
            <button class="zoom-slider-btn reset" @onclick="ResetZoom" title="Reset View">⟳</button>
        </div>

        
        <div class="workflow-actions d-flex gap-1 align-items-center">
            @if (isWorkflowRunning)
            {
                <button class="btn btn-sm btn-danger" @onclick="StopWorkflow">⏹️ Stop</button>
            }
            else
            {
                <button class="btn btn-sm btn-success" @onclick="StartWorkflow" disabled="@(!canvasNodes.Any(n => n.IsTrigger))">▶️ Start</button>
            }
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearCanvas">✨ New</button>
            <button class="btn btn-sm btn-primary" @onclick="SaveWorkflow">💾 Save</button>
            @if (currentWorkflowId.HasValue)
            {
                @if (canDeleteWorkflow)
                {
                    <button class="btn btn-sm btn-outline-danger" @onclick="ShowDeleteConfirmation" title="Delete this workflow">🗑️</button>
                }
                <label class="auto-start-label" title="Auto-Start resumes this workflow automatically after service interruptions or deployments">
                    <input type="checkbox" @bind="currentWorkflowIsActive" @bind:after="MarkAsChanged" />
                    <span>🚀</span>
                </label>
            }
            @if (currentTierLimits == null || currentTierLimits.CanImportExport)
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="ExportWorkflow" title="Export workflow to JSON">📤</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="TriggerImportDialog" title="Import workflow from JSON">📥</button>
                <input type="file" @ref="importFileInput" style="display: none;" accept=".json" @onchange="ImportWorkflow" />
            }
        </div>
    </div>

    @* Notification Banner *@
    @if (!string.IsNullOrEmpty(workflowNotificationMessage))
    {
        <div class="alert alert-@workflowNotificationType alert-dismissible py-2 mb-2 mx-3" role="alert">
            @workflowNotificationMessage
            <button type="button" class="btn-close" @onclick="@(() => workflowNotificationMessage = null)"></button>
        </div>
    }

    @* Unsaved changes indicator *@
    @if (hasUnsavedChanges)
    {
        <div class="unsaved-indicator mx-3 mb-2 small text-warning">
            ⚠️ You have unsaved changes
        </div>
    }

    <div class="workflow-container">

        <!-- AI Builder Panel (Left Side) - Draggable -->
        <div class="ai-builder-panel @(isAiPanelCollapsed ? "collapsed" : "")" 
             style="@(!isAiPanelCollapsed ? $"left: {aiPanelX}px; top: {aiPanelY}px;" : "")"
             @onmousemove="HandleAiPanelDragMove"
             @onmouseup="HandleAiPanelDragEnd"
             @onmouseleave="HandleAiPanelDragEnd">
            <div class="ai-builder-header @(isDraggingAiPanel ? "dragging" : "")" 
                 @onmousedown="HandleAiPanelDragStart"
                 @onmousedown:stopPropagation>
                @if (isAiPanelCollapsed)
                {
                    <span class="panel-icon" @onclick="ToggleAiPanel">🤖</span>
                    <span class="panel-title-vertical" @onclick="ToggleAiPanel">AI Builder</span>
                }
                else
                {
                    <span class="drag-handle" title="Drag to move">⋮⋮</span>
                    <span class="panel-title">AI Builder</span>
                    <button class="panel-toggle-btn" @onclick="ToggleAiPanel">×</button>
                }
            </div>

            @if (!isAiPanelCollapsed)
            {
                <div class="ai-builder-content">
                    <!-- Provider & Model Selector -->
                    <div class="ai-provider-selector">
                        <select value="@selectedAiProvider" @onchange="OnProviderChanged" class="ai-provider-dropdown">
                            @foreach (var provider in aiProviders)
                            {
                                <option value="@provider.Name">
                                    @provider.Name @(provider.HasKey ? "" : "⚠️")
                                </option>
                            }
                        </select>
                        <select @bind="selectedAiModel" class="ai-model-dropdown">
                            @foreach (var model in availableModels)
                            {
                                <option value="@model">@model</option>
                            }
                        </select>
                        <select @bind="aiChatMode" class="ai-mode-dropdown">
                            <option value="Ask">💬 Ask</option>
                            <option value="Build">🔧 Build</option>
                            <option value="Edit">✏️ Edit</option>
                        </select>
                        <select @bind="aiTemperatureMode" class="ai-temp-dropdown" title="AI Temperature">
                            <option value="Focused">🎯 Focused</option>
                            <option value="Creative">🎨 Creative</option>
                        </select>
                    </div>
                    
                    <!-- Build Mode Warning -->
                    @if (aiChatMode == "Build" && canvasNodes.Any())
                    {
                        <div class="ai-warning-banner">⚠️ Build mode may overwrite existing nodes</div>
                    }
                    
                    <!-- Selected Context Nodes -->
                    @if (aiContextNodes.Any())
                    {
                        <div class="ai-context-nodes">
                            <div class="context-header">
                                <span class="context-title">📎 Selected Nodes</span>
                                <button class="context-clear-btn" @onclick="ClearAiContext" title="Clear all">✕</button>
                            </div>
                            <div class="context-node-list">
                                @foreach (var node in aiContextNodes)
                                {
                                    <div class="context-node-item">
                                        <span class="context-node-icon">@((MarkupString)GetNodeIconSvg(node))</span>
                                        <span class="context-node-name">@node.Name</span>
                                        <button class="context-remove-btn" @onclick="@(() => RemoveFromAiContext(node))" title="Remove">✕</button>
                                    </div>
                                }
                            </div>
                            <div class="context-hint">💡 Click nodes on canvas to add more</div>
                        </div>
                    }
                    
                    <div class="ai-messages" @ref="aiMessagesRef">
                        @foreach (var msg in AssistantService.CurrentConversation.Messages)
                        {
                            <div class="message @msg.Role">
                                <div class="message-content">@((MarkupString)RenderMarkdown(msg.Content))</div>
                            </div>
                        }
                        @if (isAiThinking)
                        {
                            <div class="message assistant thinking">
                                <div class="thinking-dots"><span>.</span><span>.</span><span>.</span></div>
                            </div>
                        }
                    </div>
                    <div class="ai-input-container">
                        <div class="ai-input">
                            <textarea value="@aiInputMessage" 
                                      @oninput="HandleAiInputChanged"
                                      @onkeydown="HandleAiInputKeyDown"
                                      @onkeydown:preventDefault="@showNodeAutocomplete"
                                      @onkeyup="HandleAiKey"
                                      placeholder="@GetAiPlaceholder()" 
                                      rows="4"></textarea>
                            <button class="btn-send @(string.IsNullOrWhiteSpace(aiInputMessage) ? "disabled" : "")" @onclick="SendAiMessage" disabled="@(string.IsNullOrWhiteSpace(aiInputMessage) || isAiThinking)">
                                <i class="bi bi-send"></i>
                            </button>
                        </div>
                        
                        <!-- Node Autocomplete Dropdown -->
                        @if (showNodeAutocomplete && nodeAutocompleteMatches.Any())
                        {
                            <div class="ai-autocomplete-dropdown">
                                @for (var i = 0; i < nodeAutocompleteMatches.Count; i++)
                                {
                                    var idx = i;
                                    var nodeName = nodeAutocompleteMatches[i];
                                    <div class="autocomplete-item @(selectedAutocompleteIndex == idx ? "selected" : "")"
                                         @onclick="@(() => InsertNodeReference(nodeName))">
                                        <span class="node-name">@nodeName</span>
                                        <span class="hint">Tab to insert</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Cost Panel (Left Side) -->
        <div class="cost-panel @(isCostPanelCollapsed ? "collapsed" : "")">
            <div class="cost-panel-header" @onclick="ToggleCostPanel">
                @if (isCostPanelCollapsed)
                {
                    <span class="panel-icon">💰</span>
                    <span class="panel-title-vertical">AI Expenses</span>
                }
                else
                {
                    <span class="panel-title">AI Expenses</span>
                    <button class="panel-toggle-btn">×</button>
                }
            </div>

            @if (!isCostPanelCollapsed)
            {
                <div class="cost-panel-content">
                    <div class="cost-item total">
                        <span class="label">Total Cost</span>
                        <span class="value badge badge-success">$@TotalWorkflowCost.ToString("F4")</span>
                    </div>
                    
                    @foreach (var aiNode in GetAINodeCostBreakdown())
                    {
                        <div class="ai-node-cost-item">
                            <div class="node-name">
                                @if (!string.IsNullOrEmpty(aiNode.IconSvg))
                                {
                                    <span class="node-icon custom-svg-icon">@((MarkupString)aiNode.IconSvg)</span>
                                }
                                else
                                {
                                    <span class="node-icon">@NodeHelper.GetDisplayIcon(aiNode.NodeType, null)</span>
                                }
                                <span class="name">@aiNode.Name</span>
                            </div>
                            <div class="node-stats">
                                <span class="badge badge-info" title="Input Tokens">↓ @FormatTokenCount(aiNode.InputTokens)</span>
                                <span class="badge badge-warning" title="Output Tokens">↑ @FormatTokenCount(aiNode.OutputTokens)</span>
                                <span class="badge badge-primary" title="Cost">$@aiNode.Cost.ToString("F5")</span>
                            </div>
                        </div>
                    }
                    
                    @if (!GetAINodeCostBreakdown().Any())
                    {
                        <div class="cost-note">
                            No AI nodes in this workflow yet.
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Minimap Panel (Right Side) -->
        <div class="minimap-panel @(isMinimapCollapsed ? "collapsed" : "")">
            <div class="minimap-header" @onclick="ToggleMinimap">
                @if (isMinimapCollapsed)
                {
                    <span class="panel-icon">🗺️</span>
                    <span class="panel-title-vertical">Minimap</span>
                }
                else
                {
                    <span class="panel-title">Minimap</span>
                    <button class="panel-toggle-btn">×</button>
                }
            </div>

            @if (!isMinimapCollapsed)
            {
                <div class="minimap-content"
                     @onmousedown="HandleMinimapMouseDown"
                     @onmousemove="HandleMinimapMouseMove"
                     @onmouseup="HandleMinimapMouseUp"
                     @onmouseleave="HandleMinimapMouseUp">
                    <!-- Scaled-down node representations -->
                    @{
                        var scale = GetMinimapScale();
                        var viewport = GetMinimapViewport();
                    }
                    @foreach (var node in canvasNodes)
                    {
                        <div class="minimap-node @node.NodeType.ToLower()"
                             style="left: @(node.X * scale)px; top: @(node.Y * scale)px; width: @(node.Width * scale)px; height: @(node.Height * scale)px;">
                        </div>
                    }
                    <!-- Viewport indicator -->
                    <div class="minimap-viewport"
                         style="left: @(viewport.X)px; top: @(viewport.Y)px; width: @(viewport.Width)px; height: @(viewport.Height)px;">
                    </div>
                </div>
            }
        </div>

        <!-- Catalog Panel (Right Side, Below Minimap) -->
        <div class="custom-node-panel @(isCustomNodePanelCollapsed ? "collapsed" : "")">
            <div class="custom-node-panel-header" @onclick="ToggleCustomNodePanel">
                @if (isCustomNodePanelCollapsed)
                {
                    <span class="panel-icon">📚</span>
                    <span class="panel-title-vertical">Catalog</span>
                }
                else
                {
                    <span class="panel-title">📚 Catalog</span>
                    <button class="panel-toggle-btn">×</button>
                }
            </div>

            @if (!isCustomNodePanelCollapsed)
            {
                <div class="custom-node-panel-content">
                    <div class="custom-node-search">
                        <input type="text" 
                               @bind="customNodeSearchText" 
                               @bind:event="oninput"
                               @bind:after="OnSearchTextChanged"
                               placeholder="🔍 Search nodes..." />
                        @if (isSearchLoading)
                        {
                            <span class="search-loading">⏳</span>
                        }
                    </div>
                    
                    @{
                        var filteredResults = GetFilteredCustomNodes();
                        var hasSearchText = !string.IsNullOrWhiteSpace(customNodeSearchText);
                    }
                    
                    @if (!filteredResults.Any())
                    {
                        <div class="custom-node-empty">
                            @if (hasSearchText)
                            {
                                <span>No matching nodes found</span>
                            }
                            else
                            {
                                <span>No custom nodes available</span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="custom-node-results">
                            @foreach (var category in filteredResults)
                            {
                                var isExpanded = IsCatalogCategoryExpanded(category.Id);
                                <div class="custom-node-category @(isExpanded ? "expanded" : "")">
                                    <div class="custom-node-category-header" @onclick="() => ToggleCatalogCategory(category.Id)">
                                        <span class="category-chevron">@(isExpanded ? "▼" : "▶")</span>
                                        <span class="category-icon">
                                            @if (!string.IsNullOrWhiteSpace(category.IconSvg))
                                            {
                                                <div class="category-svg">@((MarkupString)category.IconSvg)</div>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(category.IconEmoji))
                                            {
                                                @category.IconEmoji
                                            }
                                            else
                                            {
                                                <span>📁</span>
                                            }
                                        </span>
                                        <span class="category-name">@category.Name</span>
                                        @if (loadingCategories.Contains(category.Id))
                                        {
                                            <span class="category-count">⏳</span>
                                        }
                                    </div>
                                    @if (isExpanded)
                                    {
                                        <div class="custom-node-category-items">
                                        @* Custom Jint Nodes (using lightweight catalog) *@
                                        @foreach (var node in GetCatalogItemsForCategory(category.Id))
                                        {
                                            <div class="custom-node-item" 
                                                 draggable="true" 
                                                 @ondragstart="@(() => StartDragFromPalette(node.NodeTypeKey))">
                                                <div class="custom-node-item-icon">
                                                    @if (!string.IsNullOrWhiteSpace(node.IconSvg))
                                                    {
                                                        <div class="custom-node-svg">@((MarkupString)node.IconSvg)</div>
                                                    }
                                                    else if (!string.IsNullOrWhiteSpace(node.IconFallbackEmoji))
                                                    {
                                                        <span>@node.IconFallbackEmoji</span>
                                                    }
                                                    else
                                                    {
                                                        <span>🧩</span>
                                                    }
                                                </div>
                                                <div class="custom-node-item-content">
                                                    <span class="custom-node-item-name">@node.DisplayName</span>
                                                </div>
                                            </div>
                                        }
                                        @* Built-in Nodes assigned to this category *@
                                        @foreach (var builtIn in GetBuiltInNodesForCategory(category.Id))
                                        {
                                            var iconOverride = BuiltInNodeCatalogService.GetIconOverride(builtIn.NodeTypeKey);
                                            <div class="custom-node-item builtin-node-item" 
                                                 draggable="true" 
                                                 title="@builtIn.Description"
                                                 @ondragstart="@(() => StartDragFromPalette(builtIn.NodeTypeKey))">
                                                <div class="custom-node-item-icon">
                                                    @if (!string.IsNullOrWhiteSpace(iconOverride))
                                                    {
                                                        <div class="custom-node-svg">@((MarkupString)iconOverride)</div>
                                                    }
                                                    else
                                                    {
                                                        <span>@builtIn.Icon</span>
                                                    }
                                                </div>
                                                <div class="custom-node-item-content">
                                                    <span class="custom-node-item-name">@builtIn.DisplayName</span>
                                                    @if (!string.IsNullOrWhiteSpace(builtIn.Description))
                                                    {
                                                        <span class="custom-node-item-desc">@builtIn.Description</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Canvas Area -->
        <div class="workflow-canvas-container"
             @onmousedown="HandleCanvasMouseDown"
             @onmousemove="HandleCanvasMouseMove"
             @onmouseup="HandleCanvasMouseUp"
             @onmouseleave="HandleCanvasMouseUp"
             style="cursor: @(resizingNode != null ? "nwse-resize" : isConnecting ? "crosshair" : isPanning ? "grabbing" : "grab");">
            <div class="workflow-canvas" 
                 @ref="canvasRef"
                 @ondrop="HandleDrop"
                 @ondragover="HandleDragOver"
                 @ondragover:preventDefault
                 style="position: relative; width: @(canvasWidth)px; height: @(canvasHeight)px; transform: translate(@(panX)px, @(panY)px) scale(@zoomLevel); transform-origin: 0 0;">

                <!-- SVG for connections -->
                <svg class="connections-svg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;">
                    <!-- n8n-style connection marker definitions -->
                    <defs>
                        <!-- Default markers (teal) -->
                        <!-- Source: dot indicator -->
                        <marker id="arrow-start" markerWidth="12" markerHeight="12" refX="6" refY="6" orient="auto" markerUnits="userSpaceOnUse">
                            <circle cx="6" cy="6" r="4" fill="#1a1f26" stroke="#00a8a8" stroke-width="2" />
                        </marker>
                        <!-- Target: arrow with rectangle badge -->
                        <marker id="arrow-end" markerWidth="24" markerHeight="16" refX="22" refY="8" orient="auto" markerUnits="userSpaceOnUse">
                            <rect x="0" y="3" width="10" height="10" rx="2" fill="#1a1f26" stroke="#00a8a8" stroke-width="1.5" />
                            <path d="M12,4 L12,12 L18,8 z" fill="#00a8a8" />
                            <circle cx="21" cy="8" r="3" fill="#1a1f26" stroke="#00a8a8" stroke-width="1.5" />
                        </marker>
                        
                        <!-- True path markers (green) -->
                        <marker id="arrow-start-true" markerWidth="12" markerHeight="12" refX="6" refY="6" orient="auto" markerUnits="userSpaceOnUse">
                            <circle cx="6" cy="6" r="4" fill="#1a1f26" stroke="#22c55e" stroke-width="2" />
                        </marker>
                        <marker id="arrow-end-true" markerWidth="24" markerHeight="16" refX="22" refY="8" orient="auto" markerUnits="userSpaceOnUse">
                            <rect x="0" y="3" width="10" height="10" rx="2" fill="#1a1f26" stroke="#22c55e" stroke-width="1.5" />
                            <path d="M12,4 L12,12 L18,8 z" fill="#22c55e" />
                            <circle cx="21" cy="8" r="3" fill="#1a1f26" stroke="#22c55e" stroke-width="1.5" />
                        </marker>
                        
                        <!-- False path markers (red) -->
                        <marker id="arrow-start-false" markerWidth="12" markerHeight="12" refX="6" refY="6" orient="auto" markerUnits="userSpaceOnUse">
                            <circle cx="6" cy="6" r="4" fill="#1a1f26" stroke="#ef4444" stroke-width="2" />
                        </marker>
                        <marker id="arrow-end-false" markerWidth="24" markerHeight="16" refX="22" refY="8" orient="auto" markerUnits="userSpaceOnUse">
                            <rect x="0" y="3" width="10" height="10" rx="2" fill="#1a1f26" stroke="#ef4444" stroke-width="1.5" />
                            <path d="M12,4 L12,12 L18,8 z" fill="#ef4444" />
                            <circle cx="21" cy="8" r="3" fill="#1a1f26" stroke="#ef4444" stroke-width="1.5" />
                        </marker>
                        
                        <!-- Orchestrate path markers (yellow - bidirectional control flow) -->
                        <marker id="arrow-start-orchestrate" markerWidth="12" markerHeight="12" refX="6" refY="6" orient="auto" markerUnits="userSpaceOnUse">
                            <circle cx="6" cy="6" r="4" fill="#1a1f26" stroke="#eab308" stroke-width="2" />
                        </marker>
                        <marker id="arrow-end-orchestrate" markerWidth="24" markerHeight="16" refX="22" refY="8" orient="auto" markerUnits="userSpaceOnUse">
                            <rect x="0" y="3" width="10" height="10" rx="2" fill="#1a1f26" stroke="#eab308" stroke-width="1.5" />
                            <path d="M12,4 L12,12 L18,8 z" fill="#eab308" />
                            <circle cx="21" cy="8" r="3" fill="#1a1f26" stroke="#eab308" stroke-width="1.5" />
                        </marker>
                        
                        <!-- Run path markers (blue - RemoteCommand to Remote) -->
                        <marker id="arrow-start-run" markerWidth="12" markerHeight="12" refX="6" refY="6" orient="auto" markerUnits="userSpaceOnUse">
                            <circle cx="6" cy="6" r="4" fill="#1a1f26" stroke="#3b82f6" stroke-width="2" />
                        </marker>
                        <marker id="arrow-end-run" markerWidth="24" markerHeight="16" refX="22" refY="8" orient="auto" markerUnits="userSpaceOnUse">
                            <rect x="0" y="3" width="10" height="10" rx="2" fill="#1a1f26" stroke="#3b82f6" stroke-width="1.5" />
                            <path d="M12,4 L12,12 L18,8 z" fill="#3b82f6" />
                            <circle cx="21" cy="8" r="3" fill="#1a1f26" stroke="#3b82f6" stroke-width="1.5" />
                        </marker>
                    </defs>
                    
                    @{
                        // Pre-calculate which port side each connection uses for proper fan grouping
                        var connectionPortInfo = new Dictionary<NodeConnection, (ConnectionSide SourceSide, ConnectionSide TargetSide)>();
                        foreach (var conn in connections)
                        {
                            var srcNode = canvasNodes.FirstOrDefault(n => n.Id == conn.SourceId);
                            var tgtNode = canvasNodes.FirstOrDefault(n => n.Id == conn.TargetId);
                            if (srcNode != null && tgtNode != null)
                            {
                                var ports = ConnectionHelper.GetClosestPorts(srcNode, tgtNode);
                                connectionPortInfo[conn] = (ports.Source.Side, ports.Target.Side);
                            }
                        }
                        
                        // Build a unified grouping: all connections touching a (nodeId, side) pair
                        // This includes both connections where the node is source AND where it's target
                        var nodePortConnections = new Dictionary<(Guid NodeId, ConnectionSide Side), List<(NodeConnection Conn, bool IsSource)>>();
                        foreach (var conn in connections.Where(c => connectionPortInfo.ContainsKey(c)))
                        {
                            var portInfo = connectionPortInfo[conn];
                            
                            // Add as source
                            var sourceKey = (conn.SourceId, portInfo.SourceSide);
                            if (!nodePortConnections.ContainsKey(sourceKey))
                                nodePortConnections[sourceKey] = new List<(NodeConnection, bool)>();
                            nodePortConnections[sourceKey].Add((conn, true));
                            
                            // Add as target
                            var targetKey = (conn.TargetId, portInfo.TargetSide);
                            if (!nodePortConnections.ContainsKey(targetKey))
                                nodePortConnections[targetKey] = new List<(NodeConnection, bool)>();
                            nodePortConnections[targetKey].Add((conn, false));
                        }
                    }
                    @foreach (var connection in connections)
                    {
                        var sourceNode = canvasNodes.FirstOrDefault(n => n.Id == connection.SourceId);
                        var targetNode = canvasNodes.FirstOrDefault(n => n.Id == connection.TargetId);
                        if (sourceNode != null && targetNode != null && connectionPortInfo.ContainsKey(connection))
                        {
                            var portInfo = connectionPortInfo[connection];
                            
                            // Get all connections on source node's port side (both incoming and outgoing)
                            var sourceKey = (connection.SourceId, portInfo.SourceSide);
                            var sourcePortConns = nodePortConnections.GetValueOrDefault(sourceKey) ?? new List<(NodeConnection, bool)>();
                            var sourceIndex = sourcePortConns.FindIndex(x => x.Conn == connection);
                            
                            // Get all connections on target node's port side (both incoming and outgoing)
                            var targetKey = (connection.TargetId, portInfo.TargetSide);
                            var targetPortConns = nodePortConnections.GetValueOrDefault(targetKey) ?? new List<(NodeConnection, bool)>();
                            var targetIndex = targetPortConns.FindIndex(x => x.Conn == connection);
                            
                            // Use fanned ports when multiple connections share the same port side
                            var ports = ConnectionHelper.GetClosestPortsWithFan(
                                sourceNode, targetNode,
                                sourceIndex, sourcePortConns.Count,
                                targetIndex, targetPortConns.Count);
                            var pathD = ConnectionHelper.GenerateSmartBezierPath(ports.Source, ports.Target);
                            var pathId = $"conn-{connection.Id.ToString().Substring(0, 8)}";
                            var isConnectionActive = activeConnectionIds.Contains(connection.Id);
                            
                            // Calculate label position - centered on the path
                            var midX = (ports.Source.X + ports.Target.X) / 2;
                            var midY = (ports.Source.Y + ports.Target.Y) / 2 - 8;
                            
                            // Determine color based on connection label
                            var labelLower = connection.Label?.ToLower();
                            var strokeColor = labelLower switch
                            {
                                "true" => "#22c55e",        // Green for true branch
                                "false" => "#ef4444",       // Red for false branch
                                "complete" => "#22c55e",    // Green for complete
                                "error" => "#ef4444",       // Red for error
                                "agent" => "#6b8afd",       // Blue for agent connections
                                "orchestrate" => "#eab308", // Yellow for orchestrate (bidirectional control)
                                _ when labelLower?.StartsWith("tool:") == true => "#a855f7",  // Purple for tool connections
                                _ when labelLower?.StartsWith("run:") == true => "#3b82f6",   // Blue for run connections (RemoteCommand)
                                _ => "#00a8a8"              // Teal default
                            };
                            var markerSuffix = labelLower switch
                            {
                                "true" => "-true",
                                "false" => "-false",
                                "complete" => "-true",      // Same marker as true
                                "error" => "-false",        // Same marker as false
                                "orchestrate" => "-orchestrate", // Yellow markers
                                _ when labelLower?.StartsWith("run:") == true => "-run", // Blue markers for RemoteCommand
                                _ => ""
                            };

                            <!-- Invisible hit area for right-click -->
                            <path d="@pathD" stroke="transparent" stroke-width="15" fill="none" 
                                  style="pointer-events: stroke; cursor: pointer;"
                                  @oncontextmenu="@(e => HandleConnectionContextMenu(e, connection))"
                                  @oncontextmenu:preventDefault />
                            
                            <!-- Visible connection line with arrows -->
                            <path id="@pathId" d="@pathD" stroke="@strokeColor" stroke-width="@GetConnectionStrokeWidth(connection.Label)" fill="none" 
                                  stroke-dasharray="@GetConnectionDashArray(connection.Label)"
                                  marker-start="url(#arrow-start@(markerSuffix))" marker-end="url(#arrow-end@(markerSuffix))" />
                            
                            <!-- Animated dot traveling along path when active -->
                            @if (isConnectionActive)
                            {
                                <circle r="5" fill="@strokeColor">
                                    <animateMotion dur="1.5s" repeatCount="indefinite" path="@pathD" />
                                </circle>
                            }
                            
                            <!-- Label with background pill centered on the connection path (matching node-tag style) -->
                            @if (!string.IsNullOrEmpty(connection.Label))
                            {
                                var labelWidth = connection.Label.Length * 6 + 16;
                                var labelHeight = 18;
                                var rectY = midY - labelHeight / 2 + 6;
                                var textY = midY + 10;
                                @:@(new MarkupString($"<rect x=\"{midX - labelWidth/2}\" y=\"{rectY}\" width=\"{labelWidth}\" height=\"{labelHeight}\" rx=\"8\" fill=\"#1a1f26\" stroke=\"{strokeColor}\" stroke-width=\"1\" />"))
                                @:@(new MarkupString($"<text x=\"{midX}\" y=\"{textY}\" text-anchor=\"middle\" fill=\"{strokeColor}\" font-size=\"10\" font-weight=\"500\">{connection.Label}</text>"))
                            }
                        }
                    }
                    
                    @* Temporary connection line while dragging *@
                    @if (isConnecting && connectingFromNode != null)
                    {
                        var startPort = connectingFromSide.HasValue 
                            ? ConnectionHelper.GetPortPosition(connectingFromNode, connectingFromSide.Value)
                            : new PortPoint { X = connectingFromNode.X + connectingFromNode.Width, Y = connectingFromNode.Y + connectingFromNode.Height / 2, Side = ConnectionSide.Right };
                        var tempPath = ConnectionHelper.GenerateSmartBezierPath(startPort, new PortPoint { X = connectingEndX, Y = connectingEndY, Side = ConnectionSide.Left });
                        <path d="@tempPath" stroke="#00a8a8" stroke-width="2" fill="none" stroke-dasharray="5,5" opacity="0.8" />
                        <circle cx="@connectingEndX" cy="@connectingEndY" r="6" fill="#00a8a8" opacity="0.6" />
                    }
                </svg>

                <!-- Nodes on canvas -->
                @foreach (var node in canvasNodes)
                {
                    <div class="canvas-node @node.NodeType.ToLower().Replace(" ", "-") @(selectedNodeId == node.Id ? "selected" : "") status-@node.Status.ToString().ToLower()"
                         style="left: @(node.X)px; top: @(node.Y)px; width: @(node.Width)px; height: @(node.Height)px;"
                         @onmousedown="@(e => HandleNodeMouseDown(e, node))"
                         @onmousedown:stopPropagation
                         @onclick="@(() => SelectNode(node))"
                         @onclick:stopPropagation
                         @ondblclick="@(() => OpenPropertyModal(node))"
                         @ondblclick:stopPropagation
                         @oncontextmenu="@(e => HandleNodeContextMenu(e, node))"
                         @oncontextmenu:preventDefault
                         @onmouseup="@(e => HandleNodeMouseUp(e, node))"
                         @onmouseup:stopPropagation>
                        @{
                            // Determine which sides of this node have connections
                            var nodeConnectedSides = new HashSet<ConnectionSide>();
                            foreach (var conn in connections)
                            {
                                if (connectionPortInfo.TryGetValue(conn, out var portInfo))
                                {
                                    if (conn.SourceId == node.Id) nodeConnectedSides.Add(portInfo.SourceSide);
                                    if (conn.TargetId == node.Id) nodeConnectedSides.Add(portInfo.TargetSide);
                                }
                            }
                        }
                        
                        <!-- Connection handles - hidden on sides with existing connections -->
                        @if (!nodeConnectedSides.Contains(ConnectionSide.Top))
                        {
                            <div class="connection-handle handle-top" 
                                 @onmousedown="@(e => StartConnectionFromHandle(e, node, ConnectionSide.Top))" 
                                 @onmousedown:stopPropagation></div>
                        }
                        @if (!nodeConnectedSides.Contains(ConnectionSide.Bottom))
                        {
                            <div class="connection-handle handle-bottom" 
                                 @onmousedown="@(e => StartConnectionFromHandle(e, node, ConnectionSide.Bottom))" 
                                 @onmousedown:stopPropagation></div>
                        }
                        @if (!nodeConnectedSides.Contains(ConnectionSide.Left))
                        {
                            <div class="connection-handle handle-left" 
                                 @onmousedown="@(e => StartConnectionFromHandle(e, node, ConnectionSide.Left))" 
                                 @onmousedown:stopPropagation></div>
                        }
                        @if (!nodeConnectedSides.Contains(ConnectionSide.Right))
                        {
                            <div class="connection-handle handle-right" 
                                 @onmousedown="@(e => StartConnectionFromHandle(e, node, ConnectionSide.Right))" 
                                 @onmousedown:stopPropagation></div>
                        }
                        
                        <div class="node-header @(ExecutionManager.IsRunning(node.Id) ? "node-running" : "")">
                            @if (node.IsTrigger)
                            {
                                <span class="trigger-indicator" title="Trigger Node">⚡</span>
                            }
                            @{
                                var customNodeDef = NodeHelper.IsCustomNode(node.NodeType) 
                                    ? customNodeDefinitions.FirstOrDefault(d => string.Equals(d.NodeTypeKey, node.NodeType, StringComparison.OrdinalIgnoreCase)) 
                                    : null;
                            }
                            @if (customNodeDef != null && !string.IsNullOrWhiteSpace(customNodeDef.IconSvg))
                            {
                                <span class="node-type-icon custom-svg-icon">@((MarkupString)customNodeDef.IconSvg)</span>
                            }
                            else if (customNodeDef == null)
                            {
                                @* Check for built-in node icon override from catalog *@
                                var builtInIconOverride = BuiltInNodeCatalogService.GetIconOverride(node.NodeType);
                                if (!string.IsNullOrWhiteSpace(builtInIconOverride))
                                {
                                    <span class="node-type-icon custom-svg-icon">@((MarkupString)builtInIconOverride)</span>
                                }
                                else
                                {
                                    <span class="node-type-icon">@NodeHelper.GetDisplayIcon(node.NodeType, node.IconOverride)</span>
                                }
                            }
                            <span class="node-name-label" title="@node.Name">@node.Name</span>
                        </div>
                        
                        @* Surface fields - placeholder values displayed on node *@
                        @if (node.SurfaceFields.Any())
                        {
                            <div class="node-surface-fields">
                                @foreach (var fieldKey in node.SurfaceFields)
                                {
                                    var displayText = GetSurfaceFieldDisplay(node, fieldKey);
                                    
                                    <div class="surface-field" 
                                         title="@displayText"
                                         @oncontextmenu="@(e => ShowRemoveSurfaceFieldMenu(e, node, fieldKey))"
                                         @oncontextmenu:preventDefault
                                         @oncontextmenu:stopPropagation>
                                        @displayText
                                    </div>
                                }
                            </div>
                        }
                        
                        @if (node.NodeType == "Cache")
                        {
                            <button class="view-cache" 
                                    @onclick="@(() => OpenCacheViewer(node.Id))"
                                    @onclick:stopPropagation
                                    title="View Cached Data">📦</button>
                        }

                        @if (node.NodeType == "StorageTable")
                        {
                            <button class="view-cache" 
                                    @onclick="@(() => OpenStorageTableViewer(node.Id))"
                                    @onclick:stopPropagation
                                    title="View Table Data">📦</button>
                        }

                        @if (node.NodeType == "VectorDb")
                        {
                            <button class="view-cache" 
                                    @onclick="@(() => OpenVectorDbViewer(node.Id))"
                                    @onclick:stopPropagation
                                    title="View Vector Data">📦</button>
                        }

                        @if (node.NodeType == "AzureBlob")
                        {
                            <button class="view-cache" 
                                    @onclick="@(() => OpenBlobViewer(node.Id))"
                                    @onclick:stopPropagation
                                    title="Browse Blob Storage">📦</button>
                        }

                        @if (node.NodeType == "S2GStorage")
                        {
                            <button class="view-cache" 
                                    @onclick="@(() => OpenS2GStorageViewer(node.Id))"
                                    @onclick:stopPropagation
                                    title="Browse Files">📦</button>
                        }

                        <!-- Delete button -->
                        <button class="delete-node" 
                                @onclick="@(() => DeleteNode(node.Id))"
                                @onclick:stopPropagation>×</button>
                        
                        @* Scheduler countdown timer - bottom of node *@
                        @if (node.NodeType == "Scheduler")
                        {
                            var countdown = Logic.Nodes.SchedulerNode.GetCountdown(node.Id);
                            if (countdown != null)
                            {
                                <div class="scheduler-countdown" title="Next trigger in @countdown">@countdown</div>
                            }
                        }
                        
                        <!-- Resize handle (bottom-right corner) -->
                        <div class="resize-handle" 
                             @onmousedown="@(e => StartResizeNode(e, node))"
                             @onmousedown:stopPropagation></div>
                    </div>
                    
                    <!-- Tags below node -->
                    @if (node.Tags.Any())
                    {
                        <div class="node-tags" style="left: @(node.X + node.Width / 2)px; top: @(node.Y + node.Height + 5)px;">
                            @foreach (var tag in node.Tags)
                            {
                                <span class="node-tag">@tag</span>
                            }
                        </div>
                    }
                }
            </div>
        </div>

    </div>

