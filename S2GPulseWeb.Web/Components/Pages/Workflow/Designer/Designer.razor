                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "HttpListener")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.HttpListenerEditor 
                                    Configuration="@editingNode.Configuration" 
