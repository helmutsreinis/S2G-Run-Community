                                    NodeId="@editingNode.Id.ToString()"
                                    CanvasNodes="@canvasNodes.Select(n => new S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.OpenClawEditor.CanvasNodeInfo { Id = n.Id.ToString(), Name = n.Name, NodeType = n.NodeType }).ToList()"
                                    CanvasConnections="@connections.Select(c => new S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.OpenClawEditor.CanvasConnectionInfo { SourceId = c.SourceId.ToString(), TargetId = c.TargetId.ToString(), Label = c.Label }).ToList()"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "Anthropic")
