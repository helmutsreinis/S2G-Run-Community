    <!-- Property Popup Modal -->
    @if (editingNode != null)
    {
        <div class="property-modal-overlay" @onmousedown="HandleOverlayMouseDown" @onmouseup="HandleOverlayMouseUp">
            <div class="property-modal" @onclick:stopPropagation @onmousedown:stopPropagation @onmouseup:stopPropagation>
                <div class="modal-header">
                    @{
                        var modalCustomDef = NodeHelper.IsCustomNode(editingNode.NodeType) 
                            ? customNodeDefinitions.FirstOrDefault(d => string.Equals(d.NodeTypeKey, editingNode.NodeType, StringComparison.OrdinalIgnoreCase)) 
                            : null;
                    }
                    <h3>
                        @if (modalCustomDef != null && !string.IsNullOrWhiteSpace(modalCustomDef.IconSvg))
                        {
                            <span class="node-type-icon custom-svg-icon modal-icon">@((MarkupString)modalCustomDef.IconSvg)</span>
                        }
                        else
                        {
                            <span class="node-type-icon">@NodeHelper.GetDisplayIcon(editingNode.NodeType, editingNode.IconOverride)</span>
                        }
                        @editingNode.Name Properties
                    </h3>
                    <button class="modal-close" @onclick="ClosePropertyModal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="modal-tabs">
                        <button class="modal-tab @(activeModalTab == "properties" ? "active" : "")" @onclick="@(() => activeModalTab = "properties")">Properties</button>
                        <button class="modal-tab @(activeModalTab == "settings" ? "active" : "")" @onclick="@(() => activeModalTab = "settings")">Settings</button>
                        <button class="modal-tab @(activeModalTab == "logs" ? "active" : "")" @onclick="@(() => activeModalTab = "logs")">Activity Logs (@editingNode.ActivityLogs.Count)</button>
                    </div>

                    @if (activeModalTab == "properties")
                    {
                        <div class="form-group mb-4">
                            <label class="form-label font-weight-bold">Node Name</label>
                            <input type="text" class="form-control" @bind="editingNode.Name" @bind:after="MarkAsChanged" placeholder="Enter node name..." />
                        </div>

                        @if (modalCustomDef != null && !string.IsNullOrWhiteSpace(modalCustomDef.Description))
                        {
                            <div class="custom-node-description mb-4" style="background: rgba(0, 168, 168, 0.1); border: 1px solid rgba(0, 168, 168, 0.3); border-radius: 8px; padding: 12px; font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5;">
                                <div style="font-weight: 600; color: var(--text-primary); margin-bottom: 4px;">📋 Description</div>
                                @modalCustomDef.Description
                            </div>
                        }
                        else if (modalCustomDef == null)
                        {
                            @* Show description for built-in nodes *@
