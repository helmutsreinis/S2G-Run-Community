                                    CanvasConnections="@connections.Select(c => new S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.DeepSeekAgentEditor.CanvasConnectionInfo { SourceId = c.SourceId, TargetId = c.TargetId, Label = c.Label }).ToList()"
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "CopilotAgent")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.CopilotAgentEditor 
                                    Configuration="@editingNode.Configuration"
                                    NodeId="@editingNode.Id"
                                    OrganizationId="@currentWorkflowOrganizationId"
                                    CanvasNodes="@canvasNodes.Select(n => new S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.CopilotAgentEditor.CanvasNodeInfo { Id = n.Id, Name = n.Name, NodeType = n.NodeType }).ToList()"
                                    CanvasConnections="@connections.Select(c => new S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.CopilotAgentEditor.CanvasConnectionInfo { SourceId = c.SourceId, TargetId = c.TargetId, Label = c.Label }).ToList()"
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "OpenClaw")
