                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "MongoDB")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.MongoDbEditor 
                                    Configuration="@editingNode.Configuration" 
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "AzureBlob")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.AzureBlobEditor 
                                    Configuration="@editingNode.Configuration" 
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "AzureQueueSend")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.AzureQueueSendEditor 
                                    Configuration="@editingNode.Configuration" 
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "AzureQueueMonitor")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.AzureQueueMonitorEditor 
                                    Configuration="@editingNode.Configuration" 
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "Queue")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.QueueEditor 
                                    Configuration="@editingNode.Configuration" 
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "HttpResponse")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.HttpResponseEditor 
                                    Configuration="@editingNode.Configuration" 
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "OneDriveTrigger")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.OneDriveTriggerEditor 
                                    Configuration="@editingNode.Configuration"
                                    OrganizationId="@currentWorkflowOrganizationId"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "Condition")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.ConditionEditor 
                                    Configuration="@editingNode.Configuration" 
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "Cache")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.CacheEditor 
                                    Node="@CreateWorkflowNodeFromCanvas(editingNode)"
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "StorageTable")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.StorageTableEditor 
                                    Configuration="@editingNode.Configuration"
                                    NodeId="@editingNode.Id"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "StorageClient")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.StorageClientEditor 
                                    Configuration="@editingNode.Configuration"
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    StorageTableColumns="@GetStorageTableColumns(editingNode)"
                                    ConnectedStorageTableNodeId="@GetConnectedStorageTableId(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "Loop")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.LoopEditor 
                                    Configuration="@editingNode.Configuration"
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "VectorDb")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.VectorDbEditor 
                                    Configuration="@editingNode.Configuration"
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "VectorClient")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.VectorClientEditor 
                                    Configuration="@editingNode.Configuration"
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    ConnectedVectorStoreNodeId="@GetConnectedVectorStoreId(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "Scheduler")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.SchedulerEditor 
                                    Configuration="@editingNode.Configuration"
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "Aggregator")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.AggregatorEditor 
                                    Configuration="@editingNode.Configuration"
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "S2GStorage")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.S2GStorageEditor 
                                    Configuration="@editingNode.Configuration"
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "ExcelToJson")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.ExcelToJsonEditor 
                                    Configuration="@editingNode.Configuration"
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "ConnectorToken")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.ConnectorTokenEditor 
                                    Configuration="@editingNode.Configuration"
                                    OrganizationId="@currentWorkflowOrganizationId"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "Orchestrator")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.OrchestratorEditor 
                                    Configuration="@editingNode.Configuration"
                                    NodeId="@editingNode.Id"
                                    CanvasNodes="@canvasNodes.Select(n => new S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.OrchestratorEditor.CanvasNodeInfo { Id = n.Id, Name = n.Name, NodeType = n.NodeType }).ToList()"
                                    CanvasConnections="@connections.Select(c => new S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.OrchestratorEditor.CanvasConnectionInfo { SourceId = c.SourceId, TargetId = c.TargetId, Label = c.Label }).ToList()"
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "Remote")
                            {
                                // Find all HttpListener nodes in the workflow (potential source listeners)
                                var upstreamListeners = canvasNodes
                                    .Where(n => n.NodeType == "HttpListener")
                                    .Select(n => (Id: n.Id, Name: n.Name))
                                    .ToList();
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.RemoteNodeEditor 
                                    Node="@CreateWorkflowNodeFromCanvas(editingNode)"
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    UpstreamListeners="@upstreamListeners"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "RemoteCommand")
                            {
                                var remoteCommandConnections = connections.Select(c => (c.SourceId, c.TargetId, c.Label)).ToList();
                                var remoteCommandCanvasNodes = canvasNodes.Select(n => new { n.Id, n.Name, n.NodeType }).ToList();
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.RemoteCommandEditor 
                                    Node="@CreateWorkflowNodeFromCanvas(editingNode)"
                                    AvailablePlaceholders="@GetAvailablePlaceholders(editingNode)"
                                    Connections="@remoteCommandConnections"
                                    CanvasNodes="@remoteCommandCanvasNodes"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (editingNode.NodeType == "Knowledge")
                            {
                                <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.KnowledgeEditor 
                                    Configuration="@editingNode.Configuration"
                                    NodeName="@editingNode.Name"
                                    OnConfigurationChanged="@(json => HandleConfigurationChanged(editingNode, json))" />
                            }
                            else if (NodeHelper.IsCustomNode(editingNode.NodeType))
                            {
                                @* Dynamic rendering of custom node input fields *@
                                var customDef = customNodeDefinitions.FirstOrDefault(d => string.Equals(d.NodeTypeKey, editingNode.NodeType, StringComparison.OrdinalIgnoreCase));
                                if (customDef != null)
                                {
                                    <div class="custom-node-editor">
                                        @* Available Placeholders from upstream nodes *@
                                        <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.PlaceholderList 
                                            Placeholders="@GetAvailablePlaceholders(editingNode)" />
                                        
                                        @* Inputs Section *@
                                        <div class="custom-node-section">
                                            <h6 class="section-header">📥 Inputs</h6>
                                            @foreach (var field in customDef.InputFields.OrderBy(f => f.DisplayOrder))
                                            {
                                                <div class="form-group mb-3">
                                                    <label class="form-label">
                                                        @field.DisplayLabel
                                                        @if (field.IsRequired)
                                                        {
                                                            <span class="text-danger">*</span>
                                                        }
                                                    </label>
                                                    @if (field.FieldType == CustomFieldType.Text)
                                                    {
                                                        <input type="text" class="form-control custom-input" 
                                                               value="@GetCustomNodeFieldValue(editingNode, field.FieldName)"
                                                               @onchange="@(e => SetCustomNodeFieldValue(editingNode, field.FieldName, e.Value?.ToString()))"
                                                               placeholder="@field.PlaceholderText" />
                                                    }
                                                    else if (field.FieldType == CustomFieldType.Number)
                                                    {
                                                        <input type="number" class="form-control custom-input" 
                                                               value="@GetCustomNodeFieldValue(editingNode, field.FieldName)"
                                                               @onchange="@(e => SetCustomNodeFieldValue(editingNode, field.FieldName, e.Value?.ToString()))"
                                                               placeholder="@field.PlaceholderText" />
                                                    }
                                                    else if (field.FieldType == CustomFieldType.Boolean)
                                                    {
                                                        <div class="form-check">
                                                            <input type="checkbox" class="form-check-input"
                                                                   checked="@(GetCustomNodeFieldValue(editingNode, field.FieldName) == "true")"
                                                                   @onchange="@(e => SetCustomNodeFieldValue(editingNode, field.FieldName, ((bool)(e.Value ?? false)).ToString().ToLower()))" />
                                                        </div>
                                                    }
                                                    else if (field.FieldType == CustomFieldType.TextArea)
                                                    {
                                                        <textarea class="form-control custom-input" rows="4"
                                                                  @onchange="@(e => SetCustomNodeFieldValue(editingNode, field.FieldName, e.Value?.ToString()))"
                                                                  placeholder="@field.PlaceholderText">@GetCustomNodeFieldValue(editingNode, field.FieldName)</textarea>
                                                    }
                                                    else if (field.FieldType == CustomFieldType.Password)
                                                    {
                                                        <input type="password" class="form-control custom-input" 
                                                               value="@GetCustomNodeFieldValue(editingNode, field.FieldName)"
                                                               @onchange="@(e => SetCustomNodeFieldValue(editingNode, field.FieldName, e.Value?.ToString()))"
                                                               placeholder="@field.PlaceholderText" />
                                                    }
                                                    @if (!string.IsNullOrEmpty(field.HelpText))
                                                    {
                                                        <small class="text-muted">@field.HelpText</small>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        
                                        @* Outputs Section *@
                                        @if (customDef.OutputParameters.Any())
                                        {
                                            <div class="custom-node-section">
                                                <h6 class="section-header">📤 Outputs</h6>
                                                <div class="placeholder-chips">
                                                    @foreach (var param in customDef.OutputParameters.OrderBy(p => p.DisplayOrder))
                                                    {
                                                        <span class="placeholder-chip" title="@param.Description">
                                                            {{@editingNode.Name.Replace(" ", "").@param.ParameterName}}
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        
                                        @* Tags Section *@
                                        @if (customDef.ConnectionTags.Any())
                                        {
                                            <div class="custom-node-section">
                                                <h6 class="section-header">🏷️ Tags</h6>
                                                <div class="tag-chips">
                                                    @foreach (var tag in customDef.ConnectionTags.OrderBy(t => t.DisplayOrder))
                                                    {
                                                        var tagColor = tag.TagName.ToLower() switch 
                                                        {
                                                            "success" => "#28a745",
                                                            "error" => "#dc3545",
                                                            "empty" => "#6c757d",
                                                            _ => "#17a2b8"
                                                        };
                                                        <span class="tag-chip" style="border-color: @tagColor; color: @tagColor;">
                                                            @tag.TagName
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning">
                                        Custom node definition not loaded for this session. The node is still functional — check the <strong>Activity Logs</strong> tab to trace execution. To load the editor, expand catalog categories to reload the definition cache. <em style="opacity: 0.7;">We're working on improving UI caching logic.</em>
                                    </div>
                                }
                            }
                        </div>
                    }
                    else if (activeModalTab == "settings")
                    {
                        <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.NodeSettingsEditor 
                            LoggingSettings="@editingNode.LoggingSettings"
                            OnSettingsChanged="@(settings => HandleLoggingSettingsChanged(editingNode, settings))"
                            IconOverride="@editingNode.IconOverride"
                            NodeType="@editingNode.NodeType"
                            OnIconChanged="@(icon => HandleIconChanged(editingNode, icon))" />
                    }
                    else if (activeModalTab == "logs")
                    {
                        <div class="node-activity-logs" style="max-height: 400px; overflow-y: auto;">
                            @foreach (var log in editingNode.ActivityLogs.OrderByDescending(l => l.Timestamp))
                            {
                                <div class="log-entry @log.Level.ToString().ToLower() @(string.IsNullOrEmpty(log.Detail) ? "" : "clickable")" 
                                     @onclick="@(() => ShowLogDetail(log))">
                                    <span class="log-time">[@log.Timestamp.ToString("HH:mm:ss")]</span>
                                    <span class="log-msg text-truncate">@log.Message</span>
                                    @if (!string.IsNullOrEmpty(log.Detail))
                                    {
                                        <span class="log-detail-icon">🔍</span>
                                    }
                                </div>
                            }
                            @if (!editingNode.ActivityLogs.Any())
                            {
                                <div class="text-muted small p-3 text-center">No activity logs recorded yet.</div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    @if (editingNode.NodeType == "HttpListener")
                    {
                        <button class="btn @(ExecutionManager.IsRunning(editingNode.Id) ? "btn-danger" : "btn-primary")" 
                                @onclick="@(() => ExecuteNode(editingNode))">
                            @(ExecutionManager.IsRunning(editingNode.Id) ? "■ Stop Node" : "▶ Run Node")
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary" @onclick="@(() => ExecuteNode(editingNode))">▶ Run Node</button>
                    }
                    @if (editingNode.NodeType == "StorageTable")
                    {
                        <button class="btn btn-info" @onclick="@(() => OpenStorageTableViewer(editingNode))">
                            📋 View Data
                        </button>
                    }
                    @if (editingNode.NodeType == "Remote")
                    {
                        <button class="btn btn-info" @onclick="@(() => OpenRemoteMachineMonitor(editingNode))">
                            🖥️ Monitor
                        </button>
                    }
                    <button class="btn btn-secondary" @onclick="ClosePropertyModal">Close</button>
                </div>
            </div>
        </div>
    }

    <!-- Log Detail Modal -->
    @if (selectedLogEntry != null)
    {
        <div class="property-modal-overlay" style="z-index: 2000;" @onclick="CloseLogDetail">
            <div class="property-modal log-detail-modal" @onclick:stopPropagation>
                <div class="modal-header">
                    <h3 class="m-0">Log Details</h3>
                    <button class="modal-close" @onclick="CloseLogDetail">&times;</button>
                </div>
                <div class="modal-body p-3">
                    <div class="log-info mb-3">
                        <span class="badge @selectedLogEntry.Level.ToString().ToLower()">@selectedLogEntry.Level</span>
                        <span class="text-muted ms-2 small">@selectedLogEntry.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")</span>
                    </div>
                    <div class="log-message mb-3">
                        <label class="text-muted small d-block mb-1">Message:</label>
                        <div class="p-2 bg-dark rounded border border-secondary">@selectedLogEntry.Message</div>
                    </div>
                    @if (!string.IsNullOrEmpty(selectedLogEntry.Detail))
                    {
                        <div class="log-detail">
                            <label class="text-muted small d-block mb-1">Detailed Data:</label>
                            <pre class="mt-1 p-3 bg-dark rounded border border-secondary"><code>@selectedLogEntry.Detail</code></pre>
                        </div>
                    }
                </div>
                <div class="modal-footer p-2 border-top border-secondary text-end">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseLogDetail">Close</button>
                </div>
            </div>
        </div>
    }

    <!-- Workflow List Modal -->
    @if (showWorkflowList)
    {
        <div class="property-modal-overlay" style="z-index: 3000;" @onclick="@(() => showWorkflowList = false)">
            <div class="property-modal" style="max-width: 500px;" @onclick:stopPropagation>
                <div class="modal-header">
                    <h3 class="m-0">Your Workflows</h3>
                    <button class="modal-close" @onclick="@(() => showWorkflowList = false)">&times;</button>
                </div>
                <div class="modal-body p-0 overflow-auto" style="max-height: 400px;">
                    @if (userWorkflows.Any())
                    {
                        @foreach (var wf in userWorkflows)
                        {
                            <div class="workflow-list-item" @onclick="@(() => LoadWorkflow(wf.Id))">
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong>@wf.Name</strong>
                                    <span class="text-muted small">@wf.UpdatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</span>
                                </div>
                                @if (!string.IsNullOrEmpty(wf.Description))
                                {
                                    <div class="text-muted small">@wf.Description</div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted">No workflows found.</div>
                    }
                </div>
                <div class="modal-footer p-2 text-end">
                    <button class="btn btn-secondary btn-sm" @onclick="@(() => showWorkflowList = false)">Close</button>
                </div>
            </div>
        </div>
    }

    <!-- Delete Workflow Confirmation Modal -->
    @if (showDeleteConfirmation && deletionInfo != null)
    {
        <div class="property-modal-overlay" style="z-index: 4000;" @onclick="@(() => showDeleteConfirmation = false)">
            <div class="property-modal" style="max-width: 500px;" @onclick:stopPropagation>
                <div class="modal-header" style="border-bottom: 1px solid rgba(231, 76, 60, 0.3);">
                    <h3 class="m-0" style="color: #e74c3c;">⚠️ Delete Workflow</h3>
                    <button class="modal-close" @onclick="@(() => showDeleteConfirmation = false)">&times;</button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>"@deletionInfo.WorkflowName"</strong>?</p>
                    
                    <div class="deletion-details">
                        <h5>This will permanently delete:</h5>
                        <ul>
                            <li>📦 <strong>@deletionInfo.NodeCount</strong> node(s)</li>
                            <li>🔗 <strong>@deletionInfo.ConnectionCount</strong> connection(s)</li>
                            <li>📋 <strong>@deletionInfo.LogCount</strong> log entr@(deletionInfo.LogCount == 1 ? "y" : "ies")</li>
                            @if (deletionInfo.VectorDocCount > 0)
                            {
                                <li>🧠 <strong>@deletionInfo.VectorDocCount</strong> vector document(s)</li>
                            }
                            @if (deletionInfo.StorageRecordCount > 0)
                            {
                                <li>📊 <strong>@deletionInfo.StorageRecordCount</strong> storage record(s)</li>
                            }
                        </ul>
                    </div>
                    
                    <p class="text-danger"><strong>This action cannot be undone!</strong></p>
                </div>
                <div class="modal-footer d-flex justify-content-end gap-2 p-3">
                    <button class="btn btn-secondary" @onclick="@(() => showDeleteConfirmation = false)">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteWorkflow" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span> Deleting...</span>
                        }
                        else
                        {
                            <span>🗑️ Delete Workflow</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Delete Node Confirmation Modal -->
    @if (showNodeDeleteConfirmation && nodeToDelete != null)
    {
        <div class="property-modal-overlay" style="z-index: 4000;" @onclick="CancelDeleteNode">
            <div class="property-modal" style="max-width: 450px; height: auto; min-height: auto;" @onclick:stopPropagation>
                <div class="modal-header" style="border-bottom: 1px solid rgba(231, 76, 60, 0.3);">
                    <h3 class="m-0" style="color: #e74c3c;">⚠️ Delete Node</h3>
                    <button class="modal-close" @onclick="CancelDeleteNode">&times;</button>
                </div>
                <div class="modal-body" style="padding: 1.5rem;">
                    <p style="margin-bottom: 1rem;">Are you sure you want to delete <strong>"@nodeToDelete.Name"</strong>?</p>
                    
                    @{
                        var outgoingConnections = connections.Count(c => c.SourceId == nodeToDelete.Id);
                        var incomingConnections = connections.Count(c => c.TargetId == nodeToDelete.Id);
                        var totalConnections = outgoingConnections + incomingConnections;
                    }
                    
                    @if (totalConnections > 0)
                    {
                        <div class="alert alert-warning py-2 px-3" style="background: rgba(255, 193, 7, 0.15); border: 1px solid rgba(255, 193, 7, 0.3); color: var(--text-primary);">
                            <small>🔗 This will also remove <strong>@totalConnections</strong> connection(s)</small>
                        </div>
                    }
                </div>
                <div class="modal-footer d-flex justify-content-end gap-2 p-3" style="border-top: 1px solid var(--border-color);">
                    <button class="btn btn-secondary" @onclick="CancelDeleteNode">Cancel</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteNode">
                        🗑️ Delete Node
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Canvas Context Menu -->
    @if (showContextMenu && contextMenuNode != null)
    {
        var incomingConnections = connections.Where(c => c.TargetId == contextMenuNode.Id).ToList();
        var outgoingConnections = connections.Where(c => c.SourceId == contextMenuNode.Id).ToList();
        
        <div class="context-menu" style="left: @(contextMenuX)px; top: @(contextMenuY)px;">
            <div class="context-menu-item" @onclick="HandleContextConnect">
                <span>🔗</span> Connect To...
            </div>
            
            @if (incomingConnections.Any())
            {
                <div class="context-menu-separator"></div>
                <div class="context-menu-header">Disconnect From:</div>
                @foreach (var conn in incomingConnections)
                {
                    var sourceNode = canvasNodes.FirstOrDefault(n => n.Id == conn.SourceId);
                    if (sourceNode != null)
                    {
                        <div class="context-menu-item" @onclick="@(() => DisconnectConnection(conn.SourceId, conn.TargetId))">
                            <span>✂️</span> @sourceNode.Name
                        </div>
                    }
                }
            }
            
            @if (outgoingConnections.Any())
            {
                <div class="context-menu-separator"></div>
                <div class="context-menu-header">Remove Connection To:</div>
                @foreach (var conn in outgoingConnections)
                {
                    var targetNode = canvasNodes.FirstOrDefault(n => n.Id == conn.TargetId);
                    if (targetNode != null)
                    {
                        <div class="context-menu-item" @onclick="@(() => DisconnectConnection(conn.SourceId, conn.TargetId))">
                            <span>✂️</span> @targetNode.Name
                        </div>
                    }
                }
            }
            
            <!-- Trigger toggle - only show for nodes without incoming connections -->
            @if (!incomingConnections.Any())
            {
                <div class="context-menu-separator"></div>
                <div class="context-menu-item" @onclick="ToggleNodeTrigger">
                    <span>⚡</span> @(contextMenuNode?.IsTrigger == true ? "Unmark as Trigger" : "Mark as Trigger")
                </div>
            }
            
            <div class="context-menu-separator"></div>
            <div class="context-menu-item delete" @onclick="HandleContextDelete">
                <span>🗑️</span> Delete Node
            </div>
            
            <!-- Add Surface Field -->
            <div class="context-menu-separator"></div>
            <div class="context-menu-item" @onclick="ShowAddSurfaceFieldMenu">
                <span>📊</span> Add Surface Field
            </div>
        </div>
        
        <!-- Add Surface Field Sub-menu -->
        @if (showAddSurfaceFieldMenu && surfaceFieldMenuNode != null)
        {
            var filteredPlaceholders = GetFilteredPlaceholders();
            <div class="context-menu" style="left: @(contextMenuX + 160)px; top: @(contextMenuY)px; min-width: 280px;" @onclick:stopPropagation>
                <div class="context-menu-header">Select Field to Display</div>
                <div class="context-menu-input">
                    <input type="text" class="form-control form-control-sm" 
                           placeholder="Search or enter custom label..." 
                           @bind="surfaceFieldSearchText" 
                           @bind:event="oninput" />
                </div>
                
                @* Add as custom label option *@
                @if (!string.IsNullOrWhiteSpace(surfaceFieldSearchText))
                {
                    <div class="context-menu-item" @onclick="@(() => AddSurfaceField(surfaceFieldSearchText))"
                         style="border-bottom: 1px solid var(--border-color);">
                        <span>🏷️</span> Add as custom label: "@surfaceFieldSearchText"
                    </div>
                }
                
                @if (filteredPlaceholders.Any())
                {
                    @foreach (var placeholder in filteredPlaceholders)
                    {
                        <div class="context-menu-item" @onclick="@(() => AddSurfaceField(placeholder))">
                            <span>📎</span> @placeholder
                        </div>
                    }
                }
                else if (string.IsNullOrWhiteSpace(surfaceFieldSearchText))
                {
                    <div class="context-menu-item" style="color: var(--text-muted); cursor: default;">
                        No placeholders available
                    </div>
                }
            </div>
        }
    }

    <!-- Surface Field Context Menu (Edit/Remove) -->
    @if (showSurfaceFieldMenu && surfaceFieldMenuNode != null && surfaceFieldToRemove != null)
    {
        <div class="context-menu" style="left: @(surfaceFieldMenuX)px; top: @(surfaceFieldMenuY)px;" @onclick:stopPropagation>
            <div class="context-menu-header">Edit Surface Field</div>
            <div class="context-menu-input">
                <input type="text" class="form-control form-control-sm" 
                       placeholder="Enter label with optional {{placeholder}}" 
                       @bind="surfaceFieldEditText" 
                       @bind:event="oninput" />
            </div>
            <div class="context-menu-item" @onclick="SaveSurfaceFieldEdit">
                <span>💾</span> Save Changes
            </div>
            <div class="context-menu-separator"></div>
            <div class="context-menu-item delete" @onclick="RemoveSurfaceField">
                <span>🗑️</span> Remove Field
            </div>
        </div>
    }

    <!-- Connection Context Menu -->
    @if (showConnectionContextMenu && contextMenuConnection != null)
    {
        <div class="context-menu connection-context-menu" 
             style="position: fixed; left: @(connectionContextMenuX)px; top: @(connectionContextMenuY)px;"
             @onclick:stopPropagation>
            <div class="context-menu-header">Connection Label</div>
            <div class="context-menu-input">
                <input type="text" class="form-control form-control-sm" 
                       @bind="connectionLabelInput" 
                       @bind:event="oninput"
                       placeholder="Enter label or select below" />
            </div>
            <div class="context-menu-item" @onclick="SaveConnectionLabel">
                <span>💾</span> Save Label
            </div>
            <div class="context-menu-separator"></div>
            <div class="context-menu-section-header">Quick Labels</div>
            <div class="context-menu-item preset-label" @onclick="@(() => SetConnectionLabelPreset("no-wait"))" title="Fire-and-forget: branch executes independently without blocking">
                <span>⚡</span> no-wait
                <small class="preset-description">Fire-and-forget execution</small>
            </div>
            <div class="context-menu-item preset-label" @onclick="@(() => SetConnectionLabelPreset("true"))" title="Condition branch: executes when condition is true">
                <span>✅</span> true
                <small class="preset-description">Condition: true branch</small>
            </div>
            <div class="context-menu-item preset-label" @onclick="@(() => SetConnectionLabelPreset("false"))" title="Condition branch: executes when condition is false">
                <span>❌</span> false
                <small class="preset-description">Condition: false branch</small>
            </div>
            <div class="context-menu-separator"></div>
            <div class="context-menu-item delete" @onclick="DeleteConnection">
                <span>🗑️</span> Delete Connection
            </div>
        </div>
        <div class="context-menu-backdrop" @onclick="CloseConnectionContextMenu"></div>
    }

    @* Cache Viewer Modal *@
    @if (showCacheViewer)
    {
        <div class="modal fade show" style="display: block;" tabindex="-1">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content" style="background: var(--background-medium); border: 1px solid var(--border-color);">
                    <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                        <h5 class="modal-title" style="color: var(--accent-color);">📦 Cache Viewer</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="@(() => showCacheViewer = false)"></button>
                    </div>
                    <div class="modal-body">
                        <CacheViewer NodeId="@viewingCacheNodeId" WorkflowId="@currentWorkflowId" />
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                        <button type="button" class="btn btn-secondary" @onclick="@(() => showCacheViewer = false)">Close</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @* Storage Table Viewer Modal *@
    @if (showStorageTableViewer && viewingStorageTableNodeId.HasValue)
    {
        <div class="modal fade show" style="display: block;" tabindex="-1">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content" style="background: var(--background-medium); border: 1px solid var(--border-color);">
                    <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                        <h5 class="modal-title" style="color: var(--accent-color);">🗃️ Storage Table Data</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="@(() => showStorageTableViewer = false)"></button>
                    </div>
                    <div class="modal-body">
                        <StorageTableViewer StorageTableNodeId="@viewingStorageTableNodeId.Value" />
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                        <button type="button" class="btn btn-secondary" @onclick="@(() => showStorageTableViewer = false)">Close</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @* Remote Machine Monitor Modal *@
    @if (showRemoteMachineMonitor && viewingRemoteNodeId.HasValue)
    {
        <div class="modal fade show" style="display: block; z-index: 2100;" tabindex="-1">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content" style="background: var(--background-medium); border: 1px solid var(--border-color);">
                    <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                        <h5 class="modal-title" style="color: var(--accent-color);">🖥️ Remote Machine Monitor</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="@(() => showRemoteMachineMonitor = false)"></button>
                    </div>
                    <div class="modal-body">
                        <RemoteMachineMonitor RemoteNodeId="@viewingRemoteNodeId.Value" ClientId="@viewingRemoteClientId" />
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                        <button type="button" class="btn btn-secondary" @onclick="@(() => showRemoteMachineMonitor = false)">Close</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show" style="z-index: 2050;"></div>
    }

    @* Vector DB Viewer Modal *@
    @if (showVectorDbViewer && viewingVectorDbNodeId.HasValue)
    {
        <div class="modal fade show" style="display: block;" tabindex="-1">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content" style="background: var(--background-medium); border: 1px solid var(--border-color);">
                    <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                        <h5 class="modal-title" style="color: var(--accent-color);">🧬 Vector Database</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="@(() => showVectorDbViewer = false)"></button>
                    </div>
                    <div class="modal-body">
                        <VectorDbViewer NodeId="@viewingVectorDbNodeId.Value" />
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                        <button type="button" class="btn btn-secondary" @onclick="@(() => showVectorDbViewer = false)">Close</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @* Azure Blob Viewer Modal *@
    @if (showBlobViewer && viewingBlobNodeId.HasValue)
    {
        <div class="modal fade show" style="display: block;" tabindex="-1">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content" style="background: var(--background-medium); border: 1px solid var(--border-color);">
                    <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                        <h5 class="modal-title" style="color: var(--accent-color);">🗂️ Azure Blob Storage</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="@(() => showBlobViewer = false)"></button>
                    </div>
                    <div class="modal-body">
                        <BlobViewer NodeId="@viewingBlobNodeId.Value" Configuration="@(canvasNodes.FirstOrDefault(n => n.Id == viewingBlobNodeId.Value)?.Configuration)" />
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                        <button type="button" class="btn btn-secondary" @onclick="@(() => showBlobViewer = false)">Close</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    @* S2G Storage Viewer Modal *@
    @if (showS2GStorageViewer && viewingS2GStorageNodeId.HasValue)
    {
        <div class="modal fade show" style="display: block;" tabindex="-1">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content" style="background: var(--background-medium); border: 1px solid var(--border-color);">
                    <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                        <h5 class="modal-title" style="color: var(--accent-color); display: flex; align-items: center; gap: 8px;">
                            @{
                                var s2gStorageIcon = BuiltInNodeCatalogService.GetIconOverride("S2GStorage");
                            }
                            @if (!string.IsNullOrWhiteSpace(s2gStorageIcon))
                            {
                                <span class="custom-svg-icon" style="width: 20px; height: 20px;">@((MarkupString)s2gStorageIcon)</span>
                            }
                            else
                            {
                                <span>📁</span>
                            }
                            My Storage
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="@(() => showS2GStorageViewer = false)"></button>
                    </div>
                    <div class="modal-body">
                        <S2GStorageViewer NodeId="@viewingS2GStorageNodeId.Value" UserId="@currentUserId" />
                    </div>
                    <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                        <button type="button" class="btn btn-secondary" @onclick="@(() => showS2GStorageViewer = false)">Close</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
</div>
