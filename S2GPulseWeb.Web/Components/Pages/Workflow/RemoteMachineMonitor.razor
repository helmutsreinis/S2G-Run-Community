@code {
    [Parameter] public Guid RemoteNodeId { get; set; }
    [Parameter] public string? ClientId { get; set; }

    private RemoteClientMetadata? clientMetadata;
    private List<RemoteCommand> pendingCommands = new();
    private List<RemoteCommand> completedCommands = new();
    private List<MetricsSample> metricsHistory = new();
    private string activeTab = "commands";
    private string newCommand = "";
    private int newTimeout = 60;
    private System.Threading.Timer? _refreshTimer;
    private Guid? expandedOutputId;
    private bool showDiskBreakdown = false;
    
    private bool IsOnline => clientMetadata != null && (DateTime.UtcNow - clientMetadata.LastSeen).TotalMinutes < 2;
    private bool HasDiskBreakdown => !string.IsNullOrEmpty(clientMetadata?.DiskBreakdown) && clientMetadata.DiskBreakdown != "[]";

    // Disk breakdown model
    private record DiskInfo(string Drive, double UsedPercent, double UsedGB, double FreeGB, double TotalGB);
    
    private List<DiskInfo> ParseDiskBreakdown()
    {
        try
        {
            if (string.IsNullOrEmpty(clientMetadata?.DiskBreakdown)) return new();
            var breakdown = System.Text.Json.JsonSerializer.Deserialize<List<System.Text.Json.JsonElement>>(clientMetadata.DiskBreakdown);
            if (breakdown == null) return new();
            
            return breakdown.Select(d => new DiskInfo(
                d.TryGetProperty("drive", out var drive) ? drive.GetString() ?? "" : "",
                d.TryGetProperty("usedPercent", out var up) ? up.GetDouble() : 0,
                d.TryGetProperty("usedGB", out var ug) ? ug.GetDouble() : 0,
                d.TryGetProperty("freeGB", out var fg) ? fg.GetDouble() : 0,
                d.TryGetProperty("totalGB", out var tg) ? tg.GetDouble() : 0
            )).ToList();
        }
        catch { return new(); }
    }
    
    private string GetDiskColor(double usedPercent)
    {
        if (usedPercent >= 90) return "#f44336"; // Red - critical
        if (usedPercent >= 75) return "#ff9800"; // Orange - warning
        return "#4caf50"; // Green - healthy
    }

    // Custom Reports state
    private List<CustomReportData> customReports = new();
    private string newReportName = "";
    private string newReportScript = "";
    private int newReportInterval = 60;
    private string selectedReportName = "";
    
    private bool HasCustomReports => customReports.Any();
    private int CustomReportsCount => customReports.Count;

    // Custom Report model
    private record CustomReportData(
        string Name, 
        bool Enabled, 
        List<System.Text.Json.JsonElement>? Data, 
        string? Error, 
        DateTime? LastUpdated);

    private void ParseCustomReports()
    {
        customReports.Clear();
        try
        {
            if (string.IsNullOrEmpty(clientMetadata?.CustomReports) || clientMetadata.CustomReports == "[]") return;
            
            var reports = System.Text.Json.JsonSerializer.Deserialize<List<System.Text.Json.JsonElement>>(clientMetadata.CustomReports);
            if (reports == null) return;

            foreach (var r in reports)
            {
                var name = r.TryGetProperty("name", out var n) ? n.GetString() ?? "" : "";
                var enabled = r.TryGetProperty("enabled", out var e) && e.GetBoolean();
                var error = r.TryGetProperty("error", out var err) ? err.GetString() : null;
                var lastUpdated = r.TryGetProperty("lastUpdated", out var lu) ? 
                    DateTime.TryParse(lu.GetString(), out var dt) ? dt : (DateTime?)null : null;
                
                List<System.Text.Json.JsonElement>? data = null;
                if (r.TryGetProperty("data", out var d) && d.ValueKind == System.Text.Json.JsonValueKind.Array)
                {
                    data = d.EnumerateArray().ToList();
                }

                customReports.Add(new CustomReportData(name, enabled, data, error, lastUpdated));
            }
        }
        catch { }
    }

    private List<string> GetReportColumns(List<System.Text.Json.JsonElement> data)
    {
        if (data == null || !data.Any()) return new();
        var first = data.First();
        if (first.ValueKind != System.Text.Json.JsonValueKind.Object) return new();
        return first.EnumerateObject().Select(p => p.Name).ToList();
    }

    private string GetCellValue(System.Text.Json.JsonElement row, string column)
    {
        if (row.TryGetProperty(column, out var val))
        {
            return val.ValueKind switch
            {
                System.Text.Json.JsonValueKind.String => val.GetString() ?? "",
                System.Text.Json.JsonValueKind.Number => val.GetDouble().ToString(),
                System.Text.Json.JsonValueKind.True => "✓",
                System.Text.Json.JsonValueKind.False => "✗",
                System.Text.Json.JsonValueKind.Null => "",
                _ => val.GetRawText()
            };
        }
        return "";
    }

    private async Task AddReport()
    {
        if (string.IsNullOrWhiteSpace(newReportName) || string.IsNullOrWhiteSpace(newReportScript)) return;
        
        var reportCmd = new
        {
            action = "add",
            name = newReportName.Replace(" ", "-"),
            script = newReportScript,
            intervalSeconds = newReportInterval
        };
        
        var command = "__REPORT__" + System.Text.Json.JsonSerializer.Serialize(reportCmd);
        RemoteNode.QueueCommandExternal(RemoteNodeId, command, 5);
        
        newReportName = "";
        newReportScript = "";
        newReportInterval = 60;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleReport(string reportName)
    {
        var reportCmd = new { action = "toggle", name = reportName };
        var command = "__REPORT__" + System.Text.Json.JsonSerializer.Serialize(reportCmd);
        RemoteNode.QueueCommandExternal(RemoteNodeId, command, 5);
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteReport(string reportName)
    {
        var reportCmd = new { action = "delete", name = reportName };
        var command = "__REPORT__" + System.Text.Json.JsonSerializer.Serialize(reportCmd);
        RemoteNode.QueueCommandExternal(RemoteNodeId, command, 5);
        
        if (selectedReportName == reportName) selectedReportName = "";
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleOutput(Guid executionId)
    {
        expandedOutputId = expandedOutputId == executionId ? null : executionId;
    }

    protected override void OnInitialized()
    {
        LoadData();
        // Auto-refresh every 5 seconds
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            LoadData();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void LoadData()
    {
        if (!string.IsNullOrEmpty(ClientId))
        {
            clientMetadata = RemoteNode.GetClientStatus(RemoteNodeId, ClientId);
            if (clientMetadata != null)
            {
                // Filter metrics to last 1 hour
                var oneHourAgo = DateTime.UtcNow.AddHours(-1);
                metricsHistory = clientMetadata.MetricsHistory
                    .Where(m => m.Timestamp > oneHourAgo)
                    .ToList();
                
                // Parse custom reports
                ParseCustomReports();
            }
        }
        
        // Get commands (both pending and completed)
        var allCommands = RemoteNode.GetAllCommands(RemoteNodeId);
        pendingCommands = allCommands.Where(c => c.CompletedAt == null).ToList();
        completedCommands = allCommands.Where(c => c.CompletedAt != null).Take(10).ToList();
    }

    private void Refresh()
    {
        LoadData();
        StateHasChanged();
    }

    private void QueueCommand()
    {
        if (string.IsNullOrWhiteSpace(newCommand)) return;
        
        RemoteNode.QueueCommandExternal(RemoteNodeId, newCommand, newTimeout);
        newCommand = "";
        LoadData();
        StateHasChanged();
    }

    private string GetChartPoints(Func<MetricsSample, double> valueSelector)
    {
        if (metricsHistory.Count < 2) return "";

        var points = new List<string>();
        var chartWidth = 540.0;
        var chartHeight = 160.0;
        var xOffset = 50.0;
        var yOffset = 10.0;

        for (int i = 0; i < metricsHistory.Count; i++)
        {
            var x = xOffset + (i * chartWidth / (metricsHistory.Count - 1));
            var value = Math.Min(100, Math.Max(0, valueSelector(metricsHistory[i])));
            var y = yOffset + chartHeight - (value / 100.0 * chartHeight);
            points.Add($"{x:F1},{y:F1}");
        }

        return string.Join(" ", points);
    }

    private string GetTimeRange()
    {
        if (metricsHistory.Count < 2) return "";
        var first = metricsHistory.First().Timestamp;
        var last = metricsHistory.Last().Timestamp;
        var duration = last - first;
        return duration.TotalMinutes >= 60 
            ? $"Last {duration.TotalHours:F1}h" 
            : $"Last {duration.TotalMinutes:F0}m";
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
