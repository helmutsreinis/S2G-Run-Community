@using System.Text.Json
@using S2GPulseWeb.Web.Logic.Nodes
@using S2GPulseWeb.Web.Logic
@inject BuiltInNodeCatalogService BuiltInNodeCatalogService

<div class="node-editor-fields orchestrator-editor">
    @* Task Configuration Section *@
    <div class="editor-section">
        <div class="section-header" @onclick="() => taskConfigExpanded = !taskConfigExpanded">
            <span class="section-icon">📋</span>
            <span class="section-title">Task Configuration</span>
            <span class="expand-icon">@(taskConfigExpanded ? "▼" : "▶")</span>
        </div>
        @if (taskConfigExpanded)
        {
            <div class="section-content">
                <div class="form-group">
                    <label class="form-label">Task Description</label>
                    <textarea class="form-control" rows="3"
                              placeholder="Describe the orchestration task..."
                              value="@config.TaskDescription"
                              @onchange="@(e => UpdateConfig(c => c.TaskDescription = e.Value?.ToString() ?? ""))"></textarea>
                    <small class="form-text text-muted">High-level task description passed to all agents</small>
                </div>

                <div class="form-row">
                    <div class="form-group half">
                        <label class="form-label">Max Iterations</label>
                        <input type="number" class="form-control" min="1" max="20"
                               value="@config.MaxIterations"
                               @onchange="@(e => UpdateConfig(c => c.MaxIterations = int.TryParse(e.Value?.ToString(), out var v) && v > 0 ? v : 5))" />
                    </div>
                    <div class="form-group half">
                        <label class="form-label">Evaluation Type</label>
                        <select class="form-control"
                                value="@config.EvaluationType"
                                @onchange="@(e => UpdateConfig(c => c.EvaluationType = Enum.TryParse<EvaluationType>(e.Value?.ToString(), out var v) ? v : EvaluationType.Expression))">
                            <option value="Expression">Expression</option>
                            <option value="AIEvaluation">AI Evaluation</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Success Criteria</label>
                    @if (config.EvaluationType == EvaluationType.Expression)
                    {
                        <input type="text" class="form-control monospace"
                               placeholder="{{Reporter.Status}} == 'success'"
                               value="@config.SuccessCriteria"
                               @onchange="@(e => UpdateConfig(c => c.SuccessCriteria = e.Value?.ToString()))" />
                        <small class="form-text text-muted">Expression to evaluate success (uses placeholder values)</small>
                    }
                    else
                    {
                        <textarea class="form-control" rows="2"
                                  placeholder="Evaluate if the task was completed successfully..."
                                  value="@config.SuccessCriteria"
                                  @onchange="@(e => UpdateConfig(c => c.SuccessCriteria = e.Value?.ToString()))"></textarea>
                        <small class="form-text text-muted">AI prompt for evaluating task completion</small>
                    }
                </div>
            </div>
        }
    </div>

    @* Steering AI Section - Shows detected orchestrate connection *@
    <div class="editor-section steering-ai-section">
        <div class="section-header" @onclick="() => steeringAIExpanded = !steeringAIExpanded">
            <span class="section-icon">🎯</span>
            <span class="section-title">Steering AI @(discoveredSteeringAI != null ? "✓" : "(Not Connected)")</span>
            <span class="expand-icon">@(steeringAIExpanded ? "▼" : "▶")</span>
        </div>
        @if (steeringAIExpanded)
        {
            <div class="section-content">
                @if (discoveredSteeringAI != null)
                {
                    <div class="steering-ai-card">
                        @{
                            var steeringIconSvg = GetAgentIconSvg(discoveredSteeringAI.NodeType);
                        }
                        @if (!string.IsNullOrWhiteSpace(steeringIconSvg))
                        {
                            <span class="agent-icon custom-svg-icon">@((MarkupString)steeringIconSvg)</span>
                        }
                        else
                        {
                            <span class="agent-icon">@GetAgentIcon(discoveredSteeringAI.NodeType)</span>
                        }
                        <div class="steering-ai-info">
                            <span class="steering-ai-name">@discoveredSteeringAI.RoleName</span>
                            <span class="agent-badge">@discoveredSteeringAI.NodeType</span>
                        </div>
                        <span class="steering-status connected">Connected</span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Custom Instructions (Prepended to Auto-Prompt)</label>
                        <textarea class="form-control" rows="2"
                                  placeholder="Add custom context or rules for the steering AI..."
                                  value="@config.SteeringAIPromptPrefix"
                                  @onchange="@(e => UpdateConfig(c => c.SteeringAIPromptPrefix = e.Value?.ToString()))"></textarea>
                        <small class="form-text text-muted">Added before the auto-generated agent roster. Leave empty to use default.</small>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <span>No steering AI connected.</span>
                        <span>Draw a connection from an AI node to this Orchestrator with <code>orchestrate</code> label.</span>
                    </div>
                    <small class="form-text text-muted">Without a steering AI, agents run in sequential order (legacy mode).</small>
                }
            </div>
        }
    </div>

    @* Agents Section - Shows discovered agents from canvas connections *@
    <div class="editor-section">
        <div class="section-header" @onclick="() => agentsExpanded = !agentsExpanded">
            <span class="section-icon">🤖</span>
            <span class="section-title">Connected Agents (@discoveredAgents.Count)</span>
            <span class="expand-icon">@(agentsExpanded ? "▼" : "▶")</span>
        </div>
        @if (agentsExpanded)
        {
            <div class="section-content">
                @if (discoveredAgents.Count == 0)
                {
                    <div class="empty-state">
                        <span>No agents connected. Draw connections from AI nodes to this Orchestrator with "agent" label.</span>
                    </div>
                }
                else
                {
                    @foreach (var (agent, index) in discoveredAgents.Select((a, i) => (a, i)))
                    {
                        <div class="agent-card @(expandedAgentIndex == index ? "expanded" : "")">
                            <div class="agent-header">
                                <div class="reorder-buttons">
                                    <button class="reorder-btn" @onclick="() => MoveAgentUp(agent.NodeId)" @onclick:stopPropagation="true" disabled="@(index == 0)" title="Move up">▲</button>
                                    <button class="reorder-btn" @onclick="() => MoveAgentDown(agent.NodeId)" @onclick:stopPropagation="true" disabled="@(index == discoveredAgents.Count - 1)" title="Move down">▼</button>
                                </div>
                                <span class="agent-order">@(GetAgentOrder(agent.NodeId) + 1)</span>
                                @{
                                    var agentIconSvg = GetAgentIconSvg(agent.NodeType);
                                }
                                @if (!string.IsNullOrWhiteSpace(agentIconSvg))
                                {
                                    <span class="agent-icon custom-svg-icon" @onclick="() => ToggleAgent(index)">@((MarkupString)agentIconSvg)</span>
                                }
                                else
                                {
                                    <span class="agent-icon" @onclick="() => ToggleAgent(index)">@GetAgentIcon(agent.NodeType)</span>
                                }
                                <span class="agent-name" @onclick="() => ToggleAgent(index)">@agent.RoleName</span>
                                <span class="agent-badge">@(agent.NodeType ?? "AI")</span>
                                <span class="expand-icon" @onclick="() => ToggleAgent(index)">@(expandedAgentIndex == index ? "▼" : "▶")</span>
                            </div>
                            @if (expandedAgentIndex == index)
                            {
                                <div class="agent-details">
                                    <div class="form-group">
                                        <label class="form-label d-flex align-items-center">
                                            <input type="checkbox" class="form-check-input me-2"
                                                   checked="@GetAgentEnabled(agent.NodeId)"
                                                   @onchange="@(e => SetAgentEnabled(agent.NodeId, e.Value is bool b && b))" />
                                            Enabled
                                        </label>
                                        <small class="form-text text-muted">Disabled agents won't be called by the steering AI</small>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Skill Description</label>
                                        <textarea class="form-control" rows="2"
                                                  placeholder="Describe what this agent is good at..."
                                                  value="@GetAgentSkillDescription(agent.NodeId)"
                                                  @onchange="@(e => SetAgentSkillDescription(agent.NodeId, e.Value?.ToString()))"></textarea>
                                        <small class="form-text text-muted">Steering AI uses this to decide when to call this agent</small>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">Role Name (Override)</label>
                                        <input type="text" class="form-control" 
                                               placeholder="@agent.RoleName"
                                               value="@GetAgentRoleOverride(agent.NodeId)"
                                               @onchange="@(e => SetAgentRoleOverride(agent.NodeId, e.Value?.ToString()))" />
                                        <small class="form-text text-muted">Leave empty to use node name</small>
                                    </div>
                                    <div class="form-group">
                                        <label class="form-label">System Prompt (Override)</label>
                                        <textarea class="form-control" rows="2"
                                                  placeholder="Uses agent's configured prompt if empty..."
                                                  value="@GetAgentPromptOverride(agent.NodeId)"
                                                  @onchange="@(e => SetAgentPromptOverride(agent.NodeId, e.Value?.ToString()))"></textarea>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>

    @* Output Tags Section *@
    <div class="editor-section">
        <div class="section-header" @onclick="() => tagsExpanded = !tagsExpanded">
            <span class="section-icon">🏷️</span>
            <span class="section-title">Output Tags</span>
            <span class="expand-icon">@(tagsExpanded ? "▼" : "▶")</span>
        </div>
        @if (tagsExpanded)
        {
            <div class="section-content">
                <div class="output-tags">
                    <span class="tag-chip complete">complete</span>
                    <span class="tag-chip error">error</span>
                    @foreach (var tag in config.OutputTags.Where(t => t != "complete" && t != "error"))
                    {
                        <span class="tag-chip custom">@tag <button class="remove-chip" @onclick="() => RemoveTag(tag)">×</button></span>
                    }
                </div>
                <small class="form-text text-muted">Orchestrator routes to "complete" on success, "error" on max iterations</small>
            </div>
        }
    </div>

    @* Execution Stats *@
    @if (!string.IsNullOrEmpty(config.LastExecutedAt))
    {
        <div class="execution-stats">
            <label class="form-label">Last Execution</label>
            <div class="stats-display">
                <span>🕐 @config.LastExecutedAt</span>
                @if (config.LastIterationCount.HasValue)
                {
                    <span class="ms-2">🔄 @config.LastIterationCount iterations</span>
                }
                @if (config.LastSuccess.HasValue)
                {
                    <span class="ms-2">@(config.LastSuccess.Value ? "✅ Success" : "❌ Max reached")</span>
                }
            </div>
        </div>
    }

    @* Help Section *@
    <details class="help-section">
        <summary>📖 Output Placeholders</summary>
        <div class="help-content">
            <ul>
                <li><code>{{Orchestrator.FinalResult}}</code> - "completed" or "max_iterations_reached"</li>
                <li><code>{{Orchestrator.IterationCount}}</code> - Number of iterations performed</li>
                <li><code>{{Orchestrator.IsSuccess}}</code> - Boolean success status</li>
                <li><code>{{Orchestrator.AgentResponses}}</code> - JSON of all agent responses</li>
                <li><code>{{Orchestrator.LastEvaluation}}</code> - Final evaluation message</li>
            </ul>
        </div>
    </details>
</div>

