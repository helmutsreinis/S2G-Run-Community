    private int GetAgentOrder(Guid nodeId)
    {
        var agent = config.Agents.FirstOrDefault(a => a.NodeId == nodeId);
        return agent?.ExecutionOrder ?? 0;
    }
    
    private async Task MoveAgentUp(Guid nodeId)
    {
        var agentsList = config.Agents.OrderBy(a => a.ExecutionOrder).ToList();
        var index = agentsList.FindIndex(a => a.NodeId == nodeId);
        
        if (index > 0)
        {
            // Swap execution orders
            var currentOrder = agentsList[index].ExecutionOrder;
            agentsList[index].ExecutionOrder = agentsList[index - 1].ExecutionOrder;
            agentsList[index - 1].ExecutionOrder = currentOrder;
            await NotifyChanged();
        }
    }
    
    private async Task MoveAgentDown(Guid nodeId)
    {
        var agentsList = config.Agents.OrderBy(a => a.ExecutionOrder).ToList();
        var index = agentsList.FindIndex(a => a.NodeId == nodeId);
        
        if (index >= 0 && index < agentsList.Count - 1)
        {
            // Swap execution orders
            var currentOrder = agentsList[index].ExecutionOrder;
            agentsList[index].ExecutionOrder = agentsList[index + 1].ExecutionOrder;
            agentsList[index + 1].ExecutionOrder = currentOrder;
            await NotifyChanged();
        }
    }

    private async Task AddToolToAgent(Guid nodeId, string? toolTag)
    {
        if (string.IsNullOrEmpty(toolTag)) return;

        var agent = config.Agents.FirstOrDefault(a => a.NodeId == nodeId);
        if (agent == null)
        {
            agent = new AgentConfig { NodeId = nodeId };
            config.Agents.Add(agent);
        }
        
        agent.AssignedTools ??= new List<string>();
        if (!agent.AssignedTools.Contains(toolTag))
        {
            agent.AssignedTools.Add(toolTag);
            await NotifyChanged();
        }
    }

    private async Task RemoveToolFromAgent(Guid nodeId, string toolTag)
    {
        var agent = config.Agents.FirstOrDefault(a => a.NodeId == nodeId);
        if (agent?.AssignedTools != null)
        {
            agent.AssignedTools.Remove(toolTag);
            await NotifyChanged();
        }
    }

    private async Task RemoveTag(string tag)
    {
        config.OutputTags.Remove(tag);
        await NotifyChanged();
    }

