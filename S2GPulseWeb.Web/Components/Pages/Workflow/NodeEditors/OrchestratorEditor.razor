@code {
    [Parameter] public string? Configuration { get; set; }
    [Parameter] public EventCallback<string> OnConfigurationChanged { get; set; }
    [Parameter] public List<string> AvailablePlaceholders { get; set; } = new();
    [Parameter] public Guid NodeId { get; set; }
    
    // Canvas data for discovering connections
    [Parameter] public List<CanvasNodeInfo>? CanvasNodes { get; set; }
    [Parameter] public List<CanvasConnectionInfo>? CanvasConnections { get; set; }

    private OrchestratorConfig config = new();
    private List<DiscoveredAgent> discoveredAgents = new();
    private List<DiscoveredTool> discoveredTools = new();
    private DiscoveredAgent? discoveredSteeringAI = null;
    
    private bool taskConfigExpanded = true;
    private bool steeringAIExpanded = true;
    private bool agentsExpanded = true;
    private bool tagsExpanded = false;
    private int expandedAgentIndex = -1;
    private bool isDiscovering = false; // Guard against infinite loop

    protected override void OnParametersSet()
    {
        // Only re-parse config if it changed externally (not from our own NotifyChanged)
        if (!isDiscovering)
        {
            try
            {
                config = JsonSerializer.Deserialize<OrchestratorConfig>(Configuration ?? "{}") ?? new();
            }
            catch { config = new(); }
            
            DiscoverConnections();
        }
    }
    
    /// <summary>
    /// Discovers agents and tools from canvas connections and syncs to config.
    /// </summary>
    private void DiscoverConnections()
    {
        discoveredAgents.Clear();
        discoveredTools.Clear();
        discoveredSteeringAI = null;
        
        if (CanvasNodes == null || CanvasConnections == null || NodeId == Guid.Empty)
            return;
        
        // Discover steering AI: connection TO this Orchestrator with "orchestrate" label
        var orchestrateConnection = CanvasConnections
            .FirstOrDefault(c => c.TargetId == NodeId && 
                        string.Equals(c.Label, "orchestrate", StringComparison.OrdinalIgnoreCase));
        
        if (orchestrateConnection != null)
        {
            var steeringNode = CanvasNodes.FirstOrDefault(n => n.Id == orchestrateConnection.SourceId);
            if (steeringNode != null && IsAINode(steeringNode.NodeType))
            {
                discoveredSteeringAI = new DiscoveredAgent
                {
                    NodeId = steeringNode.Id,
                    RoleName = steeringNode.Name,
                    NodeType = steeringNode.NodeType
                };
                
                // Sync to config
                if (config.SteeringAINodeId != steeringNode.Id)
                {
                    config.SteeringAINodeId = steeringNode.Id;
                    config.SteeringAINodeName = steeringNode.Name;
                }
            }
        }
        else if (config.SteeringAINodeId.HasValue)
        {
            // Steering AI was disconnected - clear from config
            config.SteeringAINodeId = null;
            config.SteeringAINodeName = null;
        }
        
        // Discover agents: connections TO this Orchestrator with "agent" label
        var agentConnections = CanvasConnections
            .Where(c => c.TargetId == NodeId && 
                        string.Equals(c.Label, "agent", StringComparison.OrdinalIgnoreCase))
            .ToList();
        
        var needsConfigUpdate = false;
        
        foreach (var conn in agentConnections)
        {
            var sourceNode = CanvasNodes.FirstOrDefault(n => n.Id == conn.SourceId);
            if (sourceNode != null && IsAINode(sourceNode.NodeType))
            {
                discoveredAgents.Add(new DiscoveredAgent
                {
                    NodeId = sourceNode.Id,
                    RoleName = sourceNode.Name,
                    NodeType = sourceNode.NodeType
                });
                
                // Ensure this agent exists in config with correct info
                var existingAgent = config.Agents.FirstOrDefault(a => a.NodeId == sourceNode.Id);
                if (existingAgent == null)
                {
                    config.Agents.Add(new AgentConfig
                    {
                        NodeId = sourceNode.Id,
                        RoleName = sourceNode.Name,
                        NodeType = sourceNode.NodeType,
                        ExecutionOrder = config.Agents.Count
                    });
                    needsConfigUpdate = true;
                }
                else if (existingAgent.NodeType != sourceNode.NodeType)
                {
                    // Update node type if changed
                    existingAgent.NodeType = sourceNode.NodeType;
                    if (string.IsNullOrEmpty(existingAgent.RoleName))
                        existingAgent.RoleName = sourceNode.Name;
                    needsConfigUpdate = true;
                }
            }
        }
        
        // Remove agents from config that are no longer connected
        var connectedAgentIds = discoveredAgents.Select(a => a.NodeId).ToHashSet();
        var agentsToRemove = config.Agents.Where(a => !connectedAgentIds.Contains(a.NodeId)).ToList();
        foreach (var agent in agentsToRemove)
        {
            config.Agents.Remove(agent);
            needsConfigUpdate = true;
        }
        
        // Discover tools: connections with "tool:*" labels (check BOTH directions for flexibility)
        // Outgoing from Orchestrator OR incoming to Orchestrator
        var toolConnections = CanvasConnections
            .Where(c => c.Label?.StartsWith("tool:", StringComparison.OrdinalIgnoreCase) == true &&
                        (c.SourceId == NodeId || c.TargetId == NodeId))
            .ToList();
        
        foreach (var conn in toolConnections)
        {
            // Get the tool node (the one that's NOT the orchestrator)
            var toolNodeId = conn.SourceId == NodeId ? conn.TargetId : conn.SourceId;
            var toolNode = CanvasNodes.FirstOrDefault(n => n.Id == toolNodeId);
            
            discoveredTools.Add(new DiscoveredTool
            {
                ToolTag = conn.Label ?? "tool:unknown",
                EntryNodeId = toolNodeId,
                EntryNodeName = toolNode?.Name ?? "Unknown",
                EntryNodeType = toolNode?.NodeType ?? "Unknown"
            });
            
            // Sync to config.ToolChains
            var toolTag = conn.Label ?? "tool:unknown";
            if (!config.ToolChains.Any(t => t.ToolTag == toolTag))
            {
                config.ToolChains.Add(new ToolChainConfig
                {
                    ToolTag = toolTag,
                    EntryNodeId = toolNodeId,
                    EntryNodeType = toolNode?.NodeType ?? "Unknown",
                    BranchCount = 1,
                    TotalNodeCount = 1
                });
                needsConfigUpdate = true;
            }
        }
        
        // Remove tool chains that are no longer connected
        var connectedToolTags = discoveredTools.Select(t => t.ToolTag).ToHashSet();
        var toolsToRemove = config.ToolChains.Where(t => !connectedToolTags.Contains(t.ToolTag)).ToList();
        foreach (var tool in toolsToRemove)
        {
            config.ToolChains.Remove(tool);
            needsConfigUpdate = true;
        }
        
        // Notify config change if needed (with guard to prevent infinite loop)
        if (needsConfigUpdate)
        {
            isDiscovering = true;
            _ = NotifyChanged().ContinueWith(_ => isDiscovering = false);
        }
    }
    
