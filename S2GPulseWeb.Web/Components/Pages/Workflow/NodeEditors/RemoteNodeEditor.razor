</style>

@code {
    [Parameter] public WorkflowNode? Node { get; set; }
    [Parameter] public List<string>? AvailablePlaceholders { get; set; }
    [Parameter] public EventCallback<string> OnConfigurationChanged { get; set; }
    /// <summary>List of upstream listener nodes: (Id, Name)</summary>
    [Parameter] public List<(Guid Id, string Name)>? UpstreamListeners { get; set; }

    private RemoteNodeConfig config = new();
    private RemoteClientMetadata? clientMetadata;
    private int queuedCount = 0;
    private bool IsOnline => clientMetadata != null && (DateTime.UtcNow - clientMetadata.LastSeen).TotalMinutes < 2;
    private System.Threading.Timer? _refreshTimer;
    private string selectedDeployListenerId = "";
    
    // Binding helper for SourceListenerId dropdown
    private string sourceListenerIdString
    {
        get => config.SourceListenerId?.ToString() ?? "";
        set
        {
            if (Guid.TryParse(value, out var id))
                config.SourceListenerId = id;
            else
                config.SourceListenerId = null;
        }
    }

    protected override void OnParametersSet()
    {
        if (Node != null && !string.IsNullOrEmpty(Node.Configuration))
        {
            try
            {
                config = JsonSerializer.Deserialize<RemoteNodeConfig>(Node.Configuration) ?? new();
            }
            catch
            {
                config = new();
            }
        }

        // Auto-generate ClientId if empty
        if (string.IsNullOrEmpty(config.ClientId))
        {
            config.ClientId = Guid.NewGuid().ToString();
        }

        RefreshClientStatus();

        // Auto-select first listener for deploy one-liner
        if (string.IsNullOrEmpty(selectedDeployListenerId) && UpstreamListeners != null && UpstreamListeners.Count > 0)
        {
            selectedDeployListenerId = UpstreamListeners[0].Id.ToString();
        }
    }

    protected override void OnInitialized()
    {
        // Start timer to refresh client status every 5 seconds
        _refreshTimer = new System.Threading.Timer(async _ =>
        {
            RefreshClientStatus();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private void RefreshClientStatus()
    {
        if (Node != null && !string.IsNullOrEmpty(config.ClientId))
        {
            clientMetadata = RemoteNode.GetClientStatus(Node.Id, config.ClientId);
            queuedCount = RemoteNode.GetQueuedCommandCount(Node.Id);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await SaveConfiguration();
    }

    private async Task SaveConfiguration()
    {
        var json = JsonSerializer.Serialize(config);
        if (Node != null && Node.Configuration != json)
        {
            Node.Configuration = json;
            await OnConfigurationChanged.InvokeAsync(json);
        }
    }

    private async Task CopyClientId()
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", config.ClientId ?? "");
    }

    private async Task RegenerateClientId()
    {
        config.ClientId = Guid.NewGuid().ToString();
        await SaveConfiguration();
    }

    private string GetChartPoints(Func<MetricsSample, double> valueSelector)
    {
        if (clientMetadata?.MetricsHistory == null || clientMetadata.MetricsHistory.Count < 2)
            return "";

        var samples = clientMetadata.MetricsHistory;
        var points = new List<string>();
        var chartWidth = 350.0; // 390 - 40 (left margin)
        var chartHeight = 110.0; // 120 - 10 (top margin)
        var xOffset = 40.0;
        var yOffset = 10.0;

        for (int i = 0; i < samples.Count; i++)
        {
            var x = xOffset + (i * chartWidth / (samples.Count - 1));
            var value = Math.Min(100, Math.Max(0, valueSelector(samples[i])));
            var y = yOffset + chartHeight - (value / 100.0 * chartHeight);
            points.Add($"{x:F1},{y:F1}");
        }

        return string.Join(" ", points);
    }

    private string GetTimeRange()
    {
        if (clientMetadata?.MetricsHistory == null || clientMetadata.MetricsHistory.Count < 2)
            return "";

        var first = clientMetadata.MetricsHistory.First().Timestamp;
        var last = clientMetadata.MetricsHistory.Last().Timestamp;
        var duration = last - first;

        if (duration.TotalHours >= 1)
            return $"Last {duration.TotalHours:F1}h";
        return $"Last {duration.TotalMinutes:F0}m";
    }

    private string GetDeployUrl(string type)
    {
        var baseUri = NavigationManager.BaseUri.TrimEnd('/');
        return $"{baseUri}/api/remote-client/{type}?listenerId={selectedDeployListenerId}&clientId={config.ClientId}";
    }

    private async Task CopyLinuxOneLiner()
    {
        var url = GetDeployUrl("python");
        var cmd = $"curl -sL \"{url}\" -o remote_client.py && python3 remote_client.py";
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", cmd);
    }

    private async Task CopyWindowsOneLiner()
    {
        var url = GetDeployUrl("powershell");
        var cmd = $"iwr \"{url}\" -UseBasicParsing -OutFile RemoteClient.ps1; .\\RemoteClient.ps1";
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", cmd);
    }

    public class RemoteNodeConfig
    {
        public string? ClientId { get; set; }
        public string? Command { get; set; }
        public int TimeoutSeconds { get; set; } = 60;
        public int ExpirationMinutes { get; set; } = 5;
        public Guid? SourceListenerId { get; set; }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}

