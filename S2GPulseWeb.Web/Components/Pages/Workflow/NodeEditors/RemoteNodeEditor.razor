    }

    .deploy-section {
        padding: 12px;
        background: var(--background-dark, #1a1a2e);
        border-radius: 6px;
        margin-top: 8px;
    }

    .deploy-block {
        margin-bottom: 10px;
    }

    .deploy-block label {
        display: block;
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin-bottom: 4px;
