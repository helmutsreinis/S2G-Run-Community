        padding: 0.5rem 0;
    }

    .remote-editor .form-label {
        color: var(--text-primary, #e0e0e0);
        font-weight: 500;
    }

    .remote-editor .text-muted,
    .remote-editor small.text-muted {
        color: var(--text-secondary, #b0b0b0) !important;
    }

    .remote-editor code {
        color: var(--accent-color, #00a8a8);
        background: rgba(0, 168, 168, 0.1);
        padding: 1px 4px;
        border-radius: 3px;
        font-size: 0.85em;
    }

    .curl-summary {
        cursor: pointer;
        color: var(--accent-color, #00a8a8);
        font-weight: 500;
        padding: 8px 0;
    }

    .curl-examples {
        padding: 12px;
        background: var(--background-dark, #1a1a2e);
        border-radius: 6px;
        margin-top: 8px;
    }

    .curl-block {
        margin-bottom: 12px;
    }

    .curl-block label {
        display: block;
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin-bottom: 4px;
    }

    .curl-block code {
        display: block;
        padding: 8px;
        background: rgba(0, 0, 0, 0.3);
        border-radius: 4px;
        word-break: break-all;
        font-size: 0.75rem;
    }

    .status-section {
        padding: 12px;
        background: var(--background-dark, #1a1a2e);
        border-radius: 6px;
    }

    .status-section h6 {
        margin-bottom: 12px;
        color: var(--text-primary);
    }

    .status-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
    }

    .status-item {
        display: flex;
        flex-direction: column;
        padding: 8px;
        background: rgba(0, 0, 0, 0.2);
        border-radius: 4px;
    }

    .status-item.full-width {
        grid-column: 1 / -1;
    }

    .status-label {
        font-size: 0.7rem;
        color: var(--text-secondary);
        text-transform: uppercase;
    }

    .status-value {
        font-size: 0.9rem;
        color: var(--text-primary);
        font-weight: 500;
    }

    .status-value.online {
        color: #4caf50;
    }

    .status-value.offline {
        color: #f44336;
    }

    .output-preview {
        padding: 12px;
        background: rgba(0, 168, 168, 0.1);
        border-radius: 6px;
        border: 1px solid rgba(0, 168, 168, 0.2);
    }

    .output-preview h6 {
        margin-bottom: 8px;
        color: var(--accent-color);
    }

    .output-preview ul {
        padding-left: 1.2rem;
    }

    .output-preview li {
        color: var(--text-secondary, #b0b0b0);
    }

    .chart-summary {
        cursor: pointer;
        color: var(--accent-color, #00a8a8);
        font-weight: 500;
        padding: 8px 0;
    }

    .chart-container {
        padding: 12px;
        background: var(--background-dark, #1a1a2e);
        border-radius: 6px;
        margin-top: 8px;
    }

    .metrics-chart {
        width: 100%;
        height: 150px;
    }

    .axis-label {
        font-size: 8px;
        fill: #666;
        text-anchor: end;
    }

    .chart-legend {
        display: flex;
        gap: 16px;
        margin-top: 8px;
        font-size: 0.75rem;
        color: var(--text-secondary);
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .legend-color {
        width: 12px;
