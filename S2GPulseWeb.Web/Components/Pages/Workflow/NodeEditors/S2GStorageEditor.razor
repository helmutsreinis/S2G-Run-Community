@using System.Text.Json
@using S2GPulseWeb.Web.Logic.Nodes

<div class="node-editor-fields">
    <div class="form-group">
        <label>Operation</label>
        <select value="@config.Operation" @onchange="OnOperationChanged" class="form-control">
            <option value="List">List (Browse files and folders)</option>
            <option value="Read">Read (Download file content)</option>
            <option value="Write">Write (Upload/Create file)</option>
            <option value="Edit">Edit (Modify existing file)</option>
            <option value="Delete">Delete (Remove file)</option>
            <option value="CreateFolder">Create Folder</option>
        </select>
        <small class="text-muted">Select the storage operation to perform</small>
    </div>

    @if (config.Operation == "List" || config.Operation == "CreateFolder")
    {
        <div class="form-group">
            <label>Folder Path</label>
            <input type="text" value="@config.FolderPath" 
                   @onchange="@(e => UpdateConfig(c => c.FolderPath = e.Value?.ToString()))" 
                   class="form-control" 
                   placeholder="my-folder or my-folder/subfolder (leave empty for root)" />
            <small class="text-muted">Path to the folder. Leave empty to list root directory.</small>
        </div>
    }

    @if (config.Operation != "List" && config.Operation != "CreateFolder")
    {
        <div class="form-group">
            <label>File Path</label>
            <input type="text" value="@config.FilePath" 
                   @onchange="@(e => UpdateConfig(c => c.FilePath = e.Value?.ToString()))" 
                   class="form-control" 
                   placeholder="folder/filename.txt" />
            <small class="text-muted">Full path to the file within your storage</small>
        </div>
    }

    @if (config.Operation == "Write" || config.Operation == "Edit")
    {
        <div class="form-group">
            <label>Content (Text)</label>
            <textarea value="@config.Content" 
                      @onchange="@(e => UpdateConfig(c => c.Content = e.Value?.ToString()))" 
                      class="form-control" 
                      rows="4" 
                      placeholder="Enter text content to write to the file..."></textarea>
            <small class="text-muted">For text files (.txt, .json, .csv, etc.). Supports placeholders.</small>
        </div>

        <div class="form-group" style="background: rgba(155, 89, 182, 0.1); border: 1px solid rgba(155, 89, 182, 0.4); border-radius: 8px; padding: 12px; margin-top: 12px;">
            <label style="color: #9b59b6;">⬇️ Binary Content (Base64)</label>
            <input type="text" value="@config.ContentBase64" 
                   @onchange="@(e => UpdateConfig(c => c.ContentBase64 = e.Value?.ToString()))" 
                   class="form-control" 
                   placeholder="{{FileDownload.ContentBase64}}" />
            <small class="text-muted" style="color: #9b59b6;">
                For downloaded files (images, PDFs, ZIPs). Use with File Download node: <code>@("{{FileDownload.ContentBase64}}")</code>
                <br/>Takes precedence over Content when both are set.
            </small>
        </div>

        <S2GPulseWeb.Web.Components.Pages.Workflow.NodeEditors.PlaceholderList 
            Placeholders="@AvailablePlaceholders" />
    }

    @if (config.Operation == "Read" || config.Operation == "Edit")
    {
        <div class="form-group">
            <label>Max File Size for Read/Edit</label>
            <div class="d-flex align-items-center gap-2">
                <input type="range" min="1" max="20" step="1"
                       value="@GetMaxSizeMB()" 
                       @onchange="OnMaxSizeChanged" 
                       class="form-range flex-grow-1" 
                       style="max-width: 200px;" />
                <span class="badge bg-secondary">@FormatFileSize(config.MaxFileSizeBytes)</span>
            </div>
            <small class="text-muted">Files larger than this limit will be blocked from loading (max 20MB)</small>
        </div>
    }

    <div class="storage-info" style="background: rgba(0, 168, 168, 0.1); border: 1px solid rgba(0, 168, 168, 0.3); border-radius: 8px; padding: 12px; margin-top: 16px;">
        <div style="font-weight: 600; color: var(--text-primary); margin-bottom: 8px;">📁 Your Personal Storage</div>
        <div class="small" style="color: var(--text-secondary);">
            Files are stored in your dedicated storage space and count towards your storage quota.
            Use the 📦 button on the node to browse your files.
        </div>
    </div>

    <details class="mt-3">
        <summary style="cursor: pointer; color: var(--text-secondary);">📖 Output Placeholders</summary>
        <div class="mt-2 small" style="color: var(--text-secondary);">
            <ul class="mb-0">
                @if (config.Operation == "Read")
                {
                    <li><code>@("{NodeName.Content}")</code> - Downloaded file content as text</li>
                    <li><code>@("{NodeName.FileSize}")</code> - Size of the file in bytes</li>
                    <li><code>@("{NodeName.ContentType}")</code> - MIME type of the file</li>
                }
                else if (config.Operation == "Write" || config.Operation == "Edit")
                {
                    <li><code>@("{NodeName.BytesWritten}")</code> - Number of bytes written</li>
                }
                else if (config.Operation == "Delete")
                {
                    <li><code>@("{NodeName.Deleted}")</code> - Whether the file was deleted (true/false)</li>
                }
                else if (config.Operation == "List")
                {
                    <li><code>@("{NodeName.Files}")</code> - JSON array of file info</li>
                    <li><code>@("{NodeName.Folders}")</code> - JSON array of folder names</li>
                    <li><code>@("{NodeName.FileCount}")</code> - Number of files in folder</li>
                }
                else if (config.Operation == "CreateFolder")
                {
                    <li><code>@("{NodeName.FolderName}")</code> - Name of the created folder</li>
                }
                <li><code>@("{NodeName.FilePath}")</code> - Path of the file</li>
                <li><code>@("{NodeName.Success}")</code> - Operation success status</li>
            </ul>
        </div>
    </details>
</div>

@code {
    [Parameter] public string? Configuration { get; set; }
    [Parameter] public EventCallback<string> OnConfigurationChanged { get; set; }
    [Parameter] public List<string> AvailablePlaceholders { get; set; } = new();

    private S2GStorageConfig config = new();

    protected override void OnParametersSet()
    {
        try
        {
            config = JsonSerializer.Deserialize<S2GStorageConfig>(Configuration ?? "{}") ?? new();
        }
        catch { config = new(); }
    }

    private async Task OnOperationChanged(ChangeEventArgs e)
    {
        config.Operation = e.Value?.ToString();
        await NotifyChanged();
    }

    private async Task OnMaxSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var mb))
        {
            config.MaxFileSizeBytes = mb * 1024L * 1024L;
            await NotifyChanged();
        }
    }

    private int GetMaxSizeMB()
    {
        return (int)(config.MaxFileSizeBytes / (1024 * 1024));
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / (1024.0 * 1024.0):F1} MB";
        if (bytes >= 1024)
            return $"{bytes / 1024.0:F1} KB";
        return $"{bytes} bytes";
    }

    private async Task UpdateConfig(Action<S2GStorageConfig> action)
    {
        action(config);
        await NotifyChanged();
    }

    private async Task NotifyChanged()
    {
        await OnConfigurationChanged.InvokeAsync(JsonSerializer.Serialize(config));
    }
}
