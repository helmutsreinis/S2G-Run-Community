@page "/account/change-password"
@using Microsoft.AspNetCore.Identity
@using S2GPulseWeb.Web.Data
@using System.ComponentModel.DataAnnotations
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Change Password - @PlatformSettings.SiteName</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <h2><span class="grayscale-icon">🔑</span> Change Password</h2>
        <p class="subtitle">Update your account password</p>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="alert @(isSuccess ? "alert-success" : "alert-danger")">
                @statusMessage
            </div>
        }

        <EditForm Model="@passwordModel" OnValidSubmit="HandleChangePassword" FormName="changepassword">
            <DataAnnotationsValidator />
            
            <div class="form-group">
                <label>Current Password</label>
                <InputText type="password" @bind-Value="passwordModel.CurrentPassword" class="form-control" placeholder="Enter current password" />
                <ValidationMessage For="@(() => passwordModel.CurrentPassword)" />
            </div>
            
            <div class="form-group">
                <label>New Password</label>
                <InputText type="password" @bind-Value="passwordModel.NewPassword" class="form-control" placeholder="Enter new password" />
                <ValidationMessage For="@(() => passwordModel.NewPassword)" />
            </div>
            
            <div class="form-group">
                <label>Confirm New Password</label>
                <InputText type="password" @bind-Value="passwordModel.ConfirmPassword" class="form-control" placeholder="Confirm new password" />
                <ValidationMessage For="@(() => passwordModel.ConfirmPassword)" />
            </div>
            
            <button type="submit" class="btn btn-primary btn-block" disabled="@isLoading">
                @if (isLoading)
                {
                    <span>Updating...</span>
                }
                else
                {
                    <span><span class="grayscale-icon">🔐</span> Update Password</span>
                }
            </button>
        </EditForm>

        <div class="auth-links">
            <a href="account/profile">← Back to Profile</a>
        </div>
    </div>
</div>

@code {
    private PasswordModel passwordModel = new();
    private string? statusMessage;
    private bool isSuccess;
    private bool isLoading;

    private async Task HandleChangePassword()
    {
        isLoading = true;
        statusMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);
            
            if (user == null)
            {
                NavigationManager.NavigateTo("/account/login");
                return;
            }

            if (passwordModel.NewPassword != passwordModel.ConfirmPassword)
            {
                statusMessage = "New password and confirmation do not match.";
                isSuccess = false;
                return;
            }

            var result = await UserManager.ChangePasswordAsync(
                user, 
                passwordModel.CurrentPassword, 
                passwordModel.NewPassword);

            if (result.Succeeded)
            {
                statusMessage = "Password changed successfully!";
                isSuccess = true;
                passwordModel = new PasswordModel();
            }
            else
            {
                statusMessage = string.Join(", ", result.Errors.Select(e => e.Description));
                isSuccess = false;
            }
        }
        catch (Exception)
        {
            statusMessage = "An error occurred while changing password.";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private class PasswordModel
    {
        [Required(ErrorMessage = "Current password is required")]
        public string CurrentPassword { get; set; } = "";

        [Required(ErrorMessage = "New password is required")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Please confirm your new password")]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = "";
    }
}

<style>
    .grayscale-icon {
        filter: grayscale(100%) brightness(1.3);
    }
</style>
