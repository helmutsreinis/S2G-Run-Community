@page "/account/manage-2fa"
@using Microsoft.AspNetCore.Identity
@using S2GPulseWeb.Web.Data
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>2FA Settings - @PlatformSettings.SiteName</PageTitle>

<div class="auth-container">
    <div class="auth-card twofa-card">
        <h2><span class="grayscale-icon">🔐</span> Two-Factor Authentication</h2>
        
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="alert @(isSuccess ? "alert-success" : "alert-danger")">
                @statusMessage
            </div>
        }

        @if (user != null)
        {
            <div class="twofa-status">
                <div class="status-indicator @(is2FAEnabled ? "enabled" : "disabled")">
                    @if (is2FAEnabled)
                    {
                        <span class="status-icon">✓</span>
                        <span>2FA is Enabled</span>
                    }
                    else
                    {
                        <span class="status-icon">✗</span>
                        <span>2FA is Disabled</span>
                    }
                </div>
            </div>

            @if (is2FAEnabled)
            {
                <div class="twofa-section">
                    <p class="section-description">
                        Two-factor authentication adds an extra layer of security to your account.
                        When enabled, you'll need to enter a code from your authenticator app when signing in.
                    </p>
                    
                    <div class="action-buttons">
                        @if (!showDisableConfirm)
                        {
                            <button class="btn btn-danger" @onclick="ShowDisableConfirmation" disabled="@isLoading">
                                <span><span class="grayscale-icon">🚫</span> Disable 2FA</span>
                            </button>
                        }
                        else
                        {
                            <div class="disable-confirm-section">
                                <p class="warning-text">Enter your current password to confirm disabling 2FA:</p>
                                <div class="form-group">
                                    <input type="password" class="form-control" @bind="confirmPassword" placeholder="Current password" />
                                </div>
                                <div class="confirm-buttons">
                                    <button class="btn btn-danger" @onclick="Disable2FA" disabled="@isLoading">
                                        @if (isLoading) { <span>Processing...</span> } else { <span>Confirm Disable</span> }
                                    </button>
                                    <button class="btn btn-secondary" @onclick="CancelDisable" disabled="@isLoading">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        
                        <button class="btn btn-secondary" @onclick="ResetRecoveryCodes" disabled="@isLoading">
                            <span class="grayscale-icon">🔄</span> Reset Recovery Codes
                        </button>
                    </div>
                    
                    @if (recoveryCodes != null && recoveryCodes.Any())
                    {
                        <div class="recovery-codes-section">
                            <h3><span class="grayscale-icon">⚠️</span> New Recovery Codes</h3>
                            <p class="warning-text">
                                Save these codes in a secure location. Each code can only be used once.
                            </p>
                            <div class="recovery-codes">
                                @foreach (var recoveryCode in recoveryCodes)
                                {
                                    <span class="recovery-code">@recoveryCode</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="twofa-section">
                    <p class="section-description">
                        Protect your account by enabling two-factor authentication.
                        You'll need an authenticator app like Google Authenticator, Authy, or Microsoft Authenticator.
                    </p>
                    
                    <a href="account/setup-2fa" class="btn btn-primary btn-block">
                        <span class="grayscale-icon">🔐</span> Set Up 2FA
                    </a>
                </div>
            }
        }
        else
        {
            <div class="text-center p-4">
                <p>Loading...</p>
            </div>
        }

        <div class="auth-links">
            <a href="account/profile">← Back to Profile</a>
        </div>
    </div>
</div>

@code {
    private ApplicationUser? user;
    private bool is2FAEnabled;
    private string? statusMessage;
    private bool isSuccess;
    private bool isLoading;
    private IEnumerable<string>? recoveryCodes;
    private bool showDisableConfirm;
    private string? confirmPassword;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        user = await UserManager.GetUserAsync(authState.User);
        
        if (user == null)
        {
            NavigationManager.NavigateTo("/account/login");
            return;
        }

        is2FAEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
    }

    private void ShowDisableConfirmation()
    {
        showDisableConfirm = true;
        statusMessage = null;
    }

    private void CancelDisable()
    {
        showDisableConfirm = false;
        confirmPassword = null;
        statusMessage = null;
    }

    private async Task Disable2FA()
    {
        if (user == null) return;
        
        isLoading = true;
        statusMessage = null;
        recoveryCodes = null;

        try
        {
            // Security: Verify password before allowing 2FA disable
            if (string.IsNullOrEmpty(confirmPassword))
            {
                statusMessage = "Please enter your current password.";
                isSuccess = false;
                isLoading = false;
                return;
            }

            var passwordValid = await UserManager.CheckPasswordAsync(user, confirmPassword);
            if (!passwordValid)
            {
                statusMessage = "Incorrect password. Please try again.";
                isSuccess = false;
                isLoading = false;
                return;
            }

            var result = await UserManager.SetTwoFactorEnabledAsync(user, false);
            
            if (result.Succeeded)
            {
                // Reset authenticator key
                await UserManager.ResetAuthenticatorKeyAsync(user);
                
                is2FAEnabled = false;
                showDisableConfirm = false;
                confirmPassword = null;
                statusMessage = "Two-factor authentication has been disabled.";
                isSuccess = true;
            }
            else
            {
                statusMessage = string.Join(", ", result.Errors.Select(e => e.Description));
                isSuccess = false;
            }
        }
        catch (Exception)
        {
            statusMessage = "An error occurred while disabling 2FA.";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ResetRecoveryCodes()
    {
        if (user == null) return;
        
        isLoading = true;
        statusMessage = null;

        try
        {
            recoveryCodes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(user, 10);
            statusMessage = "New recovery codes have been generated. Save them now!";
            isSuccess = true;
        }
        catch (Exception)
        {
            statusMessage = "An error occurred while generating recovery codes.";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }
}

<style>
    .grayscale-icon {
        filter: grayscale(100%) brightness(1.3);
    }

    .twofa-card {
        max-width: 520px;
    }

    .twofa-status {
        margin-bottom: 1.5rem;
    }

    .status-indicator {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 1rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1.1rem;
    }

    .status-indicator.enabled {
        background: rgba(38, 176, 80, 0.15);
        color: var(--success-color);
        border: 1px solid var(--success-color);
    }

    .status-indicator.disabled {
        background: var(--background-medium);
        color: var(--text-secondary);
        border: 1px solid var(--border-color);
    }

    .status-icon {
        font-size: 1.5rem;
    }

    .twofa-section {
        margin-top: 1.5rem;
    }

    .section-description {
        color: var(--text-secondary);
        font-size: 0.9rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }

    .action-buttons {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .action-buttons .btn {
        flex: 1;
        min-width: 150px;
    }

    .recovery-codes-section {
        margin-top: 2rem;
        padding: 1.25rem;
        background: rgba(245, 166, 35, 0.1);
        border: 1px solid var(--warning-color);
        border-radius: 8px;
    }

    .recovery-codes-section h3 {
        color: var(--warning-color);
        font-size: 1rem;
        margin: 0 0 0.5rem 0;
    }

    .warning-text {
        color: var(--text-secondary);
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .recovery-codes {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.5rem;
    }

    .recovery-code {
        background: var(--background-dark);
        padding: 0.5rem;
        border-radius: 4px;
        font-family: monospace;
        font-size: 0.9rem;
        color: var(--accent-color);
        text-align: center;
    }

    .btn-danger {
        background: rgba(180, 80, 80, 0.2);
        border-color: rgba(180, 80, 80, 0.4);
        color: #e55;
    }

    .btn-danger:hover {
        background: rgba(180, 80, 80, 0.3);
        color: #ff6666;
    }
</style>
