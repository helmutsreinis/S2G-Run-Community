@page "/account/profile"
@using Microsoft.AspNetCore.Identity
@using S2GPulseWeb.Web.Data
@using S2GPulseWeb.Web.Logic
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject SubscriptionService SubscriptionService
@inject MembershipPlanService MembershipPlanService
@inject UsageTrackingService UsageTrackingService
@inject StripeService StripeService
@inject NodeLogService NodeLogService
@inject VectorDbService VectorDbService
@inject StorageTableService StorageTableService
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Profile - @PlatformSettings.SiteName</PageTitle>

<div class="auth-container">
    <div class="auth-card profile-card">
        <h2><span class="grayscale-icon">👤</span> My Profile</h2>
        
        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="alert @(isSuccess ? "alert-success" : "alert-danger")">
                @statusMessage
            </div>
        }

        @if (user != null)
        {
            <!-- Subscription Section -->
            <div class="subscription-section">
                <div class="subscription-header">
                    <div class="tier-display">
                        @if (currentPlan != null)
                        {
                            <span class="tier-badge" style="@GetPlanBadgeStyle(currentPlan)">
                                @if (!string.IsNullOrEmpty(currentPlan.SvgIcon))
                                {
                                    @((MarkupString)currentPlan.SvgIcon)
                                }
                                <span>@currentPlan.Name</span>
                            </span>
                        }
                        else
                        {
                            <span class="tier-badge tier-@currentTier.ToString().ToLower()">
                                @(currentTier == SubscriptionTier.Free ? "Free" : "⭐ Starter")
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(subscriptionStatus))
                        {
                            <span class="tier-status status-@subscription?.Status">@subscriptionStatus</span>
                        }
                    </div>
                    @if (currentPlan?.IsFree == true || currentTier == SubscriptionTier.Free)
                    {
                        <button class="btn btn-upgrade" @onclick="TogglePlanSelector" disabled="@isUpgrading">
                            ⬆️ Upgrade
                        </button>
                    }
                    else if (!string.IsNullOrEmpty(subscription?.StripeCustomerId))
                    {
                        <div class="btn-group">
                            <button class="btn btn-outline btn-sm" @onclick="TogglePlanSelector" disabled="@isUpgrading">
                                📊 Change Plan
                            </button>
                            <button class="btn btn-outline" @onclick="ManageSubscriptionNewTab" disabled="@isUpgrading">
                                ⚙️ Billing
                            </button>
                        </div>
                    }
                </div>
                
                @* Plan Selection Panel *@
                @if (showPlanSelector && availablePlans != null)
                {
                    <div class="plan-selector-panel">
                        <div class="plans-grid-mini">
                            @foreach (var plan in availablePlans.Where(p => p.IsActive && !p.IsContactSales))
                            {
                                var isCurrentPlan = currentPlan?.Id == plan.Id || (plan.IsFree && currentPlan == null && currentTier == SubscriptionTier.Free);
                                <div class="plan-option @(isCurrentPlan ? "current" : "") @(selectedPlanId == plan.Id ? "selected" : "")"
                                     @onclick="() => SelectPlan(plan)">
                                    <div class="plan-option-header">
                                        <span class="plan-name">@plan.Name</span>
                                        @if (isCurrentPlan)
                                        {
                                            <span class="current-badge">Current</span>
                                        }
                                    </div>
                                    <div class="plan-price-mini">
                                        @if (plan.IsFree)
                                        {
                                            <span>€0/mo</span>
                                        }
                                        else
                                        {
                                            <span>€@plan.MonthlyPrice/mo</span>
                                        }
                                    </div>
                                    <ul class="plan-features-mini">
                                        <li>@FormatQuota(plan.MaxExecutionsPerMonth) exec/mo</li>
                                        <li>@FormatBytesShort(plan.MaxStorageBytes) storage</li>
                                        <li>@FormatQuota(plan.MaxWorkflows) workflows</li>
                                    </ul>
                                </div>
                            }
                        </div>
                        <div class="plan-selector-actions">
                            <button class="btn btn-sm btn-secondary" @onclick="TogglePlanSelector">Cancel</button>
                            @if (selectedPlanId.HasValue && !IsCurrentPlanSelected())
                            {
                                <button class="btn btn-sm btn-primary" @onclick="UpgradeToPlan" disabled="@isUpgrading">
                                    @(isUpgrading ? "Processing..." : "Confirm Upgrade")
                                </button>
                            }
                        </div>
                        <a href="/pricing" class="view-all-plans">View all plan details →</a>
                    </div>
                }

                <!-- Subscription Period Info -->
                @if (currentTier != SubscriptionTier.Free && subscription != null)
                {
                    <div class="subscription-details">
                        @if (subscription.CancelAtPeriodEnd)
                        {
                            <div class="subscription-notice warning">
                                <span class="notice-icon">⚠️</span>
                                <span>Subscription will end on @subscription.CurrentPeriodEnd?.ToLocalTime().ToString("MMMM dd, yyyy")</span>
                            </div>
                        }
                        else if (subscription.Status == "canceled")
                        {
                            <div class="subscription-notice warning">
                                <span class="notice-icon">❌</span>
                                <span>Subscription canceled</span>
                            </div>
                        }
                        else if (subscription.CurrentPeriodEnd.HasValue)
                        {
                            <div class="subscription-notice">
                                <span class="notice-icon">🔄</span>
                                <span>Renews on @subscription.CurrentPeriodEnd?.ToLocalTime().ToString("MMMM dd, yyyy")</span>
                            </div>
                        }
                    </div>
                }

                <!-- Usage Bars -->
                @if (usagePercentages != null)
                {
                    <div class="usage-section">
                        <div class="usage-item">
                            <div class="usage-label">
                                <span>Executions</span>
                                <span class="usage-count">@FormatNumber(usagePercentages.ExecutionsUsed) / @FormatNumber(usagePercentages.ExecutionsLimit)</span>
                            </div>
                            <div class="usage-bar">
                                <div class="usage-fill @(usagePercentages.ExecutionsPercent > 80 ? "warning" : "")" 
                                     style="width: @usagePercentages.ExecutionsPercent%"></div>
                            </div>
                        </div>
                        <div class="usage-item">
                            <div class="usage-label">
                                <span>Storage</span>
                                <span class="usage-count">@FormatBytes(usagePercentages.StorageUsed) / @FormatBytes(usagePercentages.StorageLimit)</span>
                            </div>
                            <div class="usage-bar">
                                <div class="usage-fill @(usagePercentages.StoragePercent > 80 ? "warning" : "")" 
                                     style="width: @usagePercentages.StoragePercent%"></div>
                            </div>
                            @if (usagePercentages.StorageUsed > 0)
                            {
                                <button class="btn btn-sm btn-outline-danger mt-1" 
                                        @onclick="ToggleClearStorageConfirm"
                                        disabled="@isClearingStorage">
                                    @if (showClearStorageConfirm)
                                    {
                                        <span>Cancel</span>
                                    }
                                    else if (isClearingStorage)
                                    {
                                        <span>Clearing...</span>
                                    }
                                    else
                                    {
                                        <span>🗑️ Clear Storage</span>
                                    }
                                </button>
                                @if (showClearStorageConfirm)
                                {
                                    <div class="clear-options-panel">
                                        <div class="storage-options-row">
                                            <label class="checkbox-label">
                                                <input type="checkbox" @bind="clearLogs" />
                                                <span>📋 Logs</span>
                                            </label>
                                            <label class="checkbox-label">
                                                <input type="checkbox" @bind="clearVectors" />
                                                <span>🧠 Vectors</span>
                                            </label>
                                            <label class="checkbox-label">
                                                <input type="checkbox" @bind="clearTables" />
                                                <span>📊 Tables</span>
                                            </label>
                                        </div>
                                        <button class="btn btn-sm btn-danger" 
                                                @onclick="ClearMyStorage"
                                                disabled="@(!clearLogs && !clearVectors && !clearTables)">
                                            Delete Selected
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                        <div class="usage-item">
                            <div class="usage-label">
                                <span>Vector Docs</span>
                                <span class="usage-count">@FormatNumber(usagePercentages.VectorDocsUsed) / @(usagePercentages.VectorDocsLimit < 0 ? "∞" : FormatNumber(usagePercentages.VectorDocsLimit))</span>
                            </div>
                            <div class="usage-bar">
                                <div class="usage-fill @(usagePercentages.VectorDocsPercent > 80 ? "warning" : "")" 
                                     style="width: @(usagePercentages.VectorDocsLimit < 0 ? 0 : usagePercentages.VectorDocsPercent)%"></div>
                            </div>
                        </div>
                        <div class="usage-item">
                            <div class="usage-label">
                                <span>Workflows</span>
                                <span class="usage-count">@FormatNumber(usagePercentages.WorkflowsUsed) / @(usagePercentages.WorkflowsLimit < 0 ? "∞" : FormatNumber(usagePercentages.WorkflowsLimit))</span>
                            </div>
                            <div class="usage-bar">
                                <div class="usage-fill @(usagePercentages.WorkflowsPercent > 80 ? "warning" : "")" 
                                     style="width: @(usagePercentages.WorkflowsLimit < 0 ? 0 : usagePercentages.WorkflowsPercent)%"></div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <hr class="divider" />

            <div class="profile-info">
                <div class="info-row">
                    <label>Email</label>
                    <span class="info-value">@user.Email</span>
                </div>
                <div class="info-row">
                    <label>Member Since</label>
                    <span class="info-value">@user.CreatedAt.ToLocalTime().ToString("MMMM dd, yyyy")</span>
                </div>
                <div class="info-row">
                    <label>Last Login</label>
                    <span class="info-value">@(user.LastLoginAt?.ToLocalTime().ToString("MMM dd, yyyy HH:mm") ?? "Never")</span>
                </div>
                <div class="info-row">
                    <label>2FA Status</label>
                    <span class="info-value @(is2FAEnabled ? "enabled" : "disabled")">
                        @(is2FAEnabled ? "✓ Enabled" : "✗ Disabled")
                    </span>
                </div>
            </div>

            <hr class="divider" />

            <h3>Edit Profile</h3>
            <EditForm Model="@profileModel" OnValidSubmit="UpdateProfile" FormName="profile">
                <DataAnnotationsValidator />
                
                <div class="form-group">
                    <label>First Name</label>
                    <InputText @bind-Value="profileModel.FirstName" class="form-control" placeholder="Enter first name" />
                </div>
                
                <div class="form-group">
                    <label>Last Name</label>
                    <InputText @bind-Value="profileModel.LastName" class="form-control" placeholder="Enter last name" />
                </div>
                
                <button type="submit" class="btn btn-primary btn-block" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span><span class="grayscale-icon">💾</span> Save Changes</span>
                    }
                </button>
            </EditForm>
        }
        else
        {
            <div class="text-center p-4">
                <p>Loading profile...</p>
            </div>
        }

        <div class="profile-links">
            <a href="account/change-password"><span class="grayscale-icon">🔑</span> Change Password</a>
            <a href="account/manage-2fa"><span class="grayscale-icon">🔐</span> 2FA Settings</a>
        </div>
    </div>
</div>

@code {
    private ApplicationUser? user;
    private ProfileModel profileModel = new();
    private string? statusMessage;
    private bool isSuccess;
    private bool isLoading;
    private bool is2FAEnabled;
    private bool isUpgrading;
    
    // Subscription data
    private UserSubscription? subscription;
    private MembershipPlan? currentPlan;
    private List<MembershipPlan>? availablePlans;
    private SubscriptionTier currentTier = SubscriptionTier.Free;
    private string subscriptionStatus = "";
    private UsagePercentages? usagePercentages;
    private bool showPlanSelector = false;
    private int? selectedPlanId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        user = await UserManager.GetUserAsync(authState.User);
        
        if (user == null)
        {
            NavigationManager.NavigateTo("/account/login");
            return;
        }

        is2FAEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        
        profileModel.FirstName = user.FirstName ?? "";
        profileModel.LastName = user.LastName ?? "";
        
        // Load subscription data
        await LoadSubscriptionDataAsync();
    }

    private async Task LoadSubscriptionDataAsync()
    {
        if (user == null) return;
        
        subscription = await SubscriptionService.EnsureSubscriptionAsync(user.Id);
        #pragma warning disable CS0618
        currentTier = subscription.Tier;
        #pragma warning restore CS0618
        subscriptionStatus = subscription.Status switch
        {
            "free" => "",
            "active" => "Active",
            "canceled" => "Canceled",
            "past_due" => "Past Due",
            _ => subscription.Status
        };
        
        // Load current membership plan
        currentPlan = await SubscriptionService.GetUserPlanAsync(user.Id);
        
        // Load available plans
        availablePlans = await MembershipPlanService.GetAllPlansAsync(includeInactive: false);
        
        usagePercentages = await UsageTrackingService.GetUsagePercentagesAsync(user.Id);
    }

    private async Task UpdateProfile()
    {
        if (user == null) return;
        
        isLoading = true;
        statusMessage = null;

        try
        {
            user.FirstName = profileModel.FirstName;
            user.LastName = profileModel.LastName;
            
            var result = await UserManager.UpdateAsync(user);
            
            if (result.Succeeded)
            {
                statusMessage = "Profile updated successfully!";
                isSuccess = true;
            }
            else
            {
                statusMessage = string.Join(", ", result.Errors.Select(e => e.Description));
                isSuccess = false;
            }
        }
        catch (Exception)
        {
            statusMessage = "An error occurred while updating profile.";
            isSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpgradeToStarter()
    {
        if (user == null) return;
        
        isUpgrading = true;
        try
        {
            var successUrl = NavigationManager.ToAbsoluteUri("/account/profile").ToString();
            var cancelUrl = NavigationManager.ToAbsoluteUri("/account/profile").ToString();
            
            #pragma warning disable CS0618
            var checkoutUrl = await StripeService.CreateCheckoutSessionAsync(user.Id, successUrl, cancelUrl);
            #pragma warning restore CS0618
            NavigationManager.NavigateTo(checkoutUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            statusMessage = $"Unable to start upgrade: {ex.Message}";
            isSuccess = false;
            isUpgrading = false;
        }
    }
    
    private void TogglePlanSelector()
    {
        showPlanSelector = !showPlanSelector;
        if (showPlanSelector)
        {
            selectedPlanId = currentPlan?.Id;
        }
    }
    
    private void SelectPlan(MembershipPlan plan)
    {
        selectedPlanId = plan.Id;
    }
    
    private bool IsCurrentPlanSelected()
    {
        if (currentPlan == null)
        {
            // User is on Free (no plan) - check if selected plan is Free
            var selectedPlan = availablePlans?.FirstOrDefault(p => p.Id == selectedPlanId);
            return selectedPlan?.IsFree == true;
        }
        return selectedPlanId == currentPlan.Id;
    }
    
    private async Task UpgradeToPlan()
    {
        if (user == null || !selectedPlanId.HasValue) return;
        
        var selectedPlan = availablePlans?.FirstOrDefault(p => p.Id == selectedPlanId);
        if (selectedPlan == null) return;
        
        // If selecting free plan, need different flow (downgrade via portal)
        if (selectedPlan.IsFree)
        {
            statusMessage = "To downgrade to Free, please cancel your subscription via Billing.";
            isSuccess = false;
            return;
        }
        
        isUpgrading = true;
        try
        {
            var successUrl = NavigationManager.ToAbsoluteUri("/account/profile").ToString();
            var cancelUrl = NavigationManager.ToAbsoluteUri("/account/profile").ToString();
            
            var checkoutUrl = await StripeService.CreateCheckoutSessionAsync(user.Id, selectedPlan.Id, successUrl, cancelUrl);
            NavigationManager.NavigateTo(checkoutUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            statusMessage = $"Unable to start upgrade: {ex.Message}";
            isSuccess = false;
            isUpgrading = false;
            showPlanSelector = false;
        }
    }
    
    private string GetPlanBadgeStyle(MembershipPlan plan)
    {
        return $"background: linear-gradient(135deg, {plan.BadgeColorGradientStart ?? "#667eea"}, {plan.BadgeColorGradientEnd ?? "#764ba2"}); " +
               $"color: {plan.BadgeTextColor ?? "#fff"}; " +
               $"border: 1px solid {plan.BadgeBorderColor ?? "#667eea"};";
    }
    
    private string FormatQuota(int value)
    {
        if (value < 0) return "∞";
        if (value >= 1_000_000) return $"{value / 1_000_000.0:F0}M";
        if (value >= 1_000) return $"{value / 1_000.0:F0}K";
        return value.ToString();
    }
    
    private string FormatBytesShort(long bytes)
    {
        if (bytes < 0) return "∞";
        if (bytes < 1024 * 1024) return $"{bytes / 1024}KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024 * 1024)}MB";
        return $"{bytes / (1024 * 1024 * 1024)}GB";
    }

    private async Task ManageSubscription()
    {
        if (user == null) return;
        
        isUpgrading = true;
        try
        {
            var returnUrl = NavigationManager.ToAbsoluteUri("/account/profile").ToString();
            var portalUrl = await StripeService.CreateCustomerPortalSessionAsync(user.Id, returnUrl);
            NavigationManager.NavigateTo(portalUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            statusMessage = $"Unable to open subscription portal: {ex.Message}";
            isSuccess = false;
            isUpgrading = false;
        }
    }

    private async Task ManageSubscriptionNewTab()
    {
        if (user == null) return;
        
        isUpgrading = true;
        try
        {
            var returnUrl = NavigationManager.ToAbsoluteUri("/account/profile").ToString();
            var portalUrl = await StripeService.CreateCustomerPortalSessionAsync(user.Id, returnUrl);
            await JSRuntime.InvokeVoidAsync("open", portalUrl, "_blank");
            isUpgrading = false;
        }
        catch (Exception ex)
        {
            statusMessage = $"Unable to open subscription portal: {ex.Message}";
            isSuccess = false;
            isUpgrading = false;
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F1} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F2} GB";
    }

    private static string FormatNumber(int number)
    {
        if (number >= 1_000_000) return $"{number / 1_000_000.0:F1}M";
        if (number >= 1_000) return $"{number / 1_000.0:F1}K";
        return number.ToString("N0");
    }
    
    // Storage cleanup state
    private bool showClearStorageConfirm = false;
    private bool isClearingStorage = false;
    
    private void ToggleClearStorageConfirm()
    {
        showClearStorageConfirm = !showClearStorageConfirm;
    }
    
    // Storage type selection
    private bool clearLogs = true;
    private bool clearVectors = true;
    private bool clearTables = true;
    
    private async Task ClearMyStorage()
    {
        if (user == null) return;
        
        isClearingStorage = true;
        showClearStorageConfirm = false;
        
        try
        {
            // Clear only selected types
            if (clearLogs)
                await NodeLogService.ClearLogsAsync(user.Id);
            if (clearVectors)
                await VectorDbService.ClearAllForUserAsync(user.Id);
            if (clearTables)
                await StorageTableService.ClearAllForUserAsync(user.Id);
            
            // Reload usage data
            usagePercentages = await UsageTrackingService.GetUsagePercentagesAsync(user.Id);
            
            // Build result message
            var clearedTypes = new List<string>();
            if (clearLogs) clearedTypes.Add("logs");
            if (clearVectors) clearedTypes.Add("vectors");
            if (clearTables) clearedTypes.Add("tables");
            statusMessage = $"Cleared: {string.Join(", ", clearedTypes)}";
            isSuccess = true;
            
            // Reset checkboxes
            clearLogs = true;
            clearVectors = true;
            clearTables = true;
        }
        catch (Exception ex)
        {
            statusMessage = $"Error clearing storage: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isClearingStorage = false;
        }
    }

    private class ProfileModel
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
    }
}

<style>
    .grayscale-icon {
        filter: grayscale(100%) brightness(1.3);
    }

    .profile-card {
        max-width: 520px;
    }

    .profile-card h3 {
        font-size: 1rem;
        color: var(--text-secondary);
        margin: 1.5rem 0 1rem;
        font-weight: 500;
    }

    /* Subscription Section */
    .subscription-section {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
        border: 1px solid rgba(102, 126, 234, 0.2);
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1rem;
    }

    .subscription-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .tier-display {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .tier-badge {
        padding: 0.35rem 0.85rem;
        border-radius: 16px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .tier-free {
        background: rgba(100, 100, 100, 0.3);
        color: #bbb;
    }

    .tier-starter {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
    }

    .tier-status {
        color: #888;
        font-size: 0.85rem;
    }

    .tier-status.status-active {
        color: #2ecc71;
    }

    .tier-status.status-canceled,
    .tier-status.status-canceling {
        color: #f39c12;
    }

    .tier-status.status-past_due {
        color: #e74c3c;
    }

    .subscription-details {
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .subscription-notice {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: #aaa;
    }

    .subscription-notice.warning {
        color: #f39c12;
    }

    .notice-icon {
        font-size: 1rem;
    }

    .btn-upgrade {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: #fff;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 500;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-upgrade:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
    }

    .btn-outline {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #bbb;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        cursor: pointer;
    }

    /* Usage Section */
    .usage-section {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .usage-item {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .usage-label {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        color: #aaa;
    }

    .usage-count {
        color: #888;
    }

    .usage-bar {
        height: 6px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 3px;
        overflow: hidden;
    }

    .usage-fill {
        height: 100%;
        background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        border-radius: 3px;
        transition: width 0.3s ease;
    }

    .usage-fill.warning {
        background: linear-gradient(90deg, #f39c12 0%, #e74c3c 100%);
    }

    .profile-info {
        background: var(--background-medium);
        border-radius: 8px;
        padding: 1rem;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--border-color);
    }

