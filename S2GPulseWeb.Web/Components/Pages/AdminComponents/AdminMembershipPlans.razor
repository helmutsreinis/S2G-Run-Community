        max-height: 16px;
        flex-shrink: 0;
    }
    
    .plan-badge.preview {
        margin-top: 0.5rem;
    }
    
    .plan-status {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }
    
    .plan-description {
        color: #aaa;
        font-size: 0.9rem;
