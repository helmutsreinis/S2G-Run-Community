@using S2GPulseWeb.Web.Data
@using S2GPulseWeb.Web.Logic
@inject MembershipPlanService MembershipPlanService

<div class="plans-manager">
    <div class="section-header">
        <h3>💳 Membership Plans</h3>
        <button class="btn btn-primary" @onclick="OpenCreateModal">➕ New Plan</button>
    </div>

    @if (isLoading)
    {
        <p class="loading-text">Loading plans...</p>
    }
    else if (plans == null || !plans.Any())
    {
        <p class="empty-text">No membership plans configured. Click "New Plan" to create one.</p>
    }
    else
    {
        <div class="plans-grid">
            @foreach (var plan in plans.OrderBy(p => p.DisplayOrder))
            {
                <div class="plan-card @(plan.IsActive ? "" : "inactive")">
                    <div class="plan-header">
                        <div class="plan-badge" style="@GetBadgeStyle(plan)">
                            @if (!string.IsNullOrEmpty(plan.SvgIcon))
                            {
                                @((MarkupString)plan.SvgIcon)
                            }
                            <span>@plan.Name</span>
                        </div>
                        <div class="plan-status">
                            @if (plan.IsFree)
                            {
                                <span class="badge badge-info">Free</span>
                            }
                            else if (plan.IsContactSales)
                            {
                                <span class="badge badge-warning">Contact Sales</span>
                            }
                            else
                            {
                                <span class="badge badge-success">€@plan.MonthlyPrice/mo</span>
                            }
                            @if (!plan.IsActive)
                            {
                                <span class="badge badge-secondary">Inactive</span>
                            }
                        </div>
                    </div>
                    
                    <p class="plan-description">@plan.Description</p>
                    
                    <div class="plan-quotas">
                        <div class="quota-item">
                            <span class="quota-label">Executions</span>
                            <span class="quota-value">@FormatNumber(plan.MaxExecutionsPerMonth)/mo</span>
                        </div>
                        <div class="quota-item">
                            <span class="quota-label">Storage</span>
                            <span class="quota-value">@FormatBytes(plan.MaxStorageBytes)</span>
                        </div>
                        <div class="quota-item">
                            <span class="quota-label">Workflows</span>
                            <span class="quota-value">@FormatLimit(plan.MaxWorkflows)</span>
                        </div>
                        <div class="quota-item">
                            <span class="quota-label">Nodes/WF</span>
                            <span class="quota-value">@FormatLimit(plan.MaxNodesPerWorkflow)</span>
                        </div>
                        <div class="quota-item">
                            <span class="quota-label">Vector Docs</span>
                            <span class="quota-value">@FormatLimit(plan.MaxVectorDocs)</span>
                        </div>
                        <div class="quota-item">
                            <span class="quota-label">Log Retention</span>
                            <span class="quota-value">@FormatHours(plan.LogRetentionHours)</span>
                        </div>
                    </div>
                    
                    <div class="plan-features">
                        <span class="feature @(plan.CanImportExport ? "enabled" : "disabled")">
                            @(plan.CanImportExport ? "✓" : "✗") Import/Export
                        </span>
                        <span class="feature @(plan.CanUseScheduling ? "enabled" : "disabled")">
                            @(plan.CanUseScheduling ? "✓" : "✗") Scheduling
                        </span>
                        <span class="feature">
                            📡 @FormatLimit(plan.MaxHttpListeners) Listeners
                        </span>
                        @if (plan.MaxOrganizations > 0)
                        {
                            <span class="feature enabled">
                                🏢 @FormatLimit(plan.MaxOrganizations) Orgs
                            </span>
                        }
                    </div>

                    @if (plan.MaxOrganizations > 0)
                    {
                        <div class="org-quotas">
                            <div class="org-quota-header">🏢 Organization Limits</div>
                            <div class="quota-item">
                                <span class="quota-label">Members/Org</span>
                                <span class="quota-value">@FormatLimit(plan.MaxMembersPerOrganization)</span>
                            </div>
                            <div class="quota-item">
                                <span class="quota-label">Workflows/Org</span>
                                <span class="quota-value">@FormatLimit(plan.MaxWorkflowsPerOrganization)</span>
                            </div>
                            <div class="quota-item">
                                <span class="quota-label">Org Executions</span>
                                <span class="quota-value">@FormatNumber(plan.MaxOrgExecutionsPerMonth)/mo</span>
                            </div>
                            <div class="quota-item">
                                <span class="quota-label">Org Storage</span>
                                <span class="quota-value">@FormatBytes(plan.MaxOrgStorageBytes)</span>
                            </div>
                        </div>
                    }

                    @if (plan.MaxPaidMembers.HasValue)
                    {
                        <div class="member-limit">
                            <span>Member Limit: @plan.MaxPaidMembers.Value</span>
                        </div>
                    }
                    
                    <div class="plan-actions">
                        <button class="btn btn-sm btn-secondary" @onclick="() => OpenEditModal(plan)">✏️ Edit</button>
                        @if (plan.IsActive)
                        {
                            <button class="btn btn-sm btn-danger" @onclick="() => DeactivatePlan(plan)">🗑️ Deactivate</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => ActivatePlan(plan)">✓ Activate</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content plan-modal" @onclick:stopPropagation="true">
            <h3>@(editingPlan?.Id > 0 ? "Edit Plan" : "Create Plan")</h3>
            
            <div class="form-grid">
                <div class="form-group">
                    <label>Name *</label>
                    <input type="text" class="form-control" @bind="editingPlan!.Name" placeholder="e.g. Pro" />
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <input type="text" class="form-control" @bind="editingPlan!.Description" placeholder="Short tagline" />
                </div>
                <div class="form-group full-width">
                    <label>Detailed Description (HTML)</label>
                    <textarea class="form-control" rows="3" @bind="editingPlan!.DetailedDescription" placeholder="Features list for pricing page"></textarea>
                </div>
                
                <div class="form-group">
                    <label>Monthly Price (€)</label>
                    <input type="number" class="form-control" @bind="editingPlan!.MonthlyPrice" step="0.01" min="0" />
                </div>
                <div class="form-group">
                    <label>Stripe Price ID</label>
                    <input type="text" class="form-control" @bind="editingPlan!.StripePriceId" placeholder="price_xxx" />
                </div>
                
                <div class="form-group checkbox-group">
                    <label><input type="checkbox" @bind="editingPlan!.IsFree" /> Free Plan</label>
                </div>
                <div class="form-group checkbox-group">
                    <label><input type="checkbox" @bind="editingPlan!.IsContactSales" /> Contact Sales</label>
                </div>
                
                <div class="form-divider full-width">Quotas</div>
                
                <div class="form-group">
                    <label>Max Executions/Month</label>
                    <input type="number" class="form-control" @bind="editingPlan!.MaxExecutionsPerMonth" min="-1" />
                </div>
                <div class="form-group">
                    <label>Max Storage (MB)</label>
                    <input type="number" class="form-control" @bind="storageMb" min="-1" />
                </div>
                <div class="form-group">
                    <label>Max Workflows</label>
                    <input type="number" class="form-control" @bind="editingPlan!.MaxWorkflows" min="-1" />
                </div>
                <div class="form-group">
                    <label>Max Nodes/Workflow</label>
                    <input type="number" class="form-control" @bind="editingPlan!.MaxNodesPerWorkflow" min="-1" />
                </div>
                <div class="form-group">
                    <label>Max Vector Docs</label>
                    <input type="number" class="form-control" @bind="editingPlan!.MaxVectorDocs" min="-1" />
                </div>
                <div class="form-group">
                    <label>Log Retention (Hours)</label>
                    <input type="number" class="form-control" @bind="editingPlan!.LogRetentionHours" min="-1" />
                </div>
                
                <div class="form-divider full-width">Features</div>
                
                <div class="form-group checkbox-group">
                    <label><input type="checkbox" @bind="editingPlan!.CanImportExport" /> Import/Export</label>
                </div>
                <div class="form-group checkbox-group">
                    <label><input type="checkbox" @bind="editingPlan!.CanUseScheduling" /> Scheduling</label>
                </div>
                <div class="form-group">
                    <label>Max HTTP Listeners</label>
                    <input type="number" class="form-control" @bind="editingPlan!.MaxHttpListeners" min="-1" />
                </div>
                <div class="form-group">
                    <label>Max Paid Members (blank=unlimited)</label>
                    <input type="number" class="form-control" @bind="editingPlan!.MaxPaidMembers" min="1" />
                </div>
                
                <div class="form-divider full-width">🏢 Organization Quotas</div>
                
                <div class="form-group">
                    <label>Max Organizations (0=disabled)</label>
                    <input type="number" class="form-control" @bind="editingPlan!.MaxOrganizations" min="0" />
                </div>
                <div class="form-group">
                    <label>Max Members/Org (0=unlimited)</label>
                    <input type="number" class="form-control" @bind="editingPlan!.MaxMembersPerOrganization" min="0" />
                </div>
                <div class="form-group">
                    <label>Max Workflows/Org (0=unlimited)</label>
                    <input type="number" class="form-control" @bind="editingPlan!.MaxWorkflowsPerOrganization" min="0" />
                </div>
                <div class="form-group">
                    <label>Max Nodes/Org Workflow</label>
                    <input type="number" class="form-control" @bind="editingPlan!.MaxNodesPerOrgWorkflow" min="0" />
                </div>
                <div class="form-group">
                    <label>Org Executions/Month</label>
                    <input type="number" class="form-control" @bind="editingPlan!.MaxOrgExecutionsPerMonth" min="0" />
                </div>
                <div class="form-group">
                    <label>Org Storage (MB)</label>
                    <input type="number" class="form-control" @bind="orgStorageMb" min="0" />
                </div>
                <div class="form-group">
                    <label>Org Vector Docs</label>
                    <input type="number" class="form-control" @bind="editingPlan!.MaxOrgVectorDocs" min="0" />
                </div>
                
                <div class="form-divider full-width">Display</div>
                
                <div class="form-group">
                    <label>Display Order</label>
                    <input type="number" class="form-control" @bind="editingPlan!.DisplayOrder" min="0" />
                </div>
                <div class="form-group checkbox-group">
                    <label><input type="checkbox" @bind="editingPlan!.IsActive" /> Active</label>
                </div>
                
                <div class="form-divider full-width">Badge Colors</div>
                
                <div class="form-group">
                    <label>Gradient Start</label>
                    <input type="color" class="form-control" @bind="editingPlan!.BadgeColorGradientStart" />
                </div>
                <div class="form-group">
                    <label>Gradient End</label>
                    <input type="color" class="form-control" @bind="editingPlan!.BadgeColorGradientEnd" />
                </div>
                <div class="form-group">
                    <label>Text Color</label>
                    <input type="color" class="form-control" @bind="editingPlan!.BadgeTextColor" />
                </div>
                <div class="form-group">
                    <label>Border Color</label>
                    <input type="color" class="form-control" @bind="editingPlan!.BadgeBorderColor" />
                </div>
                
                <div class="form-group full-width">
                    <label>SVG Icon (raw SVG code, max 24x24)</label>
                    <textarea class="form-control" rows="3" @bind="editingPlan!.SvgIcon" placeholder="<svg>...</svg>"></textarea>
                </div>
                
                @if (!string.IsNullOrEmpty(editingPlan?.SvgIcon))
                {
                    <div class="form-group full-width">
                        <label>Preview:</label>
                        <div class="plan-badge preview" style="@GetBadgeStyle(editingPlan)">
                            @((MarkupString)editingPlan.SvgIcon)
                            <span>@(editingPlan.Name ?? "Plan")</span>
                        </div>
                    </div>
                }
            </div>
            
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SavePlan" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save Plan")
                </button>
            </div>
        </div>
    </div>
}

<style>
    .plans-manager {
        padding: 1rem;
    }
    
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
