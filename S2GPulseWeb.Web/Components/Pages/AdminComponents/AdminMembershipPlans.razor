@code {
    private List<MembershipPlan>? plans;
    private bool isLoading = true;
    private bool showModal = false;
    private bool isSaving = false;
    private MembershipPlan? editingPlan;
    private long storageMb;
    private long orgStorageMb;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlansAsync();
    }

    private async Task LoadPlansAsync()
    {
        isLoading = true;
        plans = await MembershipPlanService.GetAllPlansAsync(includeInactive: true);
        isLoading = false;
    }

    private void OpenCreateModal()
    {
        editingPlan = new MembershipPlan
        {
            IsActive = true,
            DisplayOrder = (plans?.Count ?? 0) + 1,
            BadgeColorGradientStart = "#667eea",
            BadgeColorGradientEnd = "#764ba2",
            BadgeTextColor = "#ffffff",
            BadgeBorderColor = "#667eea"
        };
        storageMb = 0;
        orgStorageMb = 0;
        showModal = true;
    }

    private void OpenEditModal(MembershipPlan plan)
    {
        editingPlan = new MembershipPlan
        {
            Id = plan.Id,
            Name = plan.Name,
            Description = plan.Description,
            DetailedDescription = plan.DetailedDescription,
            SvgIcon = plan.SvgIcon,
            BadgeColorGradientStart = plan.BadgeColorGradientStart,
            BadgeColorGradientEnd = plan.BadgeColorGradientEnd,
            BadgeTextColor = plan.BadgeTextColor,
            BadgeBorderColor = plan.BadgeBorderColor,
            MonthlyPrice = plan.MonthlyPrice,
            StripePriceId = plan.StripePriceId,
            IsFree = plan.IsFree,
            IsContactSales = plan.IsContactSales,
            MaxExecutionsPerMonth = plan.MaxExecutionsPerMonth,
            MaxStorageBytes = plan.MaxStorageBytes,
            MaxWorkflows = plan.MaxWorkflows,
            MaxNodesPerWorkflow = plan.MaxNodesPerWorkflow,
            MaxVectorDocs = plan.MaxVectorDocs,
            LogRetentionHours = plan.LogRetentionHours,
            CanImportExport = plan.CanImportExport,
            CanUseScheduling = plan.CanUseScheduling,
            MaxHttpListeners = plan.MaxHttpListeners,
            MaxPaidMembers = plan.MaxPaidMembers,
            DisplayOrder = plan.DisplayOrder,
            IsActive = plan.IsActive,
            // Organization quotas
            MaxOrganizations = plan.MaxOrganizations,
            MaxMembersPerOrganization = plan.MaxMembersPerOrganization,
            MaxWorkflowsPerOrganization = plan.MaxWorkflowsPerOrganization,
            MaxNodesPerOrgWorkflow = plan.MaxNodesPerOrgWorkflow,
            MaxOrgExecutionsPerMonth = plan.MaxOrgExecutionsPerMonth,
            MaxOrgStorageBytes = plan.MaxOrgStorageBytes,
            MaxOrgVectorDocs = plan.MaxOrgVectorDocs
        };
        storageMb = plan.MaxStorageBytes / (1024 * 1024);
        orgStorageMb = plan.MaxOrgStorageBytes / (1024 * 1024);
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        editingPlan = null;
    }

    private async Task SavePlan()
    {
        if (editingPlan == null || string.IsNullOrWhiteSpace(editingPlan.Name))
        {
            return;
        }

        isSaving = true;
        try
        {
            editingPlan.MaxStorageBytes = storageMb * 1024 * 1024;
            editingPlan.MaxOrgStorageBytes = orgStorageMb * 1024 * 1024;
            
            if (editingPlan.Id > 0)
            {
                await MembershipPlanService.UpdatePlanAsync(editingPlan);
            }
            else
            {
                await MembershipPlanService.CreatePlanAsync(editingPlan);
            }
            
            await LoadPlansAsync();
            CloseModal();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeactivatePlan(MembershipPlan plan)
    {
        await MembershipPlanService.DeletePlanAsync(plan.Id);
        await LoadPlansAsync();
    }

    private async Task ActivatePlan(MembershipPlan plan)
    {
        plan.IsActive = true;
        await MembershipPlanService.UpdatePlanAsync(plan);
        await LoadPlansAsync();
    }

    private string GetBadgeStyle(MembershipPlan plan)
    {
        return $"background: linear-gradient(135deg, {plan.BadgeColorGradientStart ?? "#667eea"}, {plan.BadgeColorGradientEnd ?? "#764ba2"}); " +
               $"color: {plan.BadgeTextColor ?? "#fff"}; " +
               $"border: 1px solid {plan.BadgeBorderColor ?? "#667eea"};";
    }

    private string FormatNumber(int value)
    {
        if (value < 0) return "∞";
        if (value >= 1_000_000) return $"{value / 1_000_000.0:F1}M";
        if (value >= 1_000) return $"{value / 1_000.0:F0}k";
        return value.ToString("N0");
    }

    private string FormatBytes(long bytes)
    {
        if (bytes < 0) return "∞";
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F0} KB";
        if (bytes < 1024 * 1024 * 1024) return $"{bytes / (1024.0 * 1024):F0} MB";
        return $"{bytes / (1024.0 * 1024 * 1024):F1} GB";
    }

    private string FormatLimit(int value)
    {
        return value < 0 ? "∞" : value.ToString("N0");
    }

    private string FormatHours(int hours)
    {
        if (hours < 0) return "∞";
        if (hours < 24) return $"{hours}h";
        return $"{hours / 24}d";
    }
}
