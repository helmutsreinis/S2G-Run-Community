@using S2GPulseWeb.Web.Data
@using S2GPulseWeb.Web.Logic
@using System.Text.Json
@using System.Net.Http
@inject CustomNodeService CustomNodeService
@inject BuiltInNodeCatalogService BuiltInNodeCatalogService
@inject IHttpClientFactory HttpClientFactory

<div class="node-designer">
    <div class="designer-header">
        <h2>🧩 Custom Node Designer</h2>
        <p class="subtitle">Create and manage custom workflow nodes with JavaScript logic</p>
    </div>

    <div class="designer-tabs">
        <button class="designer-tab @(activeSection == "categories" ? "active" : "")" 
                @onclick="SetCategoriesTab">
            📁 Categories
        </button>
        <button class="designer-tab @(activeSection == "nodes" ? "active" : "")" 
                @onclick="SetNodesTab">
            🔧 Node Definitions
        </button>
        @if (editingNode != null)
        {
            <button class="designer-tab @(activeSection == "editor" ? "active" : "")" 
                    @onclick="SetEditorTab">
                ✏️ Editor
            </button>
        }
    </div>

    @if (isLoading)
    {
        <div class="loading-state">Loading...</div>
    }
    else
    {
        @if (activeSection == "categories")
        {
            <div class="section-content">
                <div class="section-toolbar">
                    <button class="btn btn-primary" @onclick="CreateNewCategory">
                        ➕ New Category
                    </button>
                </div>

                <div class="items-grid">
                    @foreach (var category in categories)
                    {
                        <div class="item-card">
                            <div class="item-icon">
                                @if (!string.IsNullOrWhiteSpace(category.IconSvg))
                                {
                                    <div class="category-svg-icon">@((MarkupString)category.IconSvg)</div>
                                }
                                else
                                {
                                    @category.IconEmoji
                                }
                            </div>
                            <div class="item-details">
                                <h4>@category.Name</h4>
                                <p>@(category.Description ?? "No description")</p>
                                <span class="item-meta">
                                    Order: @category.DisplayOrder
                                </span>
                            </div>
                            <div class="item-actions">
                                <button class="btn btn-sm btn-edit" @onclick="() => EditCategory(category)">✏️</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteCategory(category.Id)">🗑️</button>
                            </div>
                        </div>
                    }
                    @if (!categories.Any())
                    {
                        <div class="empty-state">No categories yet. Create one to organize your custom nodes.</div>
                    }
                </div>
            </div>
        }

        @if (activeSection == "nodes")
        {
            <div class="section-content">
                <div class="section-toolbar">
                    <button class="btn btn-primary" @onclick="CreateNewNode">
                        ➕ New Node
                    </button>
                    <button class="btn btn-secondary" @onclick="ShowImportModal">
                        📥 Import Node
                    </button>
                    <div class="toolbar-spacer"></div>
                    <select class="filter-select" @onchange="OnCategoryFilterChanged" value="@categoryFilter">
                        <option value="all">All Categories</option>
                        <option value="none">⚠️ No Category</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id">@cat.IconEmoji @cat.Name</option>
                        }
                    </select>
                    <input type="text" class="search-input" placeholder="Search nodes..." 
                           value="@nodeSearchQuery" @oninput="OnSearchChanged" />
                </div>

                <div class="items-grid">
                    @foreach (var node in FilteredNodes)
                    {
                        <div class="item-card @(node.IsEnabled ? "" : "disabled")">
                            <div class="item-icon">
                                @if (!string.IsNullOrWhiteSpace(node.IconSvg))
                                {
                                    <div class="node-svg-icon">@((MarkupString)node.IconSvg)</div>
                                }
                            </div>
                            <div class="item-details">
                                <h4>@node.DisplayName</h4>
                                <p class="node-type-key">@node.NodeTypeKey</p>
                                <span class="item-meta">
                                    @if (!string.IsNullOrEmpty(node.CategoryName))
                                    {
                                        <span class="category-badge">@node.CategoryEmoji @node.CategoryName</span>
                                        <span class="meta-sep">•</span>
                                    }
                                    @node.ExecutionType • v@(node.Version)
                                    @if (!node.IsEnabled)
                                    {
                                        <span class="badge badge-disabled">Disabled</span>
                                    }
                                </span>
                            </div>
                            <div class="item-actions">
                                <button class="btn btn-sm btn-edit" @onclick="() => EditNodeAsync(node.Id)" disabled="@isLoadingNode">✏️</button>
                                <button class="btn btn-sm btn-secondary" @onclick="() => ExportNode(node.Id)">📤</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteNode(node.Id)">🗑️</button>
                            </div>
                        </div>
                    }
                    @if (!FilteredNodes.Any())
                    {
                        <div class="empty-state">
                            @if (categoryFilter == "none")
                            {
                                <text>All nodes have categories assigned. ✅</text>
                            }
                            else if (!string.IsNullOrEmpty(nodeSearchQuery))
                            {
                                <text>No nodes match your search.</text>
                            }
                            else
                            {
                                <text>No custom nodes defined yet. Create your first node!</text>
                            }
                        </div>
                    }
                </div>
                
                @if (TotalPages > 1)
                {
                    <div class="pagination-controls">
                        <button class="btn btn-sm btn-secondary" @onclick="() => GoToPage(1)" disabled="@(currentPage == 1)">
                            ⏮️
                        </button>
                        <button class="btn btn-sm btn-secondary" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage == 1)">
                            ◀️
                        </button>
                        <span class="pagination-info">
                            Page @currentPage of @TotalPages (@TotalFilteredCount nodes)
                        </span>
                        <button class="btn btn-sm btn-secondary" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage >= TotalPages)">
                            ▶️
                        </button>
                        <button class="btn btn-sm btn-secondary" @onclick="() => GoToPage(TotalPages)" disabled="@(currentPage >= TotalPages)">
                            ⏭️
                        </button>
                    </div>
                }
            </div>
        }

        @if (activeSection == "editor" && editingNode != null)
        {
            <div class="section-content editor-section">
                <div class="editor-header">
                    <h3>@(isNewNode ? "Create New Node" : $"Edit: {editingNode.DisplayName}")</h3>
                    <div class="editor-actions">
                        <button class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                        <button class="btn btn-primary" @onclick="SaveNode" disabled="@isSaving">
                            @(isSaving ? "Saving..." : "Save Node")
                        </button>
                    </div>
                </div>

                <div class="editor-tabs">
                    <button class="editor-tab @(editorTab == "general" ? "active" : "")" 
                            @onclick="SetEditorTabGeneral">General</button>
                    <button class="editor-tab @(editorTab == "inputs" ? "active" : "")" 
                            @onclick="SetEditorTabInputs">Inputs (@editingNode.InputFields.Count)</button>
                    <button class="editor-tab @(editorTab == "outputs" ? "active" : "")" 
                            @onclick="SetEditorTabOutputs">Outputs (@editingNode.OutputParameters.Count)</button>
                    <button class="editor-tab @(editorTab == "script" ? "active" : "")" 
                            @onclick="SetEditorTabScript">Script</button>
                    <button class="editor-tab @(editorTab == "tags" ? "active" : "")" 
                            @onclick="SetEditorTabTags">Tags (@editingNode.ConnectionTags.Count)</button>
                    <button class="editor-tab @(editorTab == "test" ? "active" : "")" 
                            @onclick="SetEditorTabTest">🧪 Test</button>
                </div>

                <div class="editor-content">
                    @if (editorTab == "general")
                    {
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Node Type Key *</label>
                                <input type="text" class="form-control" @bind="editingNode.NodeTypeKey" 
                                       placeholder="e.g., Custom_JsonTransformer" />
                                <span class="form-hint">Must start with "Custom_"</span>
                            </div>
                            <div class="form-group">
                                <label>Display Name *</label>
                                <input type="text" class="form-control" @bind="editingNode.DisplayName" 
                                       placeholder="e.g., JSON Transformer" />
                            </div>
                            <div class="form-group full-width">
                                <label>Description</label>
                                <textarea class="form-control" @bind="editingNode.Description" rows="2"
                                          placeholder="Describe what this node does..."></textarea>
                            </div>
                            <div class="form-group">
                                <label>Category</label>
                                <select class="form-control" @bind="editingNode.CategoryId">
                                    <option value="">-- No Category --</option>
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Id">@cat.IconEmoji @cat.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Execution Type</label>
                                <select class="form-control" @bind="editingNode.ExecutionType">
                                    @foreach (var type in Enum.GetValues<CustomNodeExecutionType>())
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Timeout (seconds)</label>
                                <input type="number" class="form-control" @bind="editingNode.TimeoutSeconds" min="1" max="300" />
                            </div>
                            <div class="form-group full-width">
                                <label>Icon SVG</label>
                                <div class="svg-editor-row">
                                    <textarea class="form-control code-input" @bind="editingNode.IconSvg" @bind:event="oninput" rows="4"
                                              placeholder="<svg viewBox='0 0 24 24'>...</svg>"></textarea>
                                    <div class="svg-preview-box">
                                        <span class="preview-label">Preview</span>
                                        <div class="svg-preview">
                                            @if (!string.IsNullOrWhiteSpace(editingNode.IconSvg))
                                            {
                                                @((MarkupString)editingNode.IconSvg)
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="checkbox-label">
                                    <input type="checkbox" @bind="editingNode.IsEnabled" />
                                    <span>Enabled</span>
                                </label>
                            </div>
                        </div>
                    }

                    @if (editorTab == "inputs")
                    {
                        <div class="list-editor">
                            <button class="btn btn-sm btn-primary" @onclick="AddInputField">➕ Add Input Field</button>
                            <div class="list-items">
                                @foreach (var field in editingNode.InputFields.OrderBy(f => f.DisplayOrder))
                                {
                                    <div class="list-item">
                                        <div class="list-item-header">
                                            <span class="field-name">@field.FieldName</span>
                                            <span class="field-type">@field.FieldType</span>
                                            <button class="btn btn-sm btn-danger" @onclick="() => RemoveInputField(field)">✕</button>
                                        </div>
                                        <div class="list-item-body">
                                            <input type="text" placeholder="Field Name" @bind="field.FieldName" class="form-control-sm" />
                                            <input type="text" placeholder="Display Label" @bind="field.DisplayLabel" class="form-control-sm" />
                                            <select @bind="field.FieldType" class="form-control-sm">
                                                @foreach (var type in Enum.GetValues<CustomFieldType>())
                                                {
                                                    <option value="@type">@type</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="list-item-body">
                                            <input type="text" placeholder="Default Value" @bind="field.DefaultValue" class="form-control-sm" title="Default Value" />
                                            <input type="text" placeholder="Placeholder Text" @bind="field.PlaceholderText" class="form-control-sm" title="Placeholder Text" />
                                            <input type="text" placeholder="Help Text" @bind="field.HelpText" class="form-control-sm" title="Help Text" />
                                        </div>
                                        <div class="list-item-body">
                                            <label class="checkbox-label-sm">
                                                <input type="checkbox" @bind="field.IsRequired" /> Required
                                            </label>
                                            <label class="checkbox-label-sm">
                                                <input type="checkbox" @bind="field.AllowPlaceholders" /> Allow Placeholders
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (editorTab == "outputs")
                    {
                        <div class="list-editor">
                            <button class="btn btn-sm btn-primary" @onclick="AddOutputParam">➕ Add Output Parameter</button>
                            <div class="list-items">
                                @foreach (var param in editingNode.OutputParameters.OrderBy(p => p.DisplayOrder))
                                {
                                    <div class="list-item">
                                        <div class="list-item-header">
                                            <span class="field-name">@param.ParameterName</span>
                                            <span class="field-type">@param.DataType</span>
                                            <button class="btn btn-sm btn-danger" @onclick="() => RemoveOutputParam(param)">✕</button>
                                        </div>
                                        <div class="list-item-body">
                                            <input type="text" placeholder="Parameter Name" @bind="param.ParameterName" class="form-control-sm" />
                                            <input type="text" placeholder="Description" @bind="param.Description" class="form-control-sm" />
                                            <select @bind="param.DataType" class="form-control-sm">
                                                <option value="string">string</option>
                                                <option value="int">int</option>
                                                <option value="bool">bool</option>
                                                <option value="object">object</option>
                                                <option value="array">array</option>
                                            </select>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (editorTab == "script")
                    {
                        <div class="script-editor">
                            <div class="script-help">
                                <details>
                                    <summary>📚 Available APIs</summary>
                                    <ul>
                                        <li><code>input.get("fieldName")</code> - Get input field value</li>
                                        <li><code>upstream.get("NodeName.Param")</code> - Get upstream data</li>
                                        <li><code>output.set("name", value)</code> - Set output</li>
                                        <li><code>tags.trigger("tagName")</code> - Trigger connection tag</li>
                                        <li><code>log.info/warn/error/debug("msg")</code> - Logging</li>
                                        <li><code>json.parse(str)</code> / <code>json.stringify(obj)</code></li>
                                    </ul>
                                </details>
                            </div>
                            <label>JavaScript Code</label>
                            <textarea class="form-control code-input" @bind="editingNode.Script" rows="20"
                                      placeholder="// Your JavaScript code here..."></textarea>
                        </div>
                    }

                    @if (editorTab == "tags")
                    {
                        <div class="list-editor">
                            <button class="btn btn-sm btn-primary" @onclick="AddConnectionTag">➕ Add Connection Tag</button>
                            <p class="help-text">Connection tags allow conditional routing. Use <code>tags.trigger("tagName")</code> in your script.</p>
                            <div class="list-items">
                                @foreach (var tag in editingNode.ConnectionTags.OrderBy(t => t.DisplayOrder))
                                {
                                    <div class="list-item">
                                        <div class="list-item-header">
                                            <span class="field-name" style="@(string.IsNullOrEmpty(tag.Color) ? "" : $"color: {tag.Color}")">
                                                @tag.TagName
                                            </span>
                                            <button class="btn btn-sm btn-danger" @onclick="() => RemoveConnectionTag(tag)">✕</button>
                                        </div>
                                        <div class="list-item-body">
                                            <input type="text" placeholder="Tag Name" @bind="tag.TagName" class="form-control-sm" />
                                            <input type="text" placeholder="Description" @bind="tag.Description" class="form-control-sm" />
                                            <input type="color" @bind="tag.Color" class="color-input" title="Tag Color" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (editorTab == "test")
                    {
                        <div class="test-panel">
                            <div class="test-layout">
                                @* Left: Node Preview Card *@
                                <div class="node-preview-card">
                                    <div class="node-preview-header">
                                        <div class="node-preview-icon">
                                            @if (!string.IsNullOrWhiteSpace(editingNode.IconSvg))
                                            {
                                                @((MarkupString)editingNode.IconSvg)
                                            }
                                        </div>
                                        <div class="node-preview-title">
                                            <h4>@editingNode.DisplayName</h4>
                                            <span class="node-preview-type">@editingNode.NodeTypeKey</span>
                                        </div>
                                    </div>

                                    @* Input Fields Preview *@
                                    <div class="node-preview-section">
                                        <h5>📥 Inputs</h5>
                                        @if (editingNode.InputFields.Any())
                                        {
                                            @foreach (var field in editingNode.InputFields.OrderBy(f => f.DisplayOrder))
                                            {
                                                <div class="preview-field">
                                                    <label>
                                                        @field.DisplayLabel
                                                        @if (field.IsRequired) { <span class="required">*</span> }
                                                    </label>
                                                    @switch (field.FieldType)
                                                    {
                                                        case CustomFieldType.Text:
                                                            <input type="text" class="form-control-sm" 
                                                                   placeholder="@(field.PlaceholderText ?? field.FieldName)"
                                                                   @bind="testInputValues[field.FieldName]" />
                                                            break;
                                                        case CustomFieldType.TextArea:
                                                            <textarea class="form-control-sm" rows="2"
                                                                      placeholder="@(field.PlaceholderText ?? field.FieldName)"
                                                                      @bind="testInputValues[field.FieldName]"></textarea>
                                                            break;
                                                        case CustomFieldType.Number:
                                                            <input type="number" class="form-control-sm"
                                                                   placeholder="@(field.PlaceholderText ?? "0")"
                                                                   @bind="testInputValues[field.FieldName]" />
                                                            break;
                                                        case CustomFieldType.Boolean:
                                                            <label class="checkbox-label">
                                                                <input type="checkbox" @bind="testCheckboxValues[field.FieldName]" />
                                                                <span>@field.DisplayLabel</span>
                                                            </label>
                                                            break;
                                                        default:
                                                            <input type="text" class="form-control-sm"
                                                                   placeholder="@(field.PlaceholderText ?? field.FieldName)"
                                                                   @bind="testInputValues[field.FieldName]" />
                                                            break;
                                                    }
                                                    @if (!string.IsNullOrEmpty(field.HelpText))
                                                    {
                                                        <span class="field-help">@field.HelpText</span>
                                                    }
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="no-items">No input fields defined</span>
                                        }
                                    </div>

                                    @* Output Parameters Preview *@
                                    <div class="node-preview-section">
                                        <h5>📤 Outputs</h5>
                                        @if (editingNode.OutputParameters.Any())
                                        {
                                            <div class="output-params-list">
                                                @foreach (var param in editingNode.OutputParameters.OrderBy(p => p.DisplayOrder))
                                                {
                                                    <span class="output-param" title="@param.Description">
                                                        @("{{")<span>@editingNode.NodeTypeKey.Replace("Custom_", "").@param.ParameterName</span>@("}}")
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="no-items">No output parameters defined</span>
                                        }
                                    </div>

                                    @* Connection Tags *@
                                    @if (editingNode.ConnectionTags.Any())
                                    {
                                        <div class="node-preview-section">
                                            <h5>🏷️ Tags</h5>
                                            <div class="tag-list">
                                                @foreach (var tag in editingNode.ConnectionTags)
                                                {
                                                    <span class="connection-tag" style="@(string.IsNullOrEmpty(tag.Color) ? "" : $"border-color: {tag.Color}; color: {tag.Color}")">
                                                        @tag.TagName
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>

                                @* Right: Test Execution *@
                                <div class="test-execution-panel">
                                    <h5>🧪 Test Execution</h5>
                                    
                                    <div class="test-actions">
                                        <button class="btn btn-primary" @onclick="RunTestExecution" disabled="@isTestRunning">
                                            @(isTestRunning ? "Running..." : "▶️ Run Test")
                                        </button>
                                    </div>

                                    @if (!string.IsNullOrEmpty(testError))
                                    {
                                        <div class="test-error">⚠️ @testError</div>
                                    }

                                    @if (!string.IsNullOrEmpty(testResultJson))
                                    {
                                        <div class="test-section">
                                            <label>📤 Result</label>
                                            <textarea class="form-control code-input" rows="15" readonly>@testResultJson</textarea>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@* Category Editor Modal *@
@if (showCategoryModal)
{
    <div class="modal-overlay" @onclick="CloseCategoryModal">
        <div class="modal-content modal-wide" @onclick:stopPropagation="true">
            <h3>@(isNewCategory ? "Create Category" : "Edit Category")</h3>
            
            <div class="form-group">
                <label>Name *</label>
                <input type="text" class="form-control" @bind="editingCategory.Name" />
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea class="form-control" @bind="editingCategory.Description" rows="2"></textarea>
            </div>
            <div class="form-group">
                <label>Icon SVG</label>
                <div class="svg-editor-row">
                    <textarea class="form-control code-input" @bind="editingCategory.IconSvg" @bind:event="oninput" rows="4"
                              placeholder="<svg viewBox='0 0 24 24'>...</svg>"></textarea>
                    <div class="svg-preview-box">
                        <span class="preview-label">Preview</span>
                        <div class="svg-preview">
                            @if (!string.IsNullOrWhiteSpace(editingCategory.IconSvg))
                            {
                                @((MarkupString)editingCategory.IconSvg)
                            }
                            else if (!string.IsNullOrWhiteSpace(editingCategory.IconEmoji))
                            {
                                <span style="font-size: 24px;">@editingCategory.IconEmoji</span>
                            }
                        </div>
                    </div>
                </div>
                <span class="form-hint">Paste SVG code for the icon. Falls back to emoji if empty.</span>
            </div>
            <div class="form-group">
                <label>Fallback Emoji</label>
                <input type="text" class="form-control" @bind="editingCategory.IconEmoji" maxlength="4" style="width: 80px;" />
            </div>
            <div class="form-group">
                <label>Display Order</label>
                <input type="number" class="form-control" @bind="editingCategory.DisplayOrder" />
            </div>
            <div class="form-group">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="editingCategory.IsEnabled" />
                    <span>Enabled</span>
                </label>
            </div>
            
            @* Built-in Node Assignment Section - Two Column Layout *@
            <div class="form-group builtin-nodes-section">
                <label>📦 Assign Built-in Nodes</label>
                <p class="form-hint" style="margin-top: 0.25rem;">Select built-in nodes to include in this catalog category.</p>
                <div class="builtin-nodes-layout">
                    @* Left: Compact Table *@
                    <div class="builtin-nodes-table-container">
                        <table class="builtin-nodes-table">
                            <thead>
                                <tr>
                                    <th style="width: 30px;"></th>
                                    <th>Category</th>
                                    <th>Node</th>
                                    <th style="width: 30px;">Icon</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var group in BuiltInNodeCatalogService.GetAllBuiltInNodeTypes().GroupBy(n => n.Category).OrderBy(g => g.Key))
                                {
                                    @foreach (var node in group.OrderBy(n => n.DisplayName))
                                    {
                                        var currentOverride = builtInIconOverrides.TryGetValue(node.NodeTypeKey, out var ov) ? ov : null;
                                        var hasOverride = !string.IsNullOrWhiteSpace(currentOverride);
                                        var isEditing = editingIconNodeType == node.NodeTypeKey;
                                        var isSelected = selectedBuiltInNodes.Contains(node.NodeTypeKey);
                                        
                                        <tr class="@(isSelected ? "selected" : "") @(isEditing ? "editing" : "")">
                                            <td class="checkbox-cell">
                                                <input type="checkbox" 
                                                       checked="@isSelected"
                                                       @onchange="@(e => ToggleBuiltInNode(node.NodeTypeKey, (bool)(e.Value ?? false)))" />
                                            </td>
                                            <td class="category-cell">@group.Key</td>
                                            <td class="name-cell">@node.DisplayName</td>
                                            <td class="icon-cell">
                                                <button class="btn-icon-edit @(hasOverride ? "has-override" : "") @(isEditing ? "active" : "")" 
                                                        title="@(hasOverride ? "Edit custom icon" : "Add custom icon")"
                                                        @onclick="@(() => ToggleIconEditor(node.NodeTypeKey))">
                                                    @if (hasOverride)
                                                    {
                                                        <div class="builtin-svg-icon">@((MarkupString)currentOverride!)</div>
                                                    }
                                                    else
                                                    {
                                                        <span>@node.Icon</span>
                                                    }
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    
                    @* Right: SVG Editor Panel *@
                    <div class="builtin-svg-editor-panel @(editingIconNodeType != null ? "active" : "")">
                        @if (editingIconNodeType != null)
                        {
                            var editNode = BuiltInNodeCatalogService.GetAllBuiltInNodeTypes().FirstOrDefault(n => n.NodeTypeKey == editingIconNodeType);
                            if (editNode != null)
                            {
                                <div class="svg-editor-header">
                                    <h5>🎨 Custom Icon: @editNode.DisplayName</h5>
                                    <button class="btn btn-sm btn-secondary" @onclick="@(() => editingIconNodeType = null)">✕</button>
                                </div>
                                <div class="svg-editor-content">
                                    <label>SVG Code</label>
                                    <textarea class="form-control code-input" rows="10" 
                                              placeholder="<svg viewBox='0 0 24 24'>...</svg>"
                                              @bind="tempIconSvg" @bind:event="oninput"></textarea>
                                </div>
                                <div class="svg-editor-preview">
                                    <label>Preview</label>
                                    <div class="svg-preview-large">
                                        @if (!string.IsNullOrWhiteSpace(tempIconSvg))
                                        {
                                            @((MarkupString)tempIconSvg)
                                        }
                                        else
                                        {
                                            <span class="default-icon">@editNode.Icon</span>
                                        }
                                    </div>
                                </div>
                                <div class="svg-editor-actions">
                                    <button class="btn btn-primary" @onclick="@(() => SaveIconOverride(editingIconNodeType))">💾 Save</button>
                                    <button class="btn btn-danger" @onclick="@(() => ClearIconOverride(editingIconNodeType))">🗑️ Clear</button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="svg-editor-empty">
                                <span>✏️</span>
                                <p>Click a node's icon to customize it</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CloseCategoryModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveCategory">Save</button>
            </div>
        </div>
    </div>
}

@* Export Modal *@
@if (showExportModal)
{
    <div class="modal-overlay" @onclick="CloseExportModal">
        <div class="modal-content modal-wide" @onclick:stopPropagation="true">
            <h3>📤 Export Node Definition</h3>
            <textarea class="form-control code-input" rows="15" readonly>@exportJson</textarea>
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CloseExportModal">Close</button>
                <button class="btn btn-primary" @onclick="CopyExportToClipboard">📋 Copy to Clipboard</button>
            </div>
        </div>
    </div>
}

@* Import Modal *@
@if (showImportModal)
{
    <div class="modal-overlay" @onclick="CloseImportModal">
        <div class="modal-content modal-wide" @onclick:stopPropagation="true">
            <h3>📥 Import Node Definition</h3>
            <p class="modal-hint">Paste the exported JSON below:</p>
            <textarea class="form-control code-input" rows="15" @bind="importJson" 
                      placeholder='{"exportVersion": 1, "definition": {...}}'></textarea>
            @if (!string.IsNullOrEmpty(importError))
            {
                <div class="import-error">⚠️ @importError</div>
            }
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CloseImportModal">Cancel</button>
                <button class="btn btn-primary" @onclick="ImportNode" disabled="@isImporting">
                    @(isImporting ? "Importing..." : "📥 Import")
                </button>
            </div>
        </div>
    </div>
}

