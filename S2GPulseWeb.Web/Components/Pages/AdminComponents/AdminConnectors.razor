@using S2GPulseWeb.Web.Data
@using S2GPulseWeb.Web.Logic
@inject PlatformConnectorService ConnectorService

<div class="connectors-admin">
    <div class="admin-section-header">
        <h2>🔌 Platform Connectors</h2>
        <p class="section-description">
            Define M365 connectors with Azure AD credentials that users can consent to from the Connections page.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isSuccess ? "alert-success" : "alert-danger")">
            @statusMessage
        </div>
    }

    @* Categories Section *@
    <div class="categories-section">
        <div class="section-header">
            <h3>📁 Categories</h3>
            <button class="btn btn-sm btn-primary" @onclick="ShowAddCategoryModal">
                ➕ Add Category
            </button>
        </div>

        @if (categories == null)
        {
            <p class="loading">Loading categories...</p>
        }
        else if (!categories.Any())
        {
            <p class="empty-message">No categories yet. Create one to organize your connectors.</p>
        }
        else
        {
            <div class="categories-list">
                @foreach (var category in categories)
                {
                    <div class="category-item">
                        <div class="category-info">
                            <span class="category-icon">@category.IconEmoji</span>
                            <span class="category-name">@category.Name</span>
                            @if (!string.IsNullOrEmpty(category.Description))
                            {
                                <span class="category-description">— @category.Description</span>
                            }
                        </div>
                        <div class="category-actions">
                            <button class="btn btn-xs btn-secondary" @onclick="() => EditCategory(category)">✏️</button>
                            <button class="btn btn-xs btn-danger" @onclick="() => DeleteCategory(category.Id)">🗑️</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @* Connectors Section *@
    <div class="connectors-section">
        <div class="section-header">
            <h3>⚡ Connectors</h3>
            <button class="btn btn-sm btn-primary" @onclick="ShowAddConnectorModal">
                ➕ Add Connector
            </button>
        </div>

        @if (connectors == null)
        {
            <p class="loading">Loading connectors...</p>
        }
        else if (!connectors.Any())
        {
            <p class="empty-message">No connectors configured. Add Azure AD app credentials to enable user OAuth consent.</p>
        }
        else
        {
            <div class="connectors-list">
                @foreach (var connector in connectors)
                {
                    <div class="connector-card @(connector.IsEnabled ? "" : "disabled")">
                        <div class="connector-header">
                            <div class="connector-title">
                                <span class="connector-name">@connector.Name</span>
                                <span class="consent-type-badge @connector.ConsentType.ToString().ToLower()">
                                    @connector.ConsentType
                                </span>
                                @if (!connector.IsEnabled)
                                {
                                    <span class="status-badge disabled">Disabled</span>
                                }
                            </div>
                            <div class="connector-actions">
                                <button class="btn btn-xs btn-secondary" @onclick="() => EditConnector(connector)">✏️</button>
                                <button class="btn btn-xs btn-danger" @onclick="() => DeleteConnector(connector.Id)">🗑️</button>
                            </div>
                        </div>
                        <div class="connector-body">
                            <div class="connector-category">
                                @if (connector.Category != null)
                                {
                                    <span>@connector.Category.IconEmoji @connector.Category.Name</span>
                                }
                                else
                                {
                                    <span class="uncategorized">Uncategorized</span>
                                }
                            </div>
                            <div class="connector-client-id">
                                <span class="label">Client ID:</span>
                                <code>@connector.ClientId</code>
                                @if (string.IsNullOrEmpty(connector.ClientSecret))
                                {
                                    <span class="status-badge secret-missing" title="Client secret is missing. Edit connector to re-enter.">⚠️ Secret Missing</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(connector.Description))
                            {
                                <div class="connector-description">
                                    @((MarkupString)connector.Description)
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* Category Modal *@
@if (showCategoryModal)
{
    <div class="modal-overlay" @onclick="CloseCategoryModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h3>@(editingCategory == null ? "Add Category" : "Edit Category")</h3>
            
            <div class="form-group">
                <label>Name</label>
                <input type="text" class="form-control" @bind="categoryName" placeholder="e.g., Partner Operations" />
            </div>
            
            <div class="form-group">
                <label>Description (optional)</label>
                <input type="text" class="form-control" @bind="categoryDescription" placeholder="Brief description" />
            </div>
            
            <div class="form-group">
                <label>Icon Emoji</label>
                <div class="emoji-picker">
                    @foreach (var emoji in availableEmojis)
                    {
                        <button type="button" 
                                class="emoji-option @(categoryIcon == emoji ? "selected" : "")"
                                @onclick="() => categoryIcon = emoji">
                            @emoji
                        </button>
                    }
                </div>
            </div>
            
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CloseCategoryModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveCategory" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}

@* Connector Modal *@
@if (showConnectorModal)
{
    <div class="modal-overlay" @onclick="CloseConnectorModal">
        <div class="modal-content modal-lg" @onclick:stopPropagation="true">
            <h3>@(editingConnector == null ? "Add Connector" : "Edit Connector")</h3>
            
            <div class="form-row">
                <div class="form-group">
                    <label>Name *</label>
                    <input type="text" class="form-control" @bind="connectorName" placeholder="e.g., Production Graph Access" />
                </div>
                
                <div class="form-group">
                    <label>Category</label>
                    <select class="form-control" @bind="connectorCategoryId">
                        <option value="">— Uncategorized —</option>
                        @if (categories != null)
                        {
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.IconEmoji @cat.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Consent Type *</label>
                    <select class="form-control" @bind="connectorConsentType">
                        <option value="@ConnectorConsentType.Graph">Graph (Microsoft Graph API)</option>
                        <option value="@ConnectorConsentType.PartnerCenter">Partner Center</option>
                        <option value="@ConnectorConsentType.AzureManagement">Azure Management</option>
                        <option value="@ConnectorConsentType.GitHubCopilot">GitHub Copilot (Device Flow)</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label>Tenant ID</label>
                    <input type="text" class="form-control" @bind="connectorTenantId" placeholder="common (multi-tenant)" />
                </div>
            </div>

            <div class="form-group">
                <label>Client ID (Application ID) *</label>
                <input type="text" class="form-control" @bind="connectorClientId" 
                       placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
            </div>

            <div class="form-group">
                <label>
                    Client Secret @(editingConnector != null ? "(leave empty to keep existing)" : "*")
                    @if (editingConnector != null)
                    {
                        <button type="button" class="btn btn-xs" style="margin-left: 10px; padding: 2px 8px; font-size: 0.7rem;" 
                                @onclick="ToggleSecretVisibility">
                            @(showSecret ? "🔒 Hide" : "👁️ Show")
                        </button>
                    }
                </label>
                <input type="@(showSecret ? "text" : "password")" class="form-control" @bind="connectorClientSecret" 
                       placeholder="Enter client secret" />
                @if (editingConnector != null && !string.IsNullOrEmpty(editingConnector.ClientSecret) && string.IsNullOrEmpty(connectorClientSecret))
                {
                    <small style="color: #4facfe;">Current secret is set (hidden). Enter a new value to replace it.</small>
                }
                else if (editingConnector != null && string.IsNullOrEmpty(editingConnector.ClientSecret))
                {
                    <small style="color: #f39c12;">⚠️ No secret stored. Please enter the client secret.</small>
                }
            </div>

            <div class="form-group">
                <label>Required Scopes (comma-separated)</label>
                <input type="text" class="form-control" @bind="connectorScopes" 
                       placeholder="e.g., User.Read, Files.Read.All, offline_access" />
            </div>

            <div class="form-group">
                <label>User-Facing Description</label>
                <Radzen.Blazor.RadzenHtmlEditor @bind-Value="@connectorDescription" 
                                                 Style="height: 150px; background: #1a1a2e;" />
            </div>

            <div class="form-group checkbox-group">
                <label class="checkbox-label">
                    <input type="checkbox" @bind="connectorEnabled" />
                    <span>Enabled (visible to users)</span>
                </label>
            </div>
            
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CloseConnectorModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveConnector" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}

