@code {
    private List<ConnectorCategory>? categories;
    private List<PlatformConnector>? connectors;
    
    private string statusMessage = "";
    private bool isSuccess;
    private bool isSaving;
    
    // Category modal state
    private bool showCategoryModal;
    private ConnectorCategory? editingCategory;
    private string categoryName = "";
    private string? categoryDescription;
    private string categoryIcon = "📁";
    
    // Predefined emoji options for categories
    private readonly string[] availableEmojis = new[]
    {
        "📁", "📂", "🏢", "☁️", "🔒", "🔓", "👥", "📊", "📈", "💼",
        "🌐", "🔌", "⚡", "🛠️", "⚙️", "📧", "📅", "📋", "🗂️", "💾",
        "🔄", "🚀", "💡", "🎯", "🏆", "⭐", "🔐", "🛡️", "📱", "💻"
    };
    
    // Connector modal state
    private bool showConnectorModal;
    private PlatformConnector? editingConnector;
    private string connectorName = "";
    private string? connectorCategoryId;
    private ConnectorConsentType connectorConsentType = ConnectorConsentType.Graph;
    private string connectorClientId = "";
    private string connectorClientSecret = "";
    private string connectorTenantId = "common";
    private string connectorScopes = "";
    private string connectorDescription = "";
    private bool connectorEnabled = true;
    private bool showSecret = false;
    
    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        categories = await ConnectorService.GetCategoriesAsync();
        connectors = await ConnectorService.GetConnectorsAsync();
    }

    #region Category CRUD

    private void ShowAddCategoryModal()
    {
        editingCategory = null;
        categoryName = "";
        categoryDescription = null;
        categoryIcon = "📁";
        showCategoryModal = true;
    }

    private void EditCategory(ConnectorCategory category)
    {
        editingCategory = category;
        categoryName = category.Name;
        categoryDescription = category.Description;
        categoryIcon = category.IconEmoji;
        showCategoryModal = true;
    }

    private void CloseCategoryModal()
    {
        showCategoryModal = false;
        editingCategory = null;
    }

    private async Task SaveCategory()
    {
        if (string.IsNullOrWhiteSpace(categoryName))
        {
            statusMessage = "Category name is required.";
            isSuccess = false;
            return;
        }

        isSaving = true;
        try
        {
            if (editingCategory == null)
            {
                await ConnectorService.CreateCategoryAsync(categoryName, categoryDescription, categoryIcon);
                statusMessage = "Category created successfully.";
            }
            else
            {
                await ConnectorService.UpdateCategoryAsync(
                    editingCategory.Id, categoryName, categoryDescription, categoryIcon, editingCategory.DisplayOrder);
                statusMessage = "Category updated successfully.";
            }

            isSuccess = true;
            CloseCategoryModal();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteCategory(Guid id)
    {
        var result = await ConnectorService.DeleteCategoryAsync(id);
        if (result)
        {
            statusMessage = "Category deleted. Connectors are now uncategorized.";
            isSuccess = true;
            await LoadDataAsync();
        }
        else
        {
            statusMessage = "Failed to delete category.";
            isSuccess = false;
        }
    }

    #endregion

    #region Connector CRUD

    private void ShowAddConnectorModal()
    {
        editingConnector = null;
        connectorName = "";
        connectorCategoryId = null;
        connectorConsentType = ConnectorConsentType.Graph;
        connectorClientId = "";
        connectorClientSecret = "";
        connectorTenantId = "common";
        connectorScopes = "User.Read, offline_access";
        connectorDescription = "";
        connectorEnabled = true;
        showSecret = false;
        showConnectorModal = true;
    }

    private void EditConnector(PlatformConnector connector)
    {
        editingConnector = connector;
        connectorName = connector.Name;
        connectorCategoryId = connector.CategoryId?.ToString();
        connectorConsentType = connector.ConsentType;
        connectorClientId = connector.ClientId;
        connectorClientSecret = connector.ClientSecret ?? ""; // Load existing secret for viewing
        connectorTenantId = connector.TenantId;
        connectorScopes = connector.RequiredScopes;
        connectorDescription = connector.Description;
        connectorEnabled = connector.IsEnabled;
        showSecret = false; // Start hidden
        showConnectorModal = true;
    }

    private void ToggleSecretVisibility()
    {
        showSecret = !showSecret;
    }

    private void CloseConnectorModal()
    {
        showConnectorModal = false;
        editingConnector = null;
    }

    private async Task SaveConnector()
    {
        if (string.IsNullOrWhiteSpace(connectorName) || string.IsNullOrWhiteSpace(connectorClientId))
        {
            statusMessage = "Name and Client ID are required.";
            isSuccess = false;
            return;
        }

        if (editingConnector == null && string.IsNullOrWhiteSpace(connectorClientSecret))
        {
            statusMessage = "Client Secret is required for new connectors.";
            isSuccess = false;
            return;
        }

        isSaving = true;
        try
        {
            Guid? categoryId = string.IsNullOrEmpty(connectorCategoryId) 
                ? null 
                : Guid.Parse(connectorCategoryId);

            if (editingConnector == null)
            {
                await ConnectorService.CreateConnectorAsync(
                    categoryId, connectorName, connectorDescription, connectorConsentType,
                    connectorClientId, connectorClientSecret, connectorTenantId, connectorScopes);
                statusMessage = "Connector created successfully.";
            }
            else
            {
                await ConnectorService.UpdateConnectorAsync(
                    editingConnector.Id, categoryId, connectorName, connectorDescription,
                    connectorConsentType, connectorClientId, 
                    string.IsNullOrEmpty(connectorClientSecret) ? null : connectorClientSecret,
                    connectorTenantId, connectorScopes, connectorEnabled, editingConnector.DisplayOrder);
                statusMessage = "Connector updated successfully.";
            }

            isSuccess = true;
            CloseConnectorModal();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteConnector(Guid id)
    {
        var result = await ConnectorService.DeleteConnectorAsync(id);
        if (result)
        {
            statusMessage = "Connector deleted.";
            isSuccess = true;
            await LoadDataAsync();
        }
        else
        {
            statusMessage = "Failed to delete connector.";
            isSuccess = false;
        }
    }

    #endregion
}
