@code {
    private LegalDocumentType selectedType = LegalDocumentType.TermsOfService;
    private List<LegalDocument>? documents;
    
    // Editor state
    private bool showEditor = false;
    private LegalDocument? editingDocument;
    private string editorTitle = "";
    private string editorContent = "";
    private bool isSaving = false;
    
    // Preview state
    private bool showPreview = false;
    private LegalDocument? previewDocument;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocuments();
    }

    private async Task LoadDocuments()
    {
        documents = await LegalDocumentService.GetAllVersionsAsync(selectedType);
    }

    private async Task SelectType(LegalDocumentType type)
    {
        selectedType = type;
        await LoadDocuments();
    }

    private void OpenCreateModal()
    {
        editingDocument = null;
        editorTitle = selectedType == LegalDocumentType.TermsOfService 
            ? "Terms of Service" 
            : "Privacy Policy";
        editorContent = "";
        showEditor = true;
    }

    private void OpenEditModal(LegalDocument doc)
    {
        editingDocument = doc;
        editorTitle = doc.Title;
        editorContent = doc.Content;
        showEditor = true;
    }

    private void CloseEditor()
    {
        showEditor = false;
        editingDocument = null;
        editorTitle = "";
        editorContent = "";
    }

    private async Task SaveDocument()
    {
        if (string.IsNullOrWhiteSpace(editorTitle) || string.IsNullOrWhiteSpace(editorContent))
            return;

        isSaving = true;
        try
        {
            if (editingDocument == null)
            {
                await LegalDocumentService.CreateVersionAsync(selectedType, editorTitle, editorContent);
            }
            else
            {
                await LegalDocumentService.UpdateDraftAsync(editingDocument.Id, editorTitle, editorContent);
            }
            
            await LoadDocuments();
            CloseEditor();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task PublishDocument(int id)
    {
        await LegalDocumentService.PublishVersionAsync(id);
        await LoadDocuments();
    }

    private async Task DeleteDocument(int id)
    {
        await LegalDocumentService.DeleteDraftAsync(id);
        await LoadDocuments();
    }

    private void PreviewDocument(LegalDocument doc)
    {
        previewDocument = doc;
        showPreview = true;
    }

    private void ClosePreview()
    {
        showPreview = false;
        previewDocument = null;
    }

    private void OnPaste(HtmlEditorPasteEventArgs args)
    {
        // Allow standard paste behavior
    }
}
