@using S2GPulseWeb.Web.Logic
@inject LegalDocumentService LegalDocumentService

<div class="legal-documents-section">
    <div class="document-type-tabs">
        <button class="doc-tab @(selectedType == LegalDocumentType.TermsOfService ? "active" : "")"
                @onclick="() => SelectType(LegalDocumentType.TermsOfService)">
            📜 Terms of Service
        </button>
        <button class="doc-tab @(selectedType == LegalDocumentType.PrivacyPolicy ? "active" : "")"
                @onclick="() => SelectType(LegalDocumentType.PrivacyPolicy)">
            🔒 Privacy Policy
        </button>
    </div>

    <div class="documents-header">
        <h3>@(selectedType == LegalDocumentType.TermsOfService ? "Terms of Service" : "Privacy Policy") Versions</h3>
        <button class="btn btn-primary" @onclick="OpenCreateModal">
            ➕ Create New Version
        </button>
    </div>

    @if (documents == null)
    {
        <p class="loading">Loading...</p>
    }
    else if (!documents.Any())
    {
        <p class="no-data">No documents found. Create your first version.</p>
    }
    else
    {
        <div class="documents-list">
            @foreach (var doc in documents)
            {
                <div class="document-card @(doc.IsActive ? "active" : "")">
                    <div class="doc-info">
                        <span class="doc-version">v@doc.Version</span>
                        <span class="doc-title">@doc.Title</span>
                        <span class="doc-status @(doc.IsActive ? "status-active" : (doc.PublishedAt.HasValue ? "status-previous" : "status-draft"))">
                            @(doc.IsActive ? "Active" : (doc.PublishedAt.HasValue ? "Previous" : "Draft"))
                        </span>
                        <span class="doc-date">
                            @(doc.PublishedAt?.ToString("MMM d, yyyy") ?? doc.CreatedAt.ToString("MMM d, yyyy"))
                        </span>
                    </div>
                    <div class="doc-actions">
                        <button class="btn btn-sm btn-preview" @onclick="() => PreviewDocument(doc)">
                            👁️ Preview
                        </button>
                        @if (!doc.IsActive)
                        {
                            <button class="btn btn-sm btn-edit" @onclick="() => OpenEditModal(doc)">
                                ✏️ Edit
                            </button>
                            <button class="btn btn-sm btn-publish" @onclick="() => PublishDocument(doc.Id)">
                                🚀 Publish
                            </button>
                            @if (!doc.PublishedAt.HasValue)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteDocument(doc.Id)">
                                    🗑️
                                </button>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Create/Edit Modal *@
@if (showEditor)
{
    <div class="modal-overlay" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="CloseEditor">
        <div class="modal-content editor-modal" style="background: #1a1a2e; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 2rem; width: 1100px; max-width: 95vw; height: 750px; max-height: 90vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,0.5);" @onclick:stopPropagation="true">
            <h3 style="margin: 0 0 1.5rem 0; color: #fff; flex-shrink: 0;">@(editingDocument == null ? "Create New Version" : $"Edit v{editingDocument.Version}")</h3>
            
            <div class="form-group" style="margin-bottom: 1rem; flex-shrink: 0;">
                <label style="display: block; margin-bottom: 0.5rem; color: #aaa; font-size: 0.9rem;">Title</label>
                <input type="text" class="form-control" style="width: 100%; padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.3); color: #fff; font-size: 1rem;" @bind="editorTitle" placeholder="e.g., Terms of Service" />
            </div>
            
            <div class="form-group editor-group" style="flex: 1; display: flex; flex-direction: column; min-height: 0; overflow: hidden; margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem; color: #aaa; font-size: 0.9rem;">Content</label>
                <RadzenHtmlEditor @bind-Value="@editorContent" style="flex: 1; min-height: 450px;" 
                                  Paste="@OnPaste" />
            </div>
            
            <div class="modal-actions" style="display: flex; gap: 0.75rem; justify-content: flex-end; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1); flex-shrink: 0;">
                <button class="btn btn-secondary" @onclick="CloseEditor">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveDocument" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}

@* Preview Modal *@
@if (showPreview && previewDocument != null)
{
    <div class="modal-overlay" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="ClosePreview">
        <div class="modal-content preview-modal" style="background: #1a1a2e; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 2rem; width: 900px; max-width: 95vw; height: 700px; max-height: 90vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,0.5);" @onclick:stopPropagation="true">
            <div class="preview-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); flex-shrink: 0;">
                <h3 style="margin: 0; color: #667eea; font-size: 1.1rem;">@previewDocument.Title (v@previewDocument.Version)</h3>
                <button class="btn-close" style="background: transparent; border: none; color: #888; font-size: 1.5rem; cursor: pointer;" @onclick="ClosePreview">×</button>
            </div>
            <div class="preview-content" style="flex: 1; overflow-y: auto; color: #bbb; line-height: 1.6; font-size: 0.9rem;">
                @((MarkupString)previewDocument.Content)
            </div>
        </div>
    </div>
}

