@using S2GPulseWeb.Web.Logic
@inject DeveloperNoteService DeveloperNoteService

<div class="dev-notes-section">
    <div class="notes-header">
        <h3>📝 Developer Notes</h3>
        <button class="btn btn-primary" @onclick="OpenCreateModal">
            ➕ Add Note
        </button>
    </div>

    @if (notes == null)
    {
        <p class="loading">Loading...</p>
    }
    else if (!notes.Any())
    {
        <p class="no-data">No developer notes yet. Create your first note to display on the dashboard.</p>
    }
    else
    {
        <div class="notes-list">
            @foreach (var note in notes)
            {
                <div class="note-card @(note.IsPublished ? "published" : "draft")">
                    <div class="note-info">
                        <span class="note-order">#{@note.DisplayOrder}</span>
                        <span class="note-title">@note.Title</span>
                        <span class="note-status @(note.IsPublished ? "status-published" : "status-draft")">
                            @(note.IsPublished ? "Published" : "Draft")
                        </span>
                        @if (note.ShowAsNewsletter)
                        {
                            <span class="note-status newsletter">📬 Newsletter</span>
                            <span class="note-status target-page" title="Target page for popup">📍 @note.TargetPage</span>
                        }
                        <span class="note-date">
                            @(note.PublishedAt?.ToString("MMM d, yyyy") ?? note.CreatedAt.ToString("MMM d, yyyy"))
                        </span>
                    </div>
                    <div class="note-actions">
                        <button class="btn btn-sm btn-preview" @onclick="() => PreviewNote(note)">
                            👁️ Preview
                        </button>
                        <button class="btn btn-sm btn-edit" @onclick="() => OpenEditModal(note)">
                            ✏️ Edit
                        </button>
                        <button class="btn btn-sm @(note.ShowAsNewsletter ? "btn-newsletter-active" : "btn-newsletter")" 
                                @onclick="() => ToggleNewsletter(note.Id)" title="Show as popup to users">
                            @(note.ShowAsNewsletter ? "📬 Newsletter On" : "📭 Newsletter")
                        </button>
                        @if (note.ShowAsNewsletter)
                        {
                            <select class="target-page-select" value="@note.TargetPage" 
                                    @onchange="@(e => UpdateTargetPage(note.Id, e.Value?.ToString()))" title="Target page">
                                <option value="Home">🏠 Home</option>
                                <option value="Workflow">⚙️ Workflow</option>
                                <option value="Logs">📋 Logs</option>
                                <option value="Settings">🔧 Settings</option>
                                <option value="Connections">🔗 Connections</option>
                                <option value="Admin">👤 Admin</option>
                                <option value="All">🌐 All Pages</option>
                            </select>
                        }
                        <button class="btn btn-sm @(note.IsPublished ? "btn-unpublish" : "btn-publish")" 
                                @onclick="() => TogglePublish(note.Id)">
                            @(note.IsPublished ? "📤 Unpublish" : "📥 Publish")
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(note)">
                            🗑️
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Create/Edit Modal *@
@if (showEditor)
{
    <div class="modal-overlay" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="CloseEditor">
        <div class="modal-content editor-modal" style="background: #1a1a2e; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 2rem; width: 1000px; max-width: 95vw; height: 700px; max-height: 90vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,0.5);" @onclick:stopPropagation="true">
            <h3 style="margin: 0 0 1.5rem 0; color: #fff; flex-shrink: 0;">@(editingNote == null ? "Create New Note" : "Edit Note")</h3>
            
            <div class="form-group" style="margin-bottom: 1rem; flex-shrink: 0;">
                <label style="display: block; margin-bottom: 0.5rem; color: #aaa; font-size: 0.9rem;">Title</label>
                <input type="text" class="form-control" style="width: 100%; padding: 0.75rem 1rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.3); color: #fff; font-size: 1rem;" @bind="editorTitle" placeholder="e.g., New Feature Release" />
            </div>
            
            <div class="form-group editor-group" style="flex: 1; display: flex; flex-direction: column; min-height: 0; overflow: hidden; margin-bottom: 1rem;">
                <label style="display: block; margin-bottom: 0.5rem; color: #aaa; font-size: 0.9rem;">Content</label>
                <RadzenHtmlEditor @bind-Value="@editorContent" style="flex: 1; min-height: 400px;" 
                                  Paste="@OnPaste" />
            </div>
            
            <div class="modal-actions" style="display: flex; gap: 0.75rem; justify-content: flex-end; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1); flex-shrink: 0;">
                <button class="btn btn-secondary" @onclick="CloseEditor">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveNote" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}

@* Preview Modal *@
@if (showPreview && previewNote != null)
{
    <div class="modal-overlay" style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); display: flex; align-items: center; justify-content: center; z-index: 1000;" @onclick="ClosePreview">
        <div class="modal-content preview-modal" style="background: #1a1a2e; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 2rem; width: 800px; max-width: 95vw; height: 600px; max-height: 85vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,0.5);" @onclick:stopPropagation="true">
            <div class="preview-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.1); flex-shrink: 0;">
                <h3 style="margin: 0; color: #667eea; font-size: 1.1rem;">@previewNote.Title</h3>
                <button class="btn-close" style="background: transparent; border: none; color: #888; font-size: 1.5rem; cursor: pointer;" @onclick="ClosePreview">×</button>
            </div>
            <div class="preview-content" style="flex: 1; overflow-y: auto; color: #bbb; line-height: 1.6; font-size: 0.9rem;">
                @((MarkupString)previewNote.Content)
            </div>
        </div>
    </div>
}

@* Delete Confirmation Modal *@
@if (showDeleteConfirm && deletingNote != null)
{
    <div class="modal-overlay" @onclick="CancelDelete">
        <div class="modal-content" @onclick:stopPropagation="true">
            <h3>⚠️ Delete Note</h3>
            <p class="warning-text">Are you sure you want to delete "<strong>@deletingNote.Title</strong>"?</p>
            <p class="warning-text">This action cannot be undone.</p>
            
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                <button class="btn btn-danger" @onclick="ExecuteDelete" disabled="@isDeleting">
                    @(isDeleting ? "Deleting..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

