@code {
    private List<DeveloperNote>? notes;
    
    // Editor state
    private bool showEditor = false;
    private DeveloperNote? editingNote;
    private string editorTitle = "";
    private string editorContent = "";
    private bool isSaving = false;
    
    // Preview state
    private bool showPreview = false;
    private DeveloperNote? previewNote;
    
    // Delete confirmation state
    private bool showDeleteConfirm = false;
    private DeveloperNote? deletingNote;
    private bool isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotes();
    }

    private async Task LoadNotes()
    {
        notes = await DeveloperNoteService.GetAllNotesAsync();
    }

    private void OpenCreateModal()
    {
        editingNote = null;
        editorTitle = "";
        editorContent = "";
        showEditor = true;
    }

    private void OpenEditModal(DeveloperNote note)
    {
        editingNote = note;
        editorTitle = note.Title;
        editorContent = note.Content;
        showEditor = true;
    }

    private void CloseEditor()
    {
        showEditor = false;
        editingNote = null;
        editorTitle = "";
        editorContent = "";
    }

    private async Task SaveNote()
    {
        if (string.IsNullOrWhiteSpace(editorTitle) || string.IsNullOrWhiteSpace(editorContent))
            return;

        isSaving = true;
        try
        {
            if (editingNote == null)
            {
                await DeveloperNoteService.CreateNoteAsync(editorTitle, editorContent);
            }
            else
            {
                await DeveloperNoteService.UpdateNoteAsync(editingNote.Id, editorTitle, editorContent);
            }
            
            await LoadNotes();
            CloseEditor();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task TogglePublish(int id)
    {
        await DeveloperNoteService.TogglePublishAsync(id);
        await LoadNotes();
    }

    private async Task ToggleNewsletter(int id)
    {
        await DeveloperNoteService.ToggleNewsletterAsync(id);
        await LoadNotes();
    }

    private async Task UpdateTargetPage(int id, string? targetPage)
    {
        await DeveloperNoteService.UpdateTargetPageAsync(id, targetPage ?? "Home");
        await LoadNotes();
    }

    private void ConfirmDelete(DeveloperNote note)
    {
        deletingNote = note;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        deletingNote = null;
    }

    private async Task ExecuteDelete()
    {
        if (deletingNote == null) return;
        
        isDeleting = true;
        try
        {
            await DeveloperNoteService.DeleteNoteAsync(deletingNote.Id);
            await LoadNotes();
            CancelDelete();
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void PreviewNote(DeveloperNote note)
    {
        previewNote = note;
        showPreview = true;
    }

    private void ClosePreview()
    {
        showPreview = false;
        previewNote = null;
    }

    private void OnPaste(HtmlEditorPasteEventArgs args)
    {
        // Allow standard paste behavior
    }
}
