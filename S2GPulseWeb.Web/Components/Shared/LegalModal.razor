@using Microsoft.AspNetCore.Components.Web

<div class="legal-modal-backdrop @(IsVisible ? "visible" : "")" @onclick="HandleBackdropClick">
    <div class="legal-modal" @onclick:stopPropagation="true">
        <div class="legal-modal-header">
            <h2>@Title</h2>
            @if (!RequireAcceptance)
            {
                <button class="legal-modal-close" @onclick="Close">×</button>
            }
        </div>
        
        <div class="legal-modal-content" id="@scrollContainerId" @onscroll="HandleScroll">
            @((MarkupString)Content)
        </div>
        
        <div class="legal-modal-footer">
            @if (RequireAcceptance)
            {
                <p class="scroll-hint @(hasScrolledToBottom ? "hidden" : "")">
                    Please scroll to the bottom to continue
                </p>
                <button class="btn btn-primary" 
                        disabled="@(!hasScrolledToBottom)" 
                        @onclick="HandleAccept">
                    I Agree
                </button>
            }
            else
            {
                <button class="btn btn-secondary" @onclick="Close">Close</button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Content { get; set; } = "";
    [Parameter] public bool RequireAcceptance { get; set; }
    [Parameter] public EventCallback OnAccept { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool hasScrolledToBottom = false;
    private string scrollContainerId = $"legal-scroll-{Guid.NewGuid():N}";

    protected override void OnParametersSet()
    {
        // Reset scroll state when modal becomes visible
        if (IsVisible)
        {
            hasScrolledToBottom = !RequireAcceptance;
        }
    }

    private void HandleScroll()
    {
        // Note: Actual scroll detection requires JS interop
        // For now, we'll enable after a short delay or click
    }

    private async Task HandleBackdropClick()
    {
        if (!RequireAcceptance)
        {
            await Close();
        }
    }

    private async Task HandleAccept()
    {
        await OnAccept.InvokeAsync();
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    public void EnableAcceptButton()
    {
        hasScrolledToBottom = true;
        StateHasChanged();
    }
}

<style>
    .legal-modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.2s ease, visibility 0.2s ease;
    }

    .legal-modal-backdrop.visible {
        opacity: 1;
        visibility: visible;
    }

    .legal-modal {
        background: var(--background-dark, #0a1a1a);
        border: 1px solid var(--border-color, #1a3a3a);
        border-radius: 12px;
        width: 800px;
        max-width: 95vw;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }

    .legal-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--border-color, #1a3a3a);
    }

    .legal-modal-header h2 {
        margin: 0;
        color: var(--accent-color, #14b8a6);
        font-size: 1.25rem;
        font-weight: 500;
    }

    .legal-modal-close {
        background: transparent;
        border: none;
        color: var(--text-secondary, #8aa);
        font-size: 1.75rem;
        cursor: pointer;
        padding: 0;
        line-height: 1;
        transition: color 0.2s;
    }

    .legal-modal-close:hover {
        color: var(--text-primary, #fff);
    }

    .legal-modal-content {
        flex: 1;
        overflow-y: auto;
        padding: 1.5rem;
        color: var(--text-secondary, #8aa);
        font-size: 0.9rem;
        line-height: 1.6;
    }

    .legal-modal-content h2 {
        color: var(--text-primary, #fff);
        font-size: 1.1rem;
        margin-top: 0;
    }

    .legal-modal-content h3 {
        color: var(--accent-color, #14b8a6);
        font-size: 0.95rem;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .legal-modal-content p {
        margin: 0.5rem 0;
    }

    .legal-modal-content ul {
        margin: 0.5rem 0;
        padding-left: 1.5rem;
    }

    .legal-modal-content li {
        margin: 0.25rem 0;
    }

    .legal-modal-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--border-color, #1a3a3a);
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 1rem;
    }

    .scroll-hint {
        color: var(--text-secondary, #8aa);
        font-size: 0.85rem;
        margin: 0;
        opacity: 1;
        transition: opacity 0.3s;
    }

    .scroll-hint.hidden {
        opacity: 0;
    }

    .legal-modal-footer .btn {
        min-width: 120px;
    }

    .legal-modal-footer .btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>
