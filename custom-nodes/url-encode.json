{
    "exportVersion": 1,
    "exportedAt": "2026-01-15T20:25:00Z",
    "definition": {
        "nodeTypeKey": "Custom_UrlEncode",
        "displayName": "URL Encode/Decode",
        "description": "Encodes text for use in URLs or decodes URL-encoded text back to plain text.",
        "categoryName": "Data Transformation",
        "iconSvg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M10 13C10.4295 13.5741 10.9774 14.0492 11.6066 14.3929C12.2357 14.7367 12.9315 14.9411 13.6467 14.9923C14.3618 15.0435 15.0796 14.9404 15.7513 14.6898C16.4231 14.4392 17.0331 14.0471 17.54 13.54L20.54 10.54C21.4508 9.59699 21.9548 8.33398 21.9434 7.02299C21.932 5.71199 21.4061 4.45793 20.4791 3.53093C19.5521 2.60393 18.298 2.07802 16.987 2.0666C15.676 2.05519 14.413 2.55921 13.47 3.47L11.75 5.18\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M14 11C13.5705 10.4259 13.0226 9.95083 12.3934 9.60706C11.7642 9.26329 11.0685 9.05886 10.3533 9.00765C9.63816 8.95643 8.92037 9.05961 8.24861 9.3102C7.57685 9.56079 6.96684 9.95291 6.45996 10.46L3.45996 13.46C2.54917 14.403 2.04515 15.666 2.05657 16.977C2.06798 18.288 2.5939 19.5421 3.5209 20.4691C4.44789 21.3961 5.70196 21.922 7.01295 21.9334C8.32395 21.9448 9.58694 21.4408 10.53 20.53L12.24 18.82\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>",
        "executionType": "DataTransformation",
        "executionDelayMs": 0,
        "timeoutSeconds": 30,
        "script": "// URL Encode/Decode\n\nvar mode = input.get(\"mode\") || \"encode\";\nvar inputText = input.get(\"inputText\");\nvar component = input.get(\"component\") !== \"false\";\n\nif (!inputText && inputText !== \"\") {\n    log.error(\"Input text is required\");\n    output.set(\"HasErrors\", true);\n    output.set(\"ErrorMessage\", \"Input text is required\");\n    output.set(\"Result\", \"\");\n    tags.trigger(\"error\");\n} else {\n    try {\n        var result = \"\";\n        \n        if (mode.toLowerCase() === \"decode\") {\n            result = component ? decodeURIComponent(inputText) : decodeURI(inputText);\n            log.info(\"URL decoded (\" + inputText.length + \" chars) to (\" + result.length + \" chars)\");\n        } else {\n            result = component ? encodeURIComponent(inputText) : encodeURI(inputText);\n            log.info(\"URL encoded (\" + inputText.length + \" chars) to (\" + result.length + \" chars)\");\n        }\n        \n        output.set(\"Result\", result);\n        output.set(\"InputLength\", inputText.length);\n        output.set(\"OutputLength\", result.length);\n        output.set(\"Mode\", mode.toLowerCase() === \"decode\" ? \"decode\" : \"encode\");\n        output.set(\"HasErrors\", false);\n        output.set(\"ErrorMessage\", \"\");\n        tags.trigger(\"success\");\n        \n    } catch (ex) {\n        log.error(\"URL operation failed: \" + ex.message);\n        output.set(\"HasErrors\", true);\n        output.set(\"ErrorMessage\", \"URL \" + mode + \" failed: \" + ex.message);\n        output.set(\"Result\", \"\");\n        tags.trigger(\"error\");\n    }\n}",
        "initializationScript": "",
        "inputSchemaJson": null,
        "defaultConfigurationJson": null,
        "inputFields": [
            {
                "fieldName": "mode",
                "displayLabel": "Mode",
                "placeholderText": "encode or decode",
                "helpText": "'encode' converts text to URL-safe format. 'decode' converts URL-encoded text back.",
                "fieldType": "Dropdown",
                "defaultValue": "encode",
                "isRequired": true,
                "allowPlaceholders": false,
                "displayOrder": 1,
                "dropdownOptions": "encode,decode"
            },
            {
                "fieldName": "inputText",
                "displayLabel": "Input",
                "placeholderText": "Text to encode or URL-encoded string to decode",
                "helpText": "The text to process.",
                "fieldType": "TextArea",
                "defaultValue": "",
                "isRequired": true,
                "allowPlaceholders": true,
                "displayOrder": 2
            },
            {
                "fieldName": "component",
                "displayLabel": "Component Mode",
                "helpText": "If true, uses encodeURIComponent/decodeURIComponent (encodes everything). If false, uses encodeURI/decodeURI (preserves URL structure).",
                "fieldType": "Boolean",
                "defaultValue": "true",
                "isRequired": false,
                "allowPlaceholders": false,
                "displayOrder": 3
            }
        ],
        "outputParameters": [
            {
                "parameterName": "Result",
                "description": "The encoded or decoded string",
                "dataType": "string",
                "displayOrder": 1
            },
            {
                "parameterName": "Mode",
                "description": "The operation that was performed",
                "dataType": "string",
                "displayOrder": 2
            },
            {
                "parameterName": "InputLength",
                "description": "Length of the input string",
                "dataType": "number",
                "displayOrder": 3
            },
            {
                "parameterName": "OutputLength",
                "description": "Length of the result string",
                "dataType": "number",
                "displayOrder": 4
            },
            {
                "parameterName": "HasErrors",
                "description": "True if an error occurred",
                "dataType": "boolean",
                "displayOrder": 5
            },
            {
                "parameterName": "ErrorMessage",
                "description": "Error details if operation failed",
                "dataType": "string",
                "displayOrder": 6
            }
        ],
        "connectionTags": [
            {
                "tagName": "success",
                "description": "Operation completed successfully",
                "color": "#22c55e",
                "conditionDescription": "Operation succeeded",
                "displayOrder": 1
            },
            {
