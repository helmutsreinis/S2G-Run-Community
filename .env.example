# S2G Pulse — Self-Hosted Configuration
# Copy this file to .env and fill in your values

# PostgreSQL password (REQUIRED — change from default!)
POSTGRES_PASSWORD=changeme

# Port to expose S2G Pulse on
S2G_PORT=8080

# Admin email (optional — if empty, the first registered user becomes admin)
ADMIN_EMAIL=

# Optional: Microsoft SSO
# AUTHENTICATION__MICROSOFT__CLIENTID=
# AUTHENTICATION__MICROSOFT__CLIENTSECRET=

# Optional: Google SSO
# AUTHENTICATION__GOOGLE__CLIENTID=
# AUTHENTICATION__GOOGLE__CLIENTSECRET=
